---
import '../styles/sopalda-landing.css';
// Act I: mark, wordmark, rotating quote, cue. Overwritten from the
// prototype's own text system (splitWord/setLine/decay/stepPhys/dock)
// rather than patched again -- see the session's own record of drifted
// constants and a fabricated wordmark gradient that was never in any
// reference to begin with.
//
// No canvas, no #tank, no specimen strip here on purpose: Field.astro
// is the one nerve canvas and the one specimen field (Act II), already
// gated on body[data-landing='field']. Duplicating either was the
// actual bug behind "the nerve doubles/flickers" -- two elements with
// id="nerve", two independent draw loops.
//
// Content stays real: the tagline Eduardo revised directly this
// session, the manifesto line shown first with no citation (his own
// thesis, not an article fragment), the citation line for every
// fragment after it (Field.astro's own fragment pool, one source of
// truth via src/data/fragments.ts), Barcelona/LinkedIn in the footer.
// None of that is in the reference's own placeholder content (its tiny
// 5-line LINES array, its "Berlin · Oct 2026" footer) -- that's demo
// copy from wherever the prototype was last shown, not Eduardo's.
---

<section class="landing" id="landing" aria-label="Eduardo Sopalda">
  <div class="top-bar" aria-hidden="true"></div>

  <div class="stage">
    <header class="mark" id="mark">
      {/* Real static text, not empty spans -- splitWord() below clears
          and rebuilds each into letter-by-letter <b> spans on load, so
          the animation is unaffected, but a crawler or a page that
          never gets to run the module now sees the actual name instead
          of two empty elements under an aria-label nothing else reads. */}
      <h1 aria-label="Eduardo Sopalda">
        <span class="given" id="given" aria-hidden="true">EDUARDO</span>
        <span class="family" id="family" aria-hidden="true">sopalda</span>
      </h1>
      {/* The module script below (splitWord) also clears and rebuilds
          these two spans, but it's a deferred module -- it only runs
          once the browser gets around to it, well after this markup
          has already been parsed and painted at least once. On a slow
          enough device that gap is long enough to see: the plain
          static name flashes on screen, then vanishes, then the real
          letter-by-letter animation starts. is:inline runs this
          synchronously, in place, before the parser moves past it --
          the static text never gets a chance to paint at all, while
          still existing in the served markup for a crawler or a page
          that never runs JS at all. */}
      <script is:inline>
        document.getElementById('given').textContent = '';
        document.getElementById('family').textContent = '';
      </script>
      <p class="tagline">DATA | AI <span class="amp">&amp;</span> The human experience</p>
    </header>

    <main class="slot">
      <p class="frag" id="frag-a" hidden></p>
      <p class="frag" id="frag-b" hidden></p>
      {/* Not aria-hidden -- it sometimes holds a real link now (see
          revealSourceFor below), and a focusable element hidden from
          assistive tech is worse than one left plain. */}
      <p class="frag-source" id="frag-source"></p>
    </main>

    <footer class="foot">
      {/* Plain text, not a link: no real LinkedIn URL exists yet. A
          dead href was a fake interaction on the first screen -- see
          non-negotiable 1, invent nothing, not even a placeholder
          destination. Becomes a real <a> the day there's a URL. */}
      <p class="meta">Barcelona<br /><span class="li">LinkedIn</span></p>
      <button type="button" class="cue" id="cue" aria-label="Continue">
        <span class="cue-line" aria-hidden="true"></span>
        <span class="cue-dot" aria-hidden="true"></span>
      </button>
    </footer>
  </div>
</section>

<script>
  import { FRAGS } from '../data/fragments';
  import { ARTICLE_CATALOG, slugForTitle } from '../data/articleIndex';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ================= wordmark: split + staggered CSS reveal =================
  function splitWord(node: HTMLElement, text: string) {
    node.textContent = '';
    return [...text].map((ch) => {
      const b = document.createElement('b');
      b.textContent = ch;
      node.appendChild(b);
      return b;
    });
  }

  // Built immediately, not inside beginReveal -- the wordmark's real
  // final layout (seven separate inline-block <b> letters, not one
  // plain text run) needs to exist from the start, the same reasoning
  // as the manifesto's own setLine(..., false) below: Field.astro
  // measures the real page to know where the nerve should settle, and
  // splitting the name AFTER that measurement already happened would
  // shift the layout out from under it right as it arrives. The CSS
  // for .given b/.family b has no animation of its own (opacity: 0,
  // static) specifically so building them early doesn't also start
  // them animating early -- animateWordmark below does that, gated on
  // nerve-settled the same way the quote's own animateLetters is.
  const givenLetters = splitWord(document.getElementById('given')!, 'EDUARDO');
  const familyLetters = splitWord(document.getElementById('family')!, 'sopalda');

  function animateWordmark() {
    const animateSet = (letters: HTMLElement[], baseDelay: number, step: number) => {
      letters.forEach((b, i) => {
        const anim = b.animate(
          [
            { opacity: 0, transform: 'translateY(14px)', filter: 'blur(10px)' },
            { opacity: 1, transform: 'none', filter: 'blur(0)' },
          ],
          {
            duration: reduced ? 1 : 2400,
            delay: reduced ? 0 : baseDelay + i * step,
            easing: 'cubic-bezier(.22,.7,.2,1)',
            fill: 'forwards',
          }
        );
        // Same reasoning as the quote's own animateLetters: keep the
        // real inline opacity in sync once the animation finishes, so
        // nothing later cancelling this animation snaps back to a
        // stale, invisible 0.
        anim.onfinish = () => { b.style.opacity = '1'; };
      });
    };
    animateSet(givenLetters, 150, 70);
    animateSet(familyLetters, 850, 110);
  }

  // ================= the quote: birth, Verlet death, repeat =================
  // Two stacked layers (#frag-a/#frag-b): while one dies, the other is
  // already rising -- that overlap is the cross, never a hard cut.
  const layers = [
    document.getElementById('frag-a'),
    document.getElementById('frag-b'),
  ].filter((el): el is HTMLParagraphElement => el instanceof HTMLParagraphElement);
  const sourceEl = document.getElementById('frag-source');

  // The manifesto is the site's own thesis, not an article fragment --
  // shown first, every time, with no citation. Everything after it
  // comes from the same 50-fragment pool Field.astro's own continuous
  // world draws from (src/data/fragments.ts), not the reference's own
  // 5-line placeholder LINES array.
  const MANIFESTO = { text: 'Understand it first… then you decide if you trust it.', source: null as string | null };

  let queue: number[] = [];
  function shuffled(n: number) {
    const arr = Array.from({ length: n }, (_, i) => i);
    for (let i = arr.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [arr[i], arr[j]] = [arr[j], arr[i]];
    }
    return arr;
  }
  function nextFrag(): { text: string; source: string | null; year: number | null } {
    if (queue.length === 0) queue = shuffled(FRAGS.length);
    const f = FRAGS[queue.pop()!];
    return { text: f.text, source: f.source, year: f.year ?? null };
  }

  function revealSourceFor(source: string | null, year: number | null) {
    if (!sourceEl) return;
    if (!source) {
      sourceEl.classList.remove('is-visible');
      return;
    }
    // Short reference form (No.NN · year), matching Field.astro's own
    // fragment citations -- per direct feedback, "short and sweet"
    // instead of the full article title. No.NN is ARTICLE_CATALOG's
    // real, stable chronological catalogue number (see that file's
    // own comment), not invented.
    const catalogNo = ARTICLE_CATALOG[source];
    const label = catalogNo ? `No.${String(catalogNo).padStart(2, '0')}` : source;
    // No leading dash -- CLAUDE.md non-negotiable 8 bans em/en dashes
    // outright, chrome and prose alike, and Field.astro's own citation
    // (see its `cite` construction) never had one to begin with. This
    // now matches that exactly instead of quietly diverging from it.
    const cite = year ? `${label} · ${year}` : label;
    // Real link when the article has one, same as Field.astro's own
    // fragments -- docs/BRIEF.md's fragment definition again, this
    // time for Act I's own quote rather than the field's.
    const slug = slugForTitle(source);
    sourceEl.textContent = '';
    if (slug) {
      const a = document.createElement('a');
      a.href = `/writing/${slug}`;
      a.textContent = cite;
      sourceEl.appendChild(a);
    } else {
      sourceEl.appendChild(document.createTextNode(cite));
    }
    setTimeout(() => sourceEl.classList.add('is-visible'), reduced ? 0 : 900);
  }

  let live = 0;
  let letters: HTMLElement[] = [];
  let decaying = false;
  let held = false;
  let docked = false;

  // revealNow=false builds the line's real DOM structure (and, with
  // it, its real layout position and height) without starting the
  // per-letter fade-in yet -- see beginReveal below for why the very
  // first call (the manifesto) needs exactly that split. Every later
  // call passes the default (true): build and animate together, same
  // as always.
  function setLine(text: string, source: string | null, year: number | null, node: HTMLElement, revealNow = true) {
    decaying = false;
    node.innerHTML = '';
    letters = [];
    node.style.animation = 'none';
    node.style.opacity = '1';
    node.hidden = false;
    node.classList.toggle('is-manifesto', text === MANIFESTO.text);
    revealSourceFor(source, year);
    text.split(/(\s+)/).forEach((tok) => {
      if (/^\s+$/.test(tok)) {
        node.appendChild(document.createTextNode(' '));
        return;
      }
      const word = document.createElement('span');
      word.className = 'word';
      [...tok].forEach((ch) => {
        const b = document.createElement('b');
        b.textContent = ch;
        b.style.opacity = '0';
        word.appendChild(b);
        letters.push(b);
      });
      node.appendChild(word);
    });
    if (revealNow) animateLetters();
  }

  function animateLetters() {
    letters.forEach((b, i) => {
      const anim = b.animate(
        [
          { opacity: 0, transform: 'translateY(10px)', filter: 'blur(8px)' },
          { opacity: 1, transform: 'none', filter: 'blur(0)' },
        ],
        {
          duration: reduced ? 1 : 1600,
          delay: reduced ? 0 : 90 + i * 58,
          easing: 'cubic-bezier(.22,.7,.2,1)',
          fill: 'forwards',
        }
      );
      // fill:'forwards' holds the animation's own visual result at
      // opacity 1 without ever touching b.style.opacity itself, which
      // stays at the literal '0' set above. decay() later cancels this
      // animation to hand the letter to the physics engine -- cancelling
      // reverts to that stale underlying '0', not to what was on screen,
      // so every letter would flash fully invisible for one frame and
      // then flash back (physics starts at life:1) before actually
      // starting to fade -- a real, confirmed "fade in, vanish, come
      // back, then decay" glitch, not a timing illusion. Keeping the
      // real inline opacity in sync once the animation finishes means
      // cancelling it later is a no-op visually.
      anim.onfinish = () => { b.style.opacity = '1'; };
    });
  }

  const DEATHS = ['float', 'fall', 'explode', 'corrode'] as const;
  let deathI = 0;
  type Particle = {
    el: HTMLElement; x: number; y: number; px: number; py: number;
    rot: number; rotv: number; damp: number; life: number; fade: number;
    wake: number; scale: number; link: boolean; rest: number; breakAt: number;
  };
  let phys: Particle[] = [];
  let physMode: (typeof DEATHS)[number] | '' = '';
  let physT = 0;
  let physRunning = false;
  let physLast = 0;

  function stopPhys() {
    physRunning = false;
    phys = [];
  }

  function stepPhys(now: number) {
    if (!physRunning || held) return;
    const dt = Math.min(0.032, (now - physLast) / 1000) || 0.016;
    physLast = now;
    physT += dt;
    const wind = Math.sin(physT * 0.7) * 22;

    if (physMode === 'corrode') {
      phys.forEach((p) => {
        if (p.link && physT > p.breakAt) p.link = false;
      });
      for (let k = 0; k < 4; k++) {
        for (let i = 0; i < phys.length - 1; i++) {
          const p = phys[i], q = phys[i + 1];
          if (!p.link) continue;
          const dx = q.x - p.x, dy = q.y - p.y;
          const d = Math.hypot(dx, dy) || 1;
          const corr = (d - p.rest) * 0.18;
          const nx = dx / d, ny = dy / d;
          p.x += nx * corr * 0.5; p.y += ny * corr * 0.5;
          q.x -= nx * corr * 0.5; q.y -= ny * corr * 0.5;
        }
      }
    }

    phys.forEach((p) => {
      if (physT < p.wake) return;
      let ax = 0, ay = 0;
      if (physMode === 'fall') ay = 380;
      if (physMode === 'float') { ay = -28; ax = wind * 0.7; }
      if (physMode === 'explode') ay = 12;
      if (physMode === 'corrode') ay = 12;

      const vx = p.x - p.px, vy = p.y - p.py;
      const nx = p.x + vx * p.damp + ax * dt * dt;
      const ny = p.y + vy * p.damp + ay * dt * dt;
      p.px = p.x; p.py = p.y;
      p.x = nx; p.y = ny;
      p.rot += p.rotv * dt * 60;
      p.life -= p.fade * dt * 60;
      if (physMode === 'explode') p.scale = 1 + Math.min(0.55, physT * 0.35);
      p.el.style.transform = `translate(${p.x}px, ${p.y}px) rotate(${p.rot}deg) scale(${p.scale || 1})`;
      p.el.style.opacity = String(Math.max(0, p.life));
      if (physMode === 'corrode') {
        const rust = Math.min(1, physT / 7);
        p.el.style.filter = `blur(${rust * 4.5}px)`;
        (p.el.style as any).color = rust > 0.35 ? '#2a160e' : '';
      }
    });
    requestAnimationFrame(stepPhys);
  }

  function decay() {
    if (reduced || held || decaying) return;
    decaying = true;
    const mode = DEATHS[deathI % DEATHS.length];
    deathI += 1;
    physMode = mode;
    physT = 0;
    physLast = performance.now();
    const origin = letters.map((b) => b.getBoundingClientRect());
    phys = letters.map((b, i) => {
      b.getAnimations().forEach((a) => a.cancel());
      const ang = (i / Math.max(letters.length, 1)) * Math.PI * 2 + (Math.random() - 0.5) * 0.35;
      const speed = mode === 'explode' ? 11 + Math.random() * 8 : 2.4 + Math.random() * 2;
      let px = 0, py = 0;
      if (mode === 'explode') {
        px = -Math.cos(ang) * speed;
        py = -Math.sin(ang) * speed;
      }
      const rest = origin[i + 1] ? origin[i + 1].left - origin[i].left : origin[i].width;
      return {
        el: b, x: 0, y: 0, px, py, rot: 0,
        rotv: mode === 'explode' ? (Math.random() - 0.5) * 14 : (Math.random() - 0.5) * 0.4,
        damp: mode === 'float' ? 0.965 : mode === 'fall' ? 0.996 : mode === 'explode' ? 0.986 : 0.978,
        life: 1,
        fade: mode === 'explode' ? 0.0055 : mode === 'fall' ? 0.0026 : mode === 'float' ? 0.0018 : 0.0022,
        wake: mode === 'explode' ? 0.28 : mode === 'float' ? i * 0.12 : mode === 'corrode' ? i * 0.16 : mode === 'fall' ? i * 0.05 : 0,
        scale: 1,
        link: mode === 'corrode' && i < letters.length - 1,
        rest,
        breakAt: 0.35 + i * 0.16,
      };
    });
    physRunning = true;
    requestAnimationFrame(stepPhys);
    if (sourceEl) sourceEl.classList.remove('is-visible');

    const dying = layers[live];
    const next = layers[1 - live];
    live = 1 - live;
    const overlap = mode === 'explode' ? 3200 : 4200;
    const clearAfter = mode === 'explode' ? 10000 : 14000;
    setTimeout(() => {
      if (docked) return;
      const f = nextFrag();
      setLine(f.text, f.source, f.year, next);
      setTimeout(decay, reduced ? 999999 : 16000);
    }, overlap);
    setTimeout(() => {
      if (dying !== layers[live]) {
        dying.innerHTML = '';
        dying.hidden = true;
      }
    }, clearAfter);
  }

  function firstRects(nodes: HTMLElement[]) {
    return nodes.map((n) => n.getBoundingClientRect());
  }

  // ================= dock: FLIP the wordmark + tagline to the corner =================
  function dock() {
    if (docked) return;
    docked = true;
    held = false;

    document.body.setAttribute('data-landing', 'field');

    const tag = document.querySelector('.tagline') as HTMLElement;
    const firstG = firstRects(givenLetters);
    const firstF = firstRects(familyLetters);
    const firstT = tag.getBoundingClientRect();
    document.body.classList.add('is-docked');
    const lastG = firstRects(givenLetters);
    const lastF = firstRects(familyLetters);
    const lastT = tag.getBoundingClientRect();

    givenLetters.forEach((b, i) => {
      const dx = firstG[i].left - lastG[i].left;
      const dy = firstG[i].top - lastG[i].top;
      const sx = firstG[i].width / Math.max(lastG[i].width, 1);
      const sy = firstG[i].height / Math.max(lastG[i].height, 1);
      b.animate(
        [
          { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})` },
          { transform: 'translate(0,0) scale(1)' },
        ],
        { duration: reduced ? 1 : 3400, delay: i * 55, easing: 'cubic-bezier(.22,.7,.2,1)', fill: 'both' }
      );
    });

    {
      const dx = firstT.left - lastT.left;
      const dy = firstT.top - lastT.top;
      const sx = firstT.width / Math.max(lastT.width, 1);
      const sy = firstT.height / Math.max(lastT.height, 1);
      tag.animate(
        [
          { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})`, opacity: '1' },
          { transform: 'translate(0,0) scale(1)', opacity: '1' },
        ],
        { duration: reduced ? 1 : 3800, delay: 120, easing: 'cubic-bezier(.22,.65,.2,1)', fill: 'both' }
      );
    }

    // Was a 3-keyframe "wander" -- each letter flew out to a random
    // scattered point mid-flight before settling, over 6800ms with a
    // 180ms-per-letter stagger. Not in the reference prototype (its own
    // dock has no such thing), and on a real phone it read as broken
    // rather than as a flourish: the field behind it is already fully
    // faded in (.world's own transition is 2.6s) while "sopalda"'s
    // letters were still scattered across the screen, overlapping the
    // tagline and the specimens underneath for several seconds. Matches
    // givenLetters' and the tagline's own clean 2-keyframe FLIP now --
    // one coherent dock motion, not two different animations racing.
    familyLetters.forEach((b, i) => {
      const dx = firstF[i].left - lastF[i].left;
      const dy = firstF[i].top - lastF[i].top;
      const sx = firstF[i].width / Math.max(lastF[i].width, 1);
      const sy = firstF[i].height / Math.max(lastF[i].height, 1);
      b.animate(
        [
          { transform: `translate(${dx}px, ${dy}px) scale(${sx}, ${sy})` },
          { transform: 'translate(0,0) scale(1)' },
        ],
        { duration: reduced ? 1 : 3400, delay: i * 55, easing: 'cubic-bezier(.22,.7,.2,1)', fill: 'both' }
      );
    });
  }

  // Lays out the manifesto's real DOM structure (and with it, #frag-a's
  // real height and position) immediately, letters at rest at opacity
  // 0 -- but does not animate them in yet (revealNow=false). This has
  // to happen right away, ungated: Field.astro's computeNerveChannel
  // measures #frag-a's own position to know where the nerve should
  // settle, and #frag-a starts the page `hidden` -- if nothing ever
  // un-hides it until the nerve has already settled, the nerve can
  // never get a real measurement to settle toward in the first place.
  // Splitting "laid out" from "visibly animated in" breaks that circle:
  // the letters themselves still wait for beginReveal below.
  setLine(MANIFESTO.text, MANIFESTO.source, null, layers[0], false);

  // The name splitting into letters, and animating the manifesto's own
  // letters in, used to just run here, immediately, at script load.
  // That raced Field.astro's nerve: the nerve's entrance (see its own
  // comment, "nerve-settled") could still be flat and pinned near the
  // top while the name and quote were already fading in on top of it.
  // Waiting for that event means the sequence is now what it's
  // supposed to be -- the nerve arrives, then the name, then the quote
  // -- instead of both starting at once by coincidence of load timing.
  let revealed = false;
  function beginReveal() {
    // Guards against running twice: the safety-net timeout below fires
    // unconditionally, and the common case is that the real event has
    // already done this by the time it would go off.
    if (revealed) return;
    revealed = true;
    animateWordmark();
    animateLetters();
    if (!reduced) setTimeout(decay, 12000);
  }

  if (reduced) {
    // No entrance to wait for under reduced motion -- same as before,
    // immediate.
    beginReveal();
  } else {
    addEventListener('nerve-settled', beginReveal, { once: true });
    // Safety net: if Field.astro's script never dispatches this (fails
    // to load, throws before it gets there), don't leave the page
    // permanently blank waiting on a signal that's never coming.
    setTimeout(beginReveal, 4000);
  }

  layers.forEach((node) => {
    node.addEventListener('pointerdown', () => {
      held = true;
      stopPhys();
      letters.forEach((b) => {
        b.getAnimations().forEach((a) => a.cancel());
        b.style.transition = 'transform 1.1s ease, opacity 1.1s ease, color 1.1s ease, filter 1.1s ease';
        b.style.transform = 'none';
        b.style.opacity = '1';
        (b.style as any).color = '';
        b.style.filter = 'none';
      });
    });
  });

  // Deliberate only -- nothing times out and forces this on its own,
  // and plain pointer movement doesn't count. Scroll/touch are the
  // low-friction fallback, since both are already an act of trying to
  // move past this screen.
  document.getElementById('cue')?.addEventListener('click', dock);
  document.getElementById('mark')?.addEventListener('click', dock);
  if (!reduced) {
    addEventListener('wheel', dock, { once: true, passive: true });
    addEventListener('touchstart', dock, { once: true, passive: true });
  } else {
    dock();
  }
</script>
