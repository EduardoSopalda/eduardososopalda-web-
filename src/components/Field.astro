---
// The field itself: the cabinet of curiosities. Specimens and
// fragments drifting at depth, a nerve running through it, the seven
// stops riding that nerve. Ported from prototype/field.html's proven
// drift/decay math (CLAUDE.md: "it already works").
//
// The nerve's wave went spring/tension chain -> closed-form sine (a
// second opinion's reference prototype, "wave, not an electrocardiogram")
// -- back to closed-form, but not the original: this one adds a slow
// amplitude "breath", a spatial "warp" so the phase isn't perfectly
// uniform across the width, and a drifting mid-line, all sampled fresh
// from `t` every frame instead of spring-integrated per point. Pointer
// bend, the drag-linked vertical offset, and the text-zone Y clamp are
// all still layered on top -- see chainYAt/nerveYAt below.
//
// Fragment text is Eduardo's own, verbatim from fragments/fragments.md
// (50 real fragments, thread + weight) -- shared with Landing.astro's
// hero quote via src/data/fragments.ts, one source of truth instead of
// two copies drifting apart. Specimen images/video are the
// confirmed assets from this session — see public/specimens/. Three
// have real "DATA" catalogue tags per the cabinet's thread mapping
// decided earlier; the rest (seaweed, eyefish) are untagged
// atmosphere, on purpose — the tag is the scarce thing here, same
// logic as gold.
---

<section class="field" id="field-root" aria-hidden="true">
  <canvas class="nerve" id="nerve"></canvas>
  <div class="world" id="world"></div>
</section>

<style is:global>
  /* is:global, not scoped: every selector below targets elements
     created dynamically via document.createElement in the script —
     .spec, .frag, .stop, .spec-tag, and their children. Astro scopes
     component styles by attaching a data-astro-cid attribute to
     elements written in the template; JS-created elements never get
     that attribute, so scoped rules silently never matched them. This
     was the actual cause of fragments/specimens rendering in normal
     block flow (stacking downward) instead of at their absolute,
     transform-driven positions — found by measuring getBoundingClientRect
     against the inline transform and seeing them disagree by a growing
     offset per element, not by inspection. */
  .field {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--void);
    cursor: grab;
  }

  .field:active {
    cursor: grabbing;
  }

  /* The mouse itself becomes a point of light, not an arrow -- the OS
     cursor is hidden and a glowing dot (drawn on the nerve canvas, at
     the same px/py already tracked for bending the nerve) takes its
     place. Touch devices keep default behaviour: there's no persistent
     pointer to replace, and grab/grabbing already meant nothing there. */
  @media (hover: hover) and (pointer: fine) {
    .field,
    .field:active {
      cursor: none;
    }
  }

  .nerve {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Was implicitly behind .world (no z-index on either, so plain DOM
       order decided it, and .world -- appearing later -- won) --
       specimens could visually cut the wire wherever they overlapped
       it. Explicit z-index above the stops (200, the previous highest)
       puts it in front of everything. pointer-events: none is required
       once it's on top, or it would intercept clicks meant for the
       stops and specimens now underneath it. */
    z-index: 250;
    pointer-events: none;
  }

  .world {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 2.6s var(--ease);
    pointer-events: none;
  }

  body[data-landing='field'] .world {
    opacity: 1;
    pointer-events: auto;
  }

  /* ---- specimens ---- */
  .spec {
    position: absolute;
    top: 0;
    left: 0;
    line-height: 0;
    will-change: transform;
  }

  /* None of the source stills or videos are actually cut out — they're
     opaque rectangles with a near-black (not pure 0,0,0) background:
     compression noise, ~1-10 per channel, up to 40+ in spots. Brightening
     that on wake lights up the rectangle itself, not just the creature —
     a visible box, not a glow. So the reactive version (below, scoped to
     [data-cutout]) is opt-in; everyone else gets one static look that
     never moves, and wakes only through the tag, the lean, and the
     canvas-drawn connector line, none of which touch these pixels. */
  .spec img,
  .spec video {
    display: block;
    width: 100%;
    height: auto;
    /* --boost is set once at creation (not per-frame) for specimens
       whose source is inherently pale/low-contrast -- see Specimen.boost. */
    filter: brightness(calc(0.82 * var(--boost, 1))) contrast(1.24) saturate(0.92);
  }

  /* --awake and --flare are both set per-frame in JS (0 to 1 floats).
     Awake is proximity/tap; flare is the unprompted cycle. Combined
     additively into one filter so a specimen that happens to flare
     while already awake gets both effects at once instead of one
     silently overriding the other via CSS specificity. Only specimens
     with a real alpha-cut background (see Specimen.cutout) get this —
     see the comment above. */
  .spec[data-cutout='1'] img,
  .spec[data-cutout='1'] video {
    /* Resting brightness was 0.6 -- lower than the 0.82 every other
       specimen sits at, found while comparing the jellyfish (cutout)
       against the piglet (not) in the same screenshot: the jellyfish's
       own material is already pale and low-contrast, so a dimmer-than-
       everyone-else baseline made it read as washed out rather than
       "resting." Raised to match, with the awake/flare bonuses rescaled
       so the peak (fully awake + flaring) lands in the same place. */
    filter:
      brightness(calc(0.8 + var(--awake, 0) * 0.3 + var(--flare, 0) * 0.45))
      contrast(1.24)
      saturate(calc(0.92 + var(--awake, 0) * 0.15 + var(--flare, 0) * 0.3));
    transition: filter 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Opt-in, not universal — most specimens are already clean on flat
     black and don't need this; masking them anyway risks clipping a
     tentacle or ear that was never a problem. Compositing note in
     DESIGN-SYSTEM.md assumes true black under void-family specimens
     so the rectangle disappears with no cutting/alpha/mask; the newer
     octopus render has a soft dark vignette instead, which would
     otherwise show as a faint edge against the page. No image-editing
     tool is available in this environment to re-background the source
     file, so this fades that one image's own edges to transparent
     instead, letting the page's true black show through underneath —
     same visual result, without touching pixels. Mask-image, not
     mix-blend-mode: the design system specifically rules out blend
     modes on specimen images (stacking contexts trap the blend); a
     mask has no such restriction. */
  .spec[data-vignette='1'] img {
    -webkit-mask-image: radial-gradient(ellipse 60% 60% at 50% 48%, black 58%, transparent 100%);
    mask-image: radial-gradient(ellipse 60% 60% at 50% 48%, black 58%, transparent 100%);
  }

  .spec-tag {
    position: absolute;
    left: 0;
    bottom: -1.6em;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0;
    white-space: nowrap;
    transition: opacity 0.8s var(--ease);
  }

  .spec[data-awake='1'] .spec-tag {
    opacity: 0.85;
  }

  /* Unprompted flare — the one piece of the field that doesn't wait for
     the visitor to do anything. --flare is set per-frame in JS (0 to 1,
     triangular envelope over ~2.6s, randomized per specimen); driven as
     a halo here rather than a CSS animation, since its timing isn't a
     fixed loop. The brightness/saturation half of the effect lives in
     the .spec img/video rule above, combined with --awake.
     drop-shadow follows the element's alpha, not its color — on an
     opaque rectangle (everything without a real cutout) it draws a
     glow around the whole box regardless of how dark the pixels are,
     which is the same box problem as the brightness escalation above.
     Scoped to [data-cutout] for the same reason. */
  .spec[data-cutout='1'] {
    filter: drop-shadow(0 0 calc(var(--flare, 0) * 34px) rgba(247, 197, 106, calc(var(--flare, 0) * 0.55)));
  }

  /* ---- fragments: quotes, not one-liners. Wrapped to 2-3 lines,
     a specimen card rather than wallpaper text, since there are only
     ever a handful on screen at once now. ---- */
  .frag-slot {
    position: absolute;
    top: 0;
    left: 0;
    width: min(24em, 62vw);
    will-change: transform, opacity;
  }

  .frag-quote {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    /* WONK was 1 -- Fraunces' wonky, hand-lettered alternate
       letterforms, deliberately irregular by design. Fine for a
       display headline having fun with itself; wrong for the site's
       essay fragments, called out directly as looking bad on the
       landing's copy of this same setting (Landing.astro's .purpose).
       0 uses the regular forms; SOFT (terminal roundness) is
       unrelated and left as is. */
    font-variation-settings: 'SOFT' 50, 'WONK' 0;
    /* Was --flesh -- a light, bright pink-tan that reads closer to
       skin than to the muted bronze/rust the reference's own quotes
       use (--oxide-lit). Matched to that instead. */
    color: var(--oxide-lit);
    line-height: 1.4;
    border-left: 1px solid rgba(247, 197, 106, 0.22);
    padding-left: 0.85em;
    transition: border-color 0.7s var(--ease);
  }

  .frag-quote i {
    display: inline-block;
    font-style: normal;
    will-change: transform, opacity;
  }

  /* One word, one atomic unit for line-breaking -- see the comment in
     assignFragment(). Without this wrapper, bare sibling <i> letters
     can wrap mid-word since each is its own inline-block. */
  .frag-word {
    display: inline-block;
    white-space: nowrap;
  }

  .frag-ref {
    margin: 0.5em 0 0 0.85em;
    font-family: var(--font-mono);
    /* Was 0.62rem at 0.45 alpha -- a design critique called this out
       correctly: "that is decoration, not citation... bump them or
       they will never be read." A source line that's structurally
       too faint to read defeats its own purpose. Still quieter than
       the quote itself (this is metadata, not voice), just no longer
       below the floor of legibility. */
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    color: rgba(227, 175, 149, 0.65);
    line-height: 1.3;
  }

  /* ---- nerve stops ---- */
  .stop {
    position: absolute;
    top: 0;
    left: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: rgba(243, 235, 224, 0.3);
    white-space: nowrap;
    transition: color 0.5s, letter-spacing 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    cursor: pointer;
    /* z-index alone decides paint ORDER, not whether something behind
       it is still legible -- plain text with nothing opaque behind it
       still visually tangles with whatever's underneath regardless of
       stacking order. A soft black halo (not a hard-edged box, to stay
       out of the way aesthetically) keeps navigation readable no
       matter what a fragment happens to be drifting through at the
       same spot. */
    /* Strengthened after seeing a stop tangle with both a fragment AND
       a specimen at once (a lit chimp portrait, not just flat black) --
       the original three-layer halo wasn't dense enough to hold up
       against a detailed, bright background. More layers, tighter at
       the core, for real coverage right at the glyph edges rather than
       just a wider blur. */
    text-shadow:
      0 0 1px var(--void), 0 0 2px var(--void), 0 0 4px var(--void),
      0 0 8px var(--void), 0 0 14px var(--void), 0 0 20px var(--void);
  }

  .stop[data-near='1'] {
    color: var(--gold);
    letter-spacing: 0.52em;
  }

  @media (prefers-reduced-motion: reduce) {
    .spec img,
    .spec video,
    .spec-tag,
    .stop {
      transition: none;
    }
  }
</style>

<script>
  import { FRAGS } from '../data/fragments';

  type Specimen = {
    img?: string;
    vid?: string;
    poster?: string;
    w: number;
    y: number;
    d: number;
    tag?: string;
    vignette?: boolean; // true = source has a soft dark edge, not flat black — fade it via mask instead of showing a rectangle
    cutout?: boolean; // true = source has a genuine alpha-cut background — safe to brighten/glow on wake without lighting up a visible rectangle
    boost?: number; // static brightness multiplier on top of the base 0.82 -- compensates for a source that's inherently pale/low-contrast (not a real fix; that's a re-shoot), default 1
    pulse?: boolean; // true = fades slowly in and out on its own, independent of awake/flare -- per Eduardo's note for the second jellyfish
  };

  const SPECIMENS: Specimen[] = [
    { img: '/specimens/chimp.png', w: 460, y: 0.28, d: 1.0, tag: 'No.04 · PROXIMITY · CHIMP', vignette: true, cutout: true },
    // Still big and near-load-visible (xn≈0.21 resolves near the
    // left-center of the screen at load), but moved to the lower half --
    // y was 0.2, same band as the chimp (0.28) and the first jellyfish
    // (0.2), leaving three of ten specimens stacked in the top quarter
    // of the screen and almost nothing below center besides the
    // goldfish. At this y and size the tentacles can drift close to the
    // permanent purpose-line text (worked out: the existing vertical
    // sine drift, worldYoff, moves every specimen by up to ±144px*d --
    // not unique to this one), but that's not the corner-mark bug from
    // earlier: Landing.astro's content always paints above the whole
    // field regardless of what's behind it, so the text stays fully
    // legible either way. A specimen drifting near it is the same
    // "chaos" every other specimen already has.
    // Replaced the static PNG with a looping animation Eduardo sent --
    // genuinely alpha-cut this time (verified the same way as the
    // others: canvas pixel sampling and a real <video> tag against
    // both red and true-black test backgrounds), so vignette is
    // dropped -- the old PNG's soft dark edge needed that mask, this
    // one blends into true black cleanly on its own.
    { vid: '/specimens/octopus.webm', w: 640, y: 0.66, d: 0.97, tag: 'No.02 · GOVERNANCE · OCTOPUS', cutout: true },
    { vid: '/specimens/jellyfish.webm', w: 560, y: 0.2, d: 0.66, tag: 'No.03 · TRUST · JELLYFISH', cutout: true },
    { vid: '/specimens/goldfish.mp4', poster: '/specimens/goldfish.png', w: 400, y: 0.7, d: 0.94, tag: 'No.01 · MEMORY · GOLDFISH', boost: 1.2 },
    // Replaces the old static pig.png -- an animated piglet (turns to
    // face camera, sits) with the same "DATA" motif as the other
    // specimens. Not a cutout (plain mp4, opaque, near-black background
    // matching the old still almost pixel-for-pixel), so it gets the
    // standard static treatment, same as goldfish/seaweed.
    { vid: '/specimens/piglet.mp4', poster: '/specimens/piglet-poster.png', w: 300, y: 0.42, d: 0.74, tag: 'No.05 · MEANING · PIGLET' },
    { img: '/specimens/eyefish.png', w: 260, y: 0.54, d: 0.58, boost: 1.15 },
    { vid: '/specimens/seaweed.mp4', w: 300, y: 0.34, d: 0.5 },
    // Both genuinely alpha-cut (verified same as the others: canvas
    // pixel sampling and a real <video> tag against a red test
    // background), appended rather than reordered so they don't shift
    // the octopus/chimp's tuned load-time positions.
    { vid: '/specimens/brain.webm', w: 480, y: 0.46, d: 0.9, tag: 'No.06 · CURIOSITY · BRAIN', cutout: true },
    { vid: '/specimens/bluefish.webm', w: 420, y: 0.58, d: 0.62, tag: 'No.07 · GOVERNANCE · BLUE FISH', cutout: true },
    // Second jellyfish -- was a still, now a looping animation Eduardo
    // sent, genuinely alpha-cut (verified against both red and true-
    // black test backgrounds, same as the octopus above), so cutout:
    // true now too. Still fades in and out very slowly on its own
    // (pulse: true) on top of that -- the two are independent, so it
    // both swims in its own loop and breathes in and out at the same
    // time. Different y/d from the existing jellyfish so the two don't
    // habitually overlap.
    { vid: '/specimens/jellyfish2.webm', w: 460, y: 0.62, d: 0.42, tag: 'No.08 · TRUST · JELLYFISH', pulse: true, cutout: true },
    // Second goldfish -- Eduardo sent a new render, genuinely alpha-cut
    // this time (verified directly: sampled the decoded video frame's
    // own alpha channel in a real browser, not just the file's
    // metadata tag -- corner pixels read alpha 0, the fish itself 255).
    // A separate entry, not a replacement for the existing goldfish.mp4,
    // same precedent as jellyfish2 above: same thread (MEMORY), a new
    // catalog number, different y/d so the two don't habitually overlap
    // or read as one duplicated fish.
    { vid: '/specimens/goldfish2.webm', w: 520, y: 0.24, d: 0.78, tag: 'No.09 · MEMORY · GOLDFISH', cutout: true },
  ];

  const STOPS: [string, string][] = [
    ['Manifesto', 'the argument, stated once'],
    ['Writing', 'twenty five signals'],
    ['Lexicon', 'contested words, defined in public'],
    ['Out Loud', 'talks, panels, DAMA, the white paper'],
    ['First Dates', 'speed dating the machines'],
    ['Who', 'Panama, Finland, Barcelona, a goat'],
    ['Contact', 'a question, answerable'],
  ];

  function initField() {
    const root = document.getElementById('field-root');
    const world = document.getElementById('world');
    const canvas = document.getElementById('nerve') as HTMLCanvasElement | null;
    if (!root || !world || !canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Almost everything in the field -- specimens waking, fragments
    // holding their decay, the nerve bending -- is a hover mechanic.
    // A touch device has no hover, only contact, so on its own terms
    // the whole system would sit permanently in its dimmest, most
    // passive state: specimens never wake, fragments never get
    // "held." isTouch changes two things below: specimens wake on tap
    // instead of proximity, and fragments get a longer base lifespan
    // since touch users can't hover-protect one the way a mouse user
    // can.
    const isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
    let W = 0, H = 0, DPR = Math.min(devicePixelRatio || 1, 2);
    let WORLD_W = 4200;
    let px = -9999, py = -9999, hasPointer = false, t = 0;
    let worldX = 0, targetX = 0, worldYoff = 0, dragY = 0;
    let drag = false, lastX = 0, lastY = 0;

    const wrap = (v: number, m: number) => ((v % m) + m) % m;

    function resize() {
      W = innerWidth; H = innerHeight;
      DPR = Math.min(devicePixelRatio || 1, 2);
      WORLD_W = Math.max(1600, Math.min(4600, W * 3.2));
      canvas!.width = W * DPR;
      canvas!.height = H * DPR;
      canvas!.style.width = W + 'px';
      canvas!.style.height = H + 'px';
      ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);
      buildChain();
      computeNerveChannel();
    }

    // ---- input: drag horizontal (infinite) + vertical (bounded), wheel scrolls horizontal ----
    addEventListener('pointermove', (e) => {
      px = e.clientX; py = e.clientY; hasPointer = true;
      if (drag) {
        targetX -= (e.clientX - lastX) * 1.7;
        dragY = Math.max(-H * 0.34, Math.min(H * 0.34, dragY + (e.clientY - lastY) * 0.9));
        lastX = e.clientX; lastY = e.clientY;
      }
    });
    addEventListener('pointerleave', () => { hasPointer = false; px = -9999; py = -9999; });
    root.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('.stop')) return;
      drag = true; lastX = e.clientX; lastY = e.clientY;
    });
    addEventListener('pointerup', () => { drag = false; });
    addEventListener('wheel', (e) => {
      targetX += (Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY) * 1.1;
    }, { passive: true });

    // ================= nerve: closed-form wave, sampled fresh each frame =================
    const N = 56, MARGIN = 240;
    type Pt = { x: number; y: number };
    let chain: Pt[] = [];
    // Real spring-mass state per chain point, layered ON TOP of the
    // closed-form base wave below -- direct feedback that a purely
    // sinusoidal nerve "feels pre-recorded." Cursor proximity pushes a
    // point away (repulsion, not attraction: the earlier version pulled
    // the curve toward the cursor, which reads as the wire chasing the
    // pointer rather than being disturbed by it), then stiffness pulls
    // it back and damping bleeds the energy off -- genuine overshoot and
    // settle, not an instant snap-back. Each point also couples to its
    // two neighbours' current offset, so a poke at one spot visibly
    // propagates along the wire before dying out, the actual mechanism
    // behind "transfers energy to adjacent nodes like a cello string."
    let springY: number[] = [];
    let springV: number[] = [];
    function buildChain() {
      chain = [];
      springY = [];
      springV = [];
      for (let i = 0; i < N; i++) {
        const x = (i / (N - 1)) * (W + MARGIN * 2) - MARGIN;
        chain.push({ x, y: H * 0.55 });
        springY.push(0);
        springV.push(0);
      }
    }

    // The safe vertical channel the nerve is allowed to occupy. First
    // attempt at this used fixed fractions of H (0.51-0.72), tuned by
    // sampling collisions at exactly one viewport (1440x900 desktop).
    // That fixed band was wrong everywhere else: on a phone, the real
    // gap between the tagline and the quote is much taller than on
    // desktop, so the same fraction-of-H math left a large dead zone
    // of empty black between them and squeezed the wave down to a
    // flat, minor squiggle instead of the dominant, hypnotic curve the
    // reference prototype has -- a friend's side-by-side screenshot
    // caught this precisely (their reference vs. this site on the same
    // phone). Measuring the ACTUAL rendered gap between the real
    // elements instead, so the channel -- and the wave that fills it --
    // adapts to whatever room genuinely exists on that viewport, phone
    // or desktop alike, rather than a number tuned for one screen.
    let nerveMin = H * 0.16, nerveMax = H * 0.86;
    function computeNerveChannel() {
      if (document.body.dataset.landing === 'field') {
        // Docked: the corner mark is tiny and the quote is hidden
        // (opacity 0) -- only the very top (top-bar/corner mark) and
        // very bottom (meta/stops) need real clearance.
        nerveMin = H * 0.12;
        nerveMax = H * 0.88;
        return;
      }
      const tagline = document.querySelector('.tagline');
      const purpose = document.getElementById('frag-a');
      if (!tagline || !purpose) return;
      const tBottom = tagline.getBoundingClientRect().bottom;
      const pTop = purpose.getBoundingClientRect().top;
      const margin = 26;
      // Sanity floor (120px) before trusting the measurement -- a
      // layout mid-reflow (fonts still loading, a transition mid-way)
      // could momentarily report a near-zero or negative gap, and
      // clamping the wave into that would be worse than just keeping
      // last frame's good channel until the next recompute.
      if (pTop - tBottom > margin * 2 + 120) {
        nerveMin = tBottom + margin;
        nerveMax = pTop - margin;
      }
    }

    // The base curve: a slow amplitude "breath" (the wave's height
    // itself swells and eases, not just the wave riding at a fixed
    // height), a spatial "warp" so the phase isn't perfectly even
    // across the width (an organic curve, not a uniform machine-sine),
    // and a mid-line that drifts with the same worldYoff the specimens
    // already move on -- so the nerve and the cabinet breathe together.
    // Every amplitude term below is a fraction of the CHANNEL's own
    // height, not of H directly -- that's what makes the wave big and
    // confident on a tall phone channel and safely smaller on a short
    // desktop one, from the same formula.
    function nerveBaseY(x: number): number {
      const u = x / Math.max(W, 1);
      const channel = nerveMax - nerveMin;
      const breath = 0.55 + 0.45 * Math.sin(t * 0.22);
      const mid = nerveMin + channel * 0.5 + Math.sin(t * 0.14) * channel * 0.05 + worldYoff * 0.06;
      const warp = u + 0.08 * Math.sin(u * Math.PI * 2 + t * 0.2);
      const amp = channel * (0.14 + 0.12 * breath);
      return (
        mid +
        Math.sin(warp * Math.PI * 1.05 + t * 0.48) * amp +
        Math.sin(warp * Math.PI * 2.1 + t * 0.27) * amp * 0.28 +
        Math.sin(u * Math.PI * 0.4 + t * 0.11) * channel * 0.035
      );
    }

    // springY is stored per discrete chain index, evenly spaced across
    // [-MARGIN, W+MARGIN] -- interpolating between the two nearest
    // indices gives a smooth value at any arbitrary x (specimens,
    // connectors, pulses, stops all query chainYAt at x's that don't
    // land on the grid).
    function springAt(x: number): number {
      const span = W + MARGIN * 2;
      const fi = ((x + MARGIN) / span) * (N - 1);
      const i0 = Math.max(0, Math.min(N - 1, Math.floor(fi)));
      const i1 = Math.min(N - 1, i0 + 1);
      const frac = fi - i0;
      return springY[i0] * (1 - frac) + springY[i1] * frac;
    }

    // Underdamped mass-spring per point (stiffness pulls back toward 0,
    // damping bleeds the energy off slower than critical, so a poke
    // genuinely overshoots and settles rather than snapping straight
    // back), each also coupled to its two immediate neighbours' current
    // offset -- a disturbance at one point visibly travels along the
    // chain before dying out, instead of every point reacting only to
    // its own isolated distance from the cursor.
    function stepSprings(dt: number) {
      if (reduced || dt <= 0) return;
      const STIFF = 90, DAMP = 7, COUPLE = 55, RADIUS = 220, PUSH = 4000;
      for (let i = 0; i < N; i++) {
        const x = chain[i].x;
        let force = 0;
        if (hasPointer && !isTouch) {
          const baseY = nerveBaseY(x);
          const dist = Math.hypot(x - px, baseY - py);
          if (dist < RADIUS) {
            const f = (1 - dist / RADIUS) * PUSH;
            // Repulsion, not attraction: the wire is disturbed BY the
            // cursor (deforms away from it), rather than chasing the
            // cursor's position -- the actual behaviour asked for.
            force += py > baseY ? -f : f;
          }
        }
        const left = i > 0 ? springY[i - 1] : springY[i];
        const right = i < N - 1 ? springY[i + 1] : springY[i];
        force += COUPLE * ((left + right) * 0.5 - springY[i]);
        const accel = force - STIFF * springY[i] - DAMP * springV[i];
        springV[i] += accel * dt;
        springY[i] += springV[i] * dt;
      }
    }

    function chainYAt(x: number): number {
      const y = nerveBaseY(x) + springAt(x);
      // The corner mark, top bar, tagline, purpose line, and meta live
      // in Landing.astro's own stacking context, which paints above
      // this whole canvas regardless of the nerve's z-index -- that
      // only wins comparisons against other things inside Field.astro
      // (specimens, fragments, stops), not against a sibling section
      // entirely. Clamping keeps the curve's actual geometry out of
      // both text zones so it can't happen, rather than trying to
      // out-stack a separate section. nerveMin/nerveMax are the
      // measured channel above, recomputed regularly in frame().
      return Math.max(nerveMin, Math.min(nerveMax, y));
    }

    function stepChain(dt: number) {
      stepSprings(dt);
      // Base wave: a fresh, stateless sample of nerveBaseY(x) each
      // frame. The spring layer above is the only stateful part now.
      for (const p of chain) p.y = chainYAt(p.x);
    }

    const pulses = [
      { speed: 0.055, phase: 0.1 }, { speed: 0.08, phase: 0.62 }, { speed: 0.038, phase: 0.35 },
      { speed: 0.067, phase: 0.82 }, { speed: 0.046, phase: 0.5 },
    ];

    // ================= specimens =================
    const specNodes = SPECIMENS.map((s, i) => {
      const el = document.createElement('div');
      el.className = 'spec';
      if (s.img) {
        el.innerHTML = `<img src="${s.img}" alt="" loading="lazy" />`;
      } else if (s.vid) {
        const posterAttr = s.poster ? ` poster="${s.poster}"` : '';
        el.innerHTML = `<video src="${s.vid}" muted loop playsinline preload="metadata"${posterAttr}></video>`;
      }
      if (s.tag) {
        const tag = document.createElement('span');
        tag.className = 'spec-tag';
        tag.textContent = s.tag;
        el.appendChild(tag);
      }
      world!.appendChild(el);
      const video = el.querySelector('video') as HTMLVideoElement | null;
      if (video) video.playbackRate = 0.45; // slowed for drama, per Eduardo's note
      el.style.zIndex = String(Math.round(s.d * 100));
      if (s.vignette) el.dataset.vignette = '1';
      if (s.cutout) el.dataset.cutout = '1';
      if (s.boost) el.style.setProperty('--boost', String(s.boost));
      const node = {
        el, s, video,
        xn: (i + 0.5) / SPECIMENS.length + (((i * 67) % 140) - 70) / 4200,
        awake: 0, playing: false,
        tapAwakeUntil: 0,
        leanX: 0, leanY: 0,
        // Independent per-specimen cycle, per the field spec: "Every
        // few seconds one flares unprompted... asking to be looked
        // at." This is the one piece of aliveness that doesn't depend
        // on anyone doing anything -- everything else in the field
        // reacts to the visitor; this one doesn't wait to be found.
        flareIn: 6 + Math.random() * 14,
        flareT: -1, // -1 = not currently flaring
        pulsePhase: Math.random() * Math.PI * 2,
        // Last frame's anchor X, used to derive real per-frame velocity
        // for the connector filament's lagging control point (see the
        // connector-drawing block in frame()) rather than assuming a
        // fixed drift direction.
        prevAnchorX: 0,
      };
      if (isTouch) {
        el.style.pointerEvents = 'auto';
        el.addEventListener('click', () => { node.tapAwakeUntil = t + 4; });
      }
      return node;
    });

    // ================= fragments =================
    // Only a handful exist on screen at once -- an infinite pool of 50,
    // shown a few at a time, staggered in over the first ~20s rather
    // than all appearing together. When one decays and dies, that slot
    // (after a pause) picks the next fragment from a shuffled queue and
    // arrives fresh: from a random edge (left/right/top/bottom), never
    // just sliding in with the horizontal drift like everything else.
    // Depth is shared with specimens for z-index, so fragments genuinely
    // interleave in front of and behind them rather than always sitting
    // on top.
    // Fewer concurrent slots on narrow screens: 6 quote blocks (each up
    // to several lines tall) simply don't fit in the compressed vertical
    // range a short mobile viewport leaves once the bottom marks are
    // excluded -- window.innerWidth here, not the closure W, since W
    // isn't set until the first resize() call, which happens after this.
    // Was 6, then 4 -- reduced again after the menagerie grew to 9
    // specimens (brain, blue fish added since) and a friend's screenshot
    // still showed a quote, a specimen, and a stop all crammed into one
    // spot, illegible. Fewer concurrent fragments gives the rest of the
    // field -- now genuinely dense on its own -- more room to be seen.
    const SLOT_COUNT = window.innerWidth < 500 ? 2 : 3;
    type Dir = 'left' | 'right' | 'top' | 'bottom';
    const DIRS: Dir[] = ['left', 'right', 'top', 'bottom'];

    let fragQueue: number[] = [];
    function shuffledIndices(n: number) {
      const arr = Array.from({ length: n }, (_, i) => i);
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }
    function nextFragIndex() {
      if (fragQueue.length === 0) fragQueue = shuffledIndices(FRAGS.length);
      return fragQueue.pop()!;
    }

    const fragSlots = Array.from({ length: SLOT_COUNT }, (_, slotI) => {
      const el = document.createElement('div');
      el.className = 'frag-slot';
      el.dataset.slot = String(slotI);
      const quote = document.createElement('p');
      quote.className = 'frag-quote';
      const ref = document.createElement('p');
      ref.className = 'frag-ref';
      el.appendChild(quote);
      el.appendChild(ref);
      world!.appendChild(el);

      return {
        el, quote, ref, slotI,
        chars: [] as HTMLElement[],
        parts: [] as { vx: number; vy: number; baseX: number; baseY: number }[],
        fragIndex: -1,
        depth: 0.5,
        xn: 0, y: 0.5,
        entryDir: 'left' as Dir,
        entryAmt: 0, // 1 = fully off-screen at entry point, eases to 0
        aloneTime: 0,
        state: 'pending' as 'pending' | 'alive' | 'decaying' | 'dead',
        pendingT: slotI * 3 + Math.random() * 3, // staggered first appearance
        decayT: 0,
        respawnDelay: 0,
      };
    });

    function assignFragment(slot: typeof fragSlots[number]) {
      const idx = nextFragIndex();
      const f = FRAGS[idx];
      slot.fragIndex = idx;
      // The one Spanish line in the set ("No se puede empezar...")
      // was inheriting the page's lang="en" like every other fragment
      // -- wrong for assistive tech and translate tooling reading the
      // page, per the design critique's craft checklist.
      slot.quote.lang = f.lang || 'en';
      slot.quote.textContent = '';
      // Each letter is its own inline-block <i> so the decay physics can
      // move it independently -- but adjacent inline-blocks each carry
      // their own implicit line-break opportunity regardless of word
      // boundaries, so a word rendered as bare sibling <i>s can wrap
      // mid-letter ("penthouse" -> "penthous" / "e"), found by actually
      // screenshotting a fragment and seeing it happen. Fixed by
      // grouping each word's letters inside a nowrap wrapper, so the
      // wrapper -- not each letter -- is the atomic breakable unit;
      // breaks can then only fall where a real space does.
      slot.chars = [];
      const tokens = f.text.match(/\S+|\s+/g) || [];
      for (const token of tokens) {
        const isSpace = token[0] === ' ';
        const container = isSpace ? slot.quote : document.createElement('span');
        if (!isSpace) container.className = 'frag-word';
        for (const ch of token) {
          const s = document.createElement('i');
          // A plain space as the sole content of an inline-block collapses
          // to zero width -- browsers trim it as leading/trailing
          // whitespace in the inline formatting context. A non-breaking
          // space renders as a real, breakable-adjacent gap instead.
          s.textContent = ch === ' ' ? ' ' : ch;
          container.appendChild(s);
          slot.chars.push(s);
        }
        if (!isSpace) slot.quote.appendChild(container);
      }
      slot.parts = slot.chars.map(() => ({ vx: 0, vy: 0, baseX: 0, baseY: 0 }));
      slot.ref.textContent = f.source ? `— ${f.source}` : '';
      slot.ref.style.display = f.source ? '' : 'none';
      slot.ref.style.transition = '';
      slot.ref.style.opacity = '1';
      slot.depth = f.weight === 'long' ? 0.6 + Math.random() * 0.22 : 0.3 + Math.random() * 0.3;
      // Font-size depends only on depth, so it's set here rather than at
      // the very end of this function -- moved up because the shelf
      // jitter below needs the block's REAL rendered height, which
      // needs the real font-size already applied first.
      slot.quote.style.fontSize = (14 + (1 - Math.abs(slot.depth - 0.7)) * 8) + 'px';
      // Spawn where it can actually be seen: solve for the xn that puts
      // it inside the current viewport right now, rather than a random
      // point across the whole ~4000px world (which, at 6 slots vs. a
      // world wider than the screen, would spawn most fragments
      // somewhere nobody will ever scroll to before they decay unseen).
      const depthFactor = 0.3 + slot.depth * 0.7;
      // Kept out of the bottom ~35% of the viewport on purpose -- the
      // purpose line and the Barcelona/LinkedIn mark both live down
      // there and are permanent fixtures, not other field objects a
      // fragment is allowed to drift behind. Within that, each slot
      // gets its own dedicated vertical band rather than a fully
      // random y -- random placement let multiple 3-6-line quote
      // blocks land on the same rows and pile up unreadably, most
      // visible on short mobile viewports where the usable range is
      // small to begin with. One slot, one shelf.
      const bandH = 0.55 / SLOT_COUNT;
      // Slot 0's band starts at the same corner as the permanent
      // wordmark -- found by screenshotting it and seeing a quote
      // rendered directly on top of "EDUARDO sopalda," both illegible.
      // An X-only push (tried first) doesn't work on narrow viewports,
      // where the mark can span most of the width and there's no safe
      // column to its right at all -- so this measures the mark's own
      // rendered bottom edge and pushes the top band BELOW it instead,
      // which holds regardless of viewport width.
      // Only while actually docked, though -- slot 0's own pendingT (up
      // to 3s) means it often first spawns during the hero, where .mark
      // is still the huge, centered hero wordmark, not the small corner
      // mark this push exists for. Measuring THAT bottom edge inflated
      // topBandStart hugely, and since it's only recalculated on this
      // slot's next (rare, decay-gated) respawn, slot 0's whole shelf
      // stayed pushed for its next 40-70+ seconds -- confirmed directly
      // as the actual cause of slot 0 landing on top of slot 2's shelf,
      // not the "long quote overflows its own shelf" case this file
      // used to blame.
      let topBandStart = 0.08;
      if (slot.slotI === 0 && document.body.dataset.landing === 'field') {
        const markEl = document.querySelector('.mark');
        if (markEl) topBandStart = Math.max(topBandStart, (markEl.getBoundingClientRect().bottom + 20) / H);
      }
      // Jitter within the band was up to 0.5*bandH, then a flat 0.25 --
      // both assumed every quote was short enough to fit its shelf with
      // room to spare. A "long"-weight quote can wrap to 3-4 lines,
      // tall enough to reach into the next shelf even parked at the very
      // top of its own band -- confirmed directly: a long and a short
      // quote in adjacent shelves rendering on top of each other for
      // their entire shared lifetime, not just a passing brush during
      // drift. The block already has its real text and font-size, so
      // its real rendered height is measurable now -- cap the downward
      // jitter by whatever room that leaves, instead of a fixed fraction
      // that assumes a height no quote here actually has.
      const measuredH = slot.el.offsetHeight || 80;
      const roomFrac = Math.max(0, bandH - measuredH / H - 0.01);
      const jitter = Math.min(bandH * 0.25, roomFrac);
      slot.y = slot.slotI === 0 ? topBandStart + Math.random() * jitter : 0.08 + slot.slotI * bandH + Math.random() * jitter;
      // Bands only ever kept fragments from piling on EACH OTHER --
      // nothing kept a fragment from spawning right on top of a
      // specimen that happened to be drifting through that same screen
      // area, which a friend's screenshot caught directly (a quote
      // rendered right across a specimen's face, both unreadable). Since
      // specimens keep drifting independently after a fragment spawns,
      // this can't be fully solved, but retrying the X position a few
      // times against every specimen's ACTUAL current on-screen rect
      // avoids spawning directly into a collision at least.
      const candidateY = slot.y * H;
      function collidesWithSpecimen(x: number) {
        for (const n of specNodes) {
          const r = n.el.getBoundingClientRect();
          if (r.width < 10) continue;
          const pad = 24;
          if (x > r.left - pad && x < r.right + pad && candidateY > r.top - pad && candidateY < r.bottom + pad) return true;
        }
        return false;
      }
      // Leaves room on the right for the quote block's own width (up to
      // 24em) so it doesn't spawn overflowing off the viewport edge —
      // the first version placed it anywhere up to 0.84W and clipped.
      let targetScreenX = W * 0.06 + Math.random() * W * 0.5;
      for (let attempt = 0; attempt < 6 && collidesWithSpecimen(targetScreenX); attempt++) {
        targetScreenX = W * 0.06 + Math.random() * W * 0.5;
      }
      const offset = Math.min(520, W * 0.4);
      slot.xn = wrap(targetScreenX + offset + worldX * depthFactor, WORLD_W) / WORLD_W;
      slot.entryDir = DIRS[Math.floor(Math.random() * DIRS.length)];
      slot.entryAmt = 1;
      slot.aloneTime = 0;
      slot.state = 'alive';
      slot.el.style.zIndex = String(Math.round(slot.depth * 100));
    }

    // ================= stops =================
    const stopNodes = STOPS.map((s, i) => {
      const el = document.createElement('div');
      el.className = 'stop';
      el.textContent = s[0];
      world!.appendChild(el);
      el.style.zIndex = '200'; // navigation always reads above specimens/fragments
      el.addEventListener('click', () => {
        // Rooms aren't built yet — quiet no-op stub, matching the
        // working prototype's own "not built yet" placeholder rather
        // than a dead link or a fake destination.
        el.dataset.justClicked = '1';
        setTimeout(() => delete el.dataset.justClicked, 400);
      });
      return { el, name: s[0], xn: (i + 0.5) / STOPS.length, near: 0 };
    });

    // Touch users can't rest a cursor near a fragment to hold it the
    // way a mouse user can, so they'd otherwise lose every fragment to
    // decay regardless of attention. Longer base life, not proximity,
    // is the touch equivalent -- unconditional rather than earned.
    const DECAY_AFTER = isTouch ? 70 : 40, DECAY_TIME = 10;

    let channelT = 0;
    function frame() {
      const dt = reduced ? 0 : 1 / 60;
      t += dt;

      if (!drag) targetX += reduced ? 0 : 0.34;
      worldX += (targetX - worldX) * 0.06;
      worldYoff = dragY + (reduced ? 0 : Math.sin(t * 0.0817) * H * 0.16);

      // Every ~20 frames (~3/sec), not every frame -- getBoundingClientRect
      // forces a layout read, and the channel only needs to track real
      // changes (the hero->field transition moving everything, a new
      // quote fragment changing height), not react within one frame of
      // them. Catches both without a resize or attribute-change listener.
      channelT += 1;
      if (channelT > 20) { channelT = 0; computeNerveChannel(); }

      stepChain(dt);
      ctx!.clearRect(0, 0, W, H);

      function strokePath() {
        ctx!.beginPath();
        ctx!.moveTo(chain[0].x, chain[0].y);
        for (let i = 1; i < chain.length - 1; i++) {
          const midX = (chain[i].x + chain[i + 1].x) / 2;
          const midY = (chain[i].y + chain[i + 1].y) / 2;
          ctx!.quadraticCurveTo(chain[i].x, chain[i].y, midX, midY);
        }
        const last = chain[chain.length - 1];
        ctx!.lineTo(last.x, last.y);
      }

      ctx!.shadowColor = 'rgba(247, 197, 106, 0.5)';
      ctx!.shadowBlur = 10;
      strokePath();
      ctx!.strokeStyle = 'rgba(198, 145, 68, 0.4)';
      ctx!.lineWidth = 3;
      ctx!.stroke();

      ctx!.shadowBlur = 4;
      strokePath();
      ctx!.strokeStyle = 'rgba(247, 197, 106, 0.9)';
      ctx!.lineWidth = 1;
      ctx!.stroke();

      // Electricity, not just moving dots: each pulse is a short comet
      // trailing gold along the actual curve (sampled via chainYAt, so
      // the trail bends with the wire itself), fading tail-to-head
      // through a gradient rather than one flat colour.
      // Near-white, not gold -- the base line is already a warm gold at
      // 0.9 alpha, so a same-hue pulse barely reads against it. Contrast
      // (white-hot core against warm wire), not just motion, is what
      // makes this look like electricity running through the line
      // rather than a slightly-brighter bead sliding along it.
      ctx!.shadowBlur = 14;
      ctx!.shadowColor = 'rgba(255, 255, 235, 1)';
      const TRAIL = 130, STEPS = 16;
      for (const p of pulses) {
        const u = (t * p.speed + p.phase) % 1;
        const headX = u * W;
        const edge = Math.min(u, 1 - u);
        const o = Math.min(1, edge * 9);
        if (o <= 0.01) continue;
        ctx!.beginPath();
        for (let k = STEPS; k >= 0; k--) {
          const x = headX - (k / STEPS) * TRAIL;
          const y = chainYAt(x);
          if (k === STEPS) ctx!.moveTo(x, y); else ctx!.lineTo(x, y);
        }
        const grad = ctx!.createLinearGradient(headX - TRAIL, chainYAt(headX - TRAIL), headX, chainYAt(headX));
        grad.addColorStop(0, 'rgba(255, 255, 240, 0)');
        grad.addColorStop(0.6, `rgba(255, 250, 220, ${o * 0.5})`);
        grad.addColorStop(1, `rgba(255, 255, 245, ${o})`);
        ctx!.strokeStyle = grad;
        ctx!.lineWidth = 3.4;
        ctx!.stroke();
        ctx!.beginPath();
        ctx!.arc(headX, chainYAt(headX), 3.4, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(255, 255, 250, ${o})`;
        ctx!.fill();
      }
      ctx!.shadowBlur = 0;

      // ---- the point of light: the cursor itself, replaced. Drawn at
      // the same px/py already tracked for bending the nerve, so the
      // one glow the visitor moves IS the thing moving the wire. ----
      if (hasPointer && !isTouch) {
        const glow = ctx!.createRadialGradient(px, py, 0, px, py, 16);
        glow.addColorStop(0, 'rgba(255, 244, 214, 0.95)');
        glow.addColorStop(0.4, 'rgba(247, 197, 106, 0.45)');
        glow.addColorStop(1, 'rgba(247, 197, 106, 0)');
        ctx!.fillStyle = glow;
        ctx!.beginPath();
        ctx!.arc(px, py, 16, 0, Math.PI * 2);
        ctx!.fill();
        ctx!.beginPath();
        ctx!.arc(px, py, 2, 0, Math.PI * 2);
        ctx!.fillStyle = 'rgba(255, 250, 235, 0.95)';
        ctx!.fill();
      }

      // ---- specimens: position by depth, wake near cursor, play video on approach ----
      const flareLines: { x: number; y1: number; y2: number; o: number }[] = [];
      // Always-on connector filaments -- one per visible specimen, not
      // just the ones currently flaring (flareLines above stays a
      // separate, brighter overlay for that moment). Per direct
      // feedback: a straight canvas line read as rigid; drawn as a
      // quadratic Bezier instead, its control point offset opposite the
      // specimen's own current horizontal velocity, so the curve reads
      // as trailing/dragging behind motion rather than a static prop.
      const connectors: { sx: number; sy: number; cx: number; cy: number; nx: number; ny: number; o: number; pulse: number }[] = [];
      for (const n of specNodes) {
        // Scale floor was 0.48 with no cap, so on a 375px phone a
        // 380-460px specimen (octopus, chimp) still rendered at
        // ~180-220px -- roughly half the screen width for one
        // creature. Lower floor plus an explicit viewport-relative cap
        // (found by actually measuring a mobile screenshot, not by
        // assumption) keeps any single specimen from dominating a
        // narrow screen.
        const w0 = Math.min(n.s.w * Math.min(1, Math.max(0.32, W / 1300)), W * 0.42);
        // Depth of field: d spans roughly 0.42-1.0 across the roster.
        // Interpolated into scale/blur/speed rather than a hard
        // foreground/background split, since d itself is continuous --
        // shallow-d specimens read smaller, softer and drift slower
        // (0.65x, blur 2px), deep-d ones read larger and sharp (1.1x,
        // no blur), per the diorama note. Speed itself was already
        // depth-scaled via worldX * n.s.d below; unchanged.
        const dofT = Math.max(0, Math.min(1, (n.s.d - 0.42) / (1.0 - 0.42)));
        const scaleDof = 0.65 + dofT * (1.1 - 0.65);
        const blurPx = (1 - dofT) * 2;
        const w = w0 * scaleDof;

        const baseX = wrap(n.xn * WORLD_W - worldX * n.s.d, WORLD_W) - Math.min(520, W * 0.4);
        const anchorX = baseX + w * 0.5;
        // Anchored to the nerve's own live curve rather than a fixed
        // fraction of H -- each specimen orbits a set offset above or
        // below wherever the nerve actually is right now, so the two
        // move together instead of drifting as unrelated layers. The
        // side and offset magnitude come from each specimen's own
        // original y (its established compositional role -- upper vs
        // lower half, how far from center), so the roster's tuned
        // placements carry over; only the anchor mechanism changes.
        // worldYoff's own contribution moves here too, folded into the
        // orbit term below, since the nerve's own mid-line already
        // carries worldYoff*0.06 -- adding the old full worldYoff*d on
        // top of that double-counted the same drift.
        const nerveYHere = chainYAt(anchorX);
        const side = n.s.y < 0.5 ? -1 : 1;
        const orbitOffset = Math.abs(n.s.y - 0.5) * H * 1.3 + Math.sin(t * 0.09 + n.pulsePhase) * H * 0.02;
        const baseY = nerveYHere + side * orbitOffset - w * 0.3;
        const bsx = baseX + w * 0.5, bsy = baseY + w * 0.28;

        // Lean toward the cursor within a wider radius than the wake
        // threshold -- a specimen reaches slightly before it fully
        // wakes, rather than snapping straight from asleep to awake.
        let wantLeanX = 0, wantLeanY = 0;
        if (!isTouch && hasPointer) {
          const d = Math.hypot(px - bsx, py - bsy);
          const leanRadius = w * 1.2;
          if (d < leanRadius) {
            const f = 1 - d / leanRadius;
            const dx = px - bsx, dy = py - bsy, dl = Math.hypot(dx, dy) || 1;
            wantLeanX = (dx / dl) * f * f * 14;
            wantLeanY = (dy / dl) * f * f * 9;
          }
        }
        n.leanX += (wantLeanX - n.leanX) * 0.08;
        n.leanY += (wantLeanY - n.leanY) * 0.08;

        const X = baseX + n.leanX, Y = baseY + n.leanY;
        const sx = X + w * 0.5, sy = Y + w * 0.28;
        const on = X > -(w + 300) && X < W + 300 && Y > -w && Y < H + w;
        n.el.style.visibility = on ? 'visible' : 'hidden';

        // Flare cycle runs regardless of on-screen visibility (a
        // specimen currently off-screen shouldn't come back already
        // mid-flare, or always flare the instant it enters view) --
        // this is genuinely unprompted, not a reaction to being seen.
        if (n.flareT < 0) {
          n.flareIn -= dt;
          if (n.flareIn <= 0) { n.flareT = 0; n.flareIn = 9 + Math.random() * 16; }
        } else {
          n.flareT += dt;
          if (n.flareT >= 2.6) n.flareT = -1;
        }
        const flareEnv = n.flareT < 0 ? 0
          : n.flareT < 0.8 ? n.flareT / 0.8
          : n.flareT < 1.8 ? 1
          : (2.6 - n.flareT) / 0.8;
        n.el.style.setProperty('--flare', flareEnv.toFixed(3));

        // Pause only when actually off-screen, purely to save decode
        // work on something nobody can see -- never as a reaction to
        // proximity/hover. Every specimen video is meant to be a
        // continuous, unprompted animation, not something that starts
        // moving only once someone finds it.
        if (!on) {
          if (n.video && n.playing) { n.video.pause(); n.playing = false; }
          continue;
        }

        // Secondary motion -- a static specimen next to looping video
        // read as a flat cutout, not a living thing. Independent
        // levitation bob (own period, phase-offset per specimen so the
        // roster doesn't bob in lockstep) plus a slow breathing scale
        // pulse, both layered on top of the drift/lean transform rather
        // than replacing it.
        const bob = Math.sin(t * 0.7 + n.pulsePhase * 1.7) * (w * 0.015 + 3);
        const breatheScale = 1 + 0.015 * Math.sin((t * Math.PI * 2) / 4.5 + n.pulsePhase);
        n.el.style.transform = `translate3d(${X}px, ${(Y + bob).toFixed(1)}px, 0) scale(${breatheScale.toFixed(4)})`;
        n.el.style.width = w + 'px';
        // Depth-of-field blur on the specimen's own wrapper -- the child
        // img/video already carries brightness/contrast/saturate via
        // the CSS rule (see .spec img/video), so this composes with
        // that rather than overriding it (different elements).
        n.el.style.filter = blurPx > 0.05 ? `blur(${blurPx.toFixed(2)}px)` : '';

        // Slow, independent breathing -- 18s period, phase-offset per
        // specimen so two pulsing specimens (if there ever are more
        // than one) wouldn't sync up. Separate from --awake/--flare
        // entirely: this one dims all the way toward transparent, not
        // just less bright, since the ask was specifically to fade in
        // and out rather than dim and brighten.
        if (n.s.pulse) {
          const cyc = 0.5 + 0.5 * Math.sin((t * Math.PI * 2) / 18 + n.pulsePhase);
          n.el.style.opacity = (0.06 + cyc * 0.94).toFixed(3);
        }

        // Always-on connector filament, per specimen -- not just while
        // flaring. The Bezier control point lags opposite the
        // specimen's own real per-frame velocity (not an assumed fixed
        // direction), so the curve reads as trailing through something
        // viscous rather than a rigid prop; capped so a resize's first
        // frame (a large, spurious "jump") can't produce a wild curve.
        const velocity = Math.max(-40, Math.min(40, anchorX - n.prevAnchorX));
        n.prevAnchorX = anchorX;
        const nx = anchorX, ny = nerveYHere;
        connectors.push({
          sx, sy,
          cx: sx - velocity * 2.2,
          cy: (sy + ny) / 2,
          nx, ny,
          o: 0.16 + dofT * 0.14,
          pulse: n.pulsePhase,
        });

        if (flareEnv > 0.02) {
          flareLines.push({ x: sx, y1: sy, y2: chainYAt(sx), o: flareEnv * 0.7 });
        }

        let want = 0;
        if (isTouch) {
          want = t < n.tapAwakeUntil ? 1 : 0;
        } else if (hasPointer) {
          const d = Math.hypot(px - sx, py - sy);
          want = d < w * 0.62 ? 1 : 0;
        }
        n.awake += (want - n.awake) * 0.1;
        n.el.dataset.awake = n.awake > 0.5 ? '1' : '0';
        n.el.style.setProperty('--awake', n.awake.toFixed(3));

        // Every video specimen is a continuous animation, not a still
        // waiting to be woken -- was gated on n.awake > 0.4 (proximity/
        // hover), so a video sat frozen on its poster frame until
        // someone found it, called out directly as looking static.
        // --awake above still drives brightness/glow (that reactivity
        // is real and stays); playback itself no longer depends on it.
        if (n.video && !n.playing) {
          n.video.play().catch(() => {});
          n.playing = true;
        }
      }

      // Connector filaments -- one per visible specimen, always drawn
      // (not just while flaring; see flareLines just below for that
      // brighter, separate overlay). Quadratic Bezier, not a straight
      // line, its control point already offset opposite the specimen's
      // own real velocity when pushed above -- reads as dragging
      // through something viscous rather than a rigid prop. A small
      // pulsing "suture" node marks where the filament actually meets
      // the nerve, drawn after the curve so it sits on top of it.
      for (const c of connectors) {
        ctx!.beginPath();
        ctx!.moveTo(c.sx, c.sy);
        ctx!.quadraticCurveTo(c.cx, c.cy, c.nx, c.ny);
        ctx!.strokeStyle = `rgba(247, 197, 106, ${c.o})`;
        ctx!.lineWidth = 1;
        ctx!.stroke();

        const nodePulse = 0.5 + 0.5 * Math.sin(t * 1.6 + c.pulse);
        const nodeR = 1.4 + nodePulse * 1.1;
        ctx!.beginPath();
        ctx!.arc(c.nx, c.ny, nodeR, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(255, 235, 190, ${0.35 + nodePulse * 0.4})`;
        ctx!.shadowBlur = 6;
        ctx!.shadowColor = 'rgba(247, 197, 106, 0.8)';
        ctx!.fill();
        ctx!.shadowBlur = 0;
      }

      // The flare's "gold line dropped to the nerve" -- drawn after the
      // specimen loop so sx/chainYAt are already known for anything
      // currently flaring.
      if (flareLines.length) {
        ctx!.shadowBlur = 10;
        ctx!.shadowColor = 'rgba(247, 197, 106, 0.7)';
        for (const fl of flareLines) {
          ctx!.beginPath();
          ctx!.moveTo(fl.x, fl.y1);
          ctx!.lineTo(fl.x, fl.y2);
          ctx!.strokeStyle = `rgba(247, 197, 106, ${fl.o})`;
          ctx!.lineWidth = 1.2;
          ctx!.stroke();
        }
        ctx!.shadowBlur = 0;
      }

      // ---- fragments: staggered entrance, drift, decay onto the nerve ----
      const ENTRY_OFFSET = 320;
      // Read by the stops loop just below, so a stop label can duck
      // around a live quote instead of landing on top of it -- see that
      // loop's own comment for why this is a stop's problem to solve,
      // not the quote's.
      const liveFragRects: { x: number; y: number; w: number; h: number }[] = [];
      for (const slot of fragSlots) {
        if (slot.state === 'pending') {
          slot.pendingT -= dt;
          slot.el.style.visibility = 'hidden';
          if (slot.pendingT <= 0) assignFragment(slot);
          continue;
        }

        const depthFactor = 0.3 + slot.depth * 0.7;
        const baseX = wrap(slot.xn * WORLD_W - worldX * depthFactor, WORLD_W) - Math.min(520, W * 0.4);
        // Quotes sit on dedicated vertical shelves specifically so they
        // never overlap each other (see assignFragment's own comment on
        // bandH) -- but scaling worldYoff by the same per-fragment
        // depthFactor used for specimens' parallax meant two shelves
        // drifted by a DIFFERENT amount depending on which fragment each
        // had been assigned, since worldYoff's own swing (±0.16H) is
        // nearly as large as the gap between shelves. Confirmed directly:
        // two quotes' text rendered on top of each other mid-drift, well
        // after both had spawned cleanly separated. A small, flat sway
        // (not depth-scaled) keeps some ambient life without threatening
        // the separation the shelves exist for.
        const baseY = slot.y * H + worldYoff * 0.05;

        // Entry offset decays toward 0 each frame -- this is what makes
        // a freshly spawned fragment fly in from its chosen edge rather
        // than simply fading in at its resting spot.
        slot.entryAmt *= reduced ? 0 : 0.94;
        const off = slot.entryAmt * ENTRY_OFFSET;
        let ox = 0, oy = 0;
        if (slot.entryDir === 'left') ox = -off;
        else if (slot.entryDir === 'right') ox = off;
        else if (slot.entryDir === 'top') oy = -off;
        else oy = off;

        const X = baseX + ox, Y = baseY + oy;
        // Visibility is checked against the RESTING position (no entry
        // offset), and requires the whole block to fit -- not a wide
        // fixed-pixel margin around a partial overlap. The old margin
        // (700px) was sized for a 1440px desktop; on a 375px phone
        // that's nearly the entire screen of allowed overhang, so a
        // fragment mid-drift off the edge stayed "visible" while
        // showing only its right half, reading as clipped, broken
        // text. A fragment flying in from off-screen (entryAmt > 0)
        // still needs to render during that animation even though its
        // CURRENT position is off-screen on purpose, so containment is
        // judged on baseX/baseY, not the animated X/Y.
        const bw = slot.el.offsetWidth || 260;
        const bh = slot.el.offsetHeight || 80;
        const on = baseX > -10 && baseX + bw < W + 10 && baseY > -10 && baseY + bh < H + 10;
        slot.el.style.visibility = on ? 'visible' : 'hidden';
        slot.el.style.transform = `translate3d(${X}px, ${Y}px, 0)`;

        // Decaying quotes are already coming apart into scattered gold
        // letters, not a solid block of text any more, so they aren't
        // worth a stop label dodging -- only a fully "alive," genuinely
        // readable quote counts as an obstacle.
        if (on && slot.state === 'alive') {
          liveFragRects.push({ x: X, y: Y, w: bw, h: bh });
        }

        const fx = X + 140, fy = Y + 20;
        let near = false;
        if (on && hasPointer) near = Math.hypot(px - fx, py - fy) < 240;

        if (slot.state === 'alive') {
          slot.aloneTime += near ? -dt * 2.5 : dt;
          if (slot.aloneTime < 0) slot.aloneTime = 0;
          const opacity = (0.5 + (1 - slot.depth) * 0.15 + (near ? 0.3 : 0)) * (1 - slot.entryAmt * 0.85);
          slot.el.style.opacity = String(Math.min(0.92, opacity));

          if (slot.aloneTime >= DECAY_AFTER) {
            slot.state = 'decaying'; slot.decayT = 0;
            // Capture each letter's real on-screen position right now,
            // before any decay transform is applied -- the fall target
            // is the nerve's actual curve at THIS letter's x, not one
            // shared point for the whole fragment, so letters land
            // along the wire's shape rather than dropping to one spot.
            slot.chars.forEach((c, i) => {
              const r = c.getBoundingClientRect();
              slot.parts[i] = {
                vx: (Math.random() - 0.5) * 44,
                vy: 6 + Math.random() * 18,
                baseX: r.left + r.width / 2,
                baseY: r.top,
              };
            });
            slot.ref.style.transition = `opacity ${DECAY_TIME}s linear`;
            slot.ref.style.opacity = '0';
          }
        } else if (slot.state === 'decaying') {
          slot.decayT += dt;
          const prog = Math.min(1, slot.decayT / DECAY_TIME);
          slot.el.style.opacity = '1';
          slot.chars.forEach((c, i) => {
            const p = slot.parts[i];
            const targetY = chainYAt(p.baseX) - p.baseY;
            const x = p.vx * slot.decayT * 0.5;
            const y = p.vy * slot.decayT * 0.7 + targetY * Math.min(1, slot.decayT / 3.5);
            c.style.transform = `translate(${x}px, ${y}px) rotate(${p.vx * Math.min(1, prog * 1.3)}deg)`;
            c.style.opacity = String(Math.max(0, 1 - prog));
            // The letters turn gold as they come apart -- Eduardo's
            // "small gold particles" image, made literal.
            c.style.color = prog > 0.15 ? 'var(--gold)' : '';
          });
          if (slot.decayT >= DECAY_TIME) {
            slot.state = 'dead';
            slot.respawnDelay = 1 + Math.random() * 2.5;
          }
        } else {
          // dead -- waiting to respawn as a different fragment
          slot.el.style.opacity = '0';
          slot.respawnDelay -= dt;
          if (slot.respawnDelay <= 0) assignFragment(slot);
        }
      }
      // ---- stops ----
      for (const s of stopNodes) {
        const X = wrap(s.xn * WORLD_W - worldX, WORLD_W) - Math.min(520, W * 0.4);
        let y = chainYAt(X) + worldYoff * 0.02;
        const on = X > -200 && X < W + 200;
        s.el.style.visibility = on ? 'visible' : 'hidden';
        if (!on) continue;

        // A stop rides the nerve wherever the nerve happens to be, and
        // nothing kept that from landing exactly on a live quote's own
        // territory -- unlike a specimen (a photo can sit behind a short
        // word and both still read fine), two blocks of dense text on
        // the same pixels are simply unreadable, seen directly: a stop's
        // name rendered right through a quote's own line. A stop is one
        // short word, so nudging it perpendicular off the wire just far
        // enough to clear the quote is far cheaper than moving the
        // quote itself, and it still visibly rides the nerve -- just
        // ducking around something in its way, the way it already dips
        // for a specimen drifting past.
        const sw = s.el.offsetWidth || 90, sh = s.el.offsetHeight || 22;
        for (const r of liveFragRects) {
          const sy = y - 22;
          if (X < r.x + r.w && X + sw > r.x && sy < r.y + r.h && sy + sh > r.y) {
            const below = r.y + r.h + sh / 2 + 16;
            const above = r.y - sh / 2 - 16;
            y = Math.abs(below - y) < Math.abs(above - y) ? below : above;
            y = Math.max(nerveMin + 14, Math.min(nerveMax - 14, y));
            break;
          }
        }

        s.el.style.transform = `translate3d(${X}px, ${y - 22}px, 0)`;
        let near = 0;
        if (hasPointer) {
          const d = Math.hypot(px - X, py - y);
          near = d < 140 ? 1 : 0;
        }
        s.el.dataset.near = String(near);
      }

      requestAnimationFrame(frame);
    }

    resize();
    addEventListener('resize', resize);
    frame();
  }

  initField();
</script>
