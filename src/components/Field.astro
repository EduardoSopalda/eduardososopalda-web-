  function initField() {
    const root = document.getElementById('field-root');
    const world = document.getElementById('world');
    const canvas = document.getElementById('nerve') as HTMLCanvasElement | null;
    if (!root || !world || !canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    // Landing's own persistent chrome -- specifically the "Continue"
    // cue, which CLAUDE.md/direct feedback keeps visible (at reduced
    // opacity) even once docked, not just during the hero. Fragments
    // had zero awareness of it: nothing stopped a quote from spawning
    // or drifting right through it. Queried once here (its own layout
    // barely moves -- flex-end pinned within a 100svh section) and
    // refreshed each frame in frame() itself, same pattern as every
    // other collision rect below.
    const cueEl = document.getElementById('cue');

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Almost everything in the field -- specimens waking, fragments
    // holding their decay, the nerve bending -- is a hover mechanic.
    // A touch device has no hover, only contact, so on its own terms
    // the whole system would sit permanently in its dimmest, most
    // passive state: specimens never wake, fragments never get
    // "held." isTouch changes two things below: specimens wake on tap
    // instead of proximity, and fragments get a longer base lifespan
    // since touch users can't hover-protect one the way a mouse user
    // can.
    const isTouch = window.matchMedia('(hover: none) and (pointer: coarse)').matches;
    let W = 0, H = 0, DPR = Math.min(devicePixelRatio || 1, 2);
    let WORLD_W = 4200;
    let px = -9999, py = -9999, hasPointer = false, t = 0;
    let worldX = 0, targetX = 0, worldYoff = 0, dragY = 0;
    let drag = false, lastX = 0, lastY = 0;
    // Real elapsed time, not frame count -- frame() below used to run
    // dt as a hardcoded 1/60 regardless of how often the browser
    // actually called it, so on a 120Hz display (most current-gen
    // phones, ProMotion iPhones included) the whole field -- drift,
    // nerve springs, specimen lean/wake, flare cycles, how long a
    // fragment holds before decaying -- ran at up to double intended
    // speed, since requestAnimationFrame simply fires twice as often
    // there. Verified directly: simulating 120Hz vs 60Hz produced 27%
    // more real drift distance over the same 5 real seconds (worse for
    // anything with no smoothing, like the flare timers). The letter-
    // scatter decay physics (stepPhysFor below) already measured real
    // time via performance.now(); this brings the outer loop in line
    // with that same, already-proven pattern. Capped at 50ms per step
    // (20fps floor) so a lagged frame or a backgrounded-tab catch-up
    // frame doesn't jump everything forward in one leap -- rAF itself
    // already stops firing on a hidden tab in every real browser, so
    // this cap is what keeps that return frame from being read as
    // "50 seconds passed," which functionally satisfies FIELD-SPEC's
    // "pause the clock when backgrounded" without a separate listener.
    let lastFrameTime = 0;
    // Idle-drift tracking, per FIELD-SPEC's drift section: "always
    // moving even when untouched, faster after a period of no
    // interaction" -- the second half was never built at all. Updated
    // on any real pointer movement, drag, or wheel input; frame()
    // ramps drift speed up gradually the longer it's been.
    let lastActiveT = 0;
