    // itself swells and eases, not just the wave riding at a fixed
    // height), a spatial "warp" so the phase isn't perfectly even
    // across the width (an organic curve, not a uniform machine-sine),
    // and a mid-line that drifts with the same worldYoff the specimens
    // already move on -- so the nerve and the cabinet breathe together.
    // Every amplitude term below is a fraction of the CHANNEL's own
    // height, not of H directly -- that's what makes the wave big and
    // confident on a tall phone channel and safely smaller on a short
    // desktop one, from the same formula.
    function nerveBaseY(x: number): number {
      const u = x / Math.max(W, 1);
      const channel = nerveMax - nerveMin;
      const breath = 0.55 + 0.45 * Math.sin(t * 0.22);
      const mid = nerveMin + channel * 0.5 + Math.sin(t * 0.14) * channel * 0.05 + worldYoff * 0.06;
      const warp = u + 0.08 * Math.sin(u * Math.PI * 2 + t * 0.2);
      const amp = channel * (0.14 + 0.12 * breath);
      return (
        mid +
        Math.sin(warp * Math.PI * 1.05 + t * 0.48) * amp +
        Math.sin(warp * Math.PI * 2.1 + t * 0.27) * amp * 0.28 +
        Math.sin(u * Math.PI * 0.4 + t * 0.11) * channel * 0.035
      );
    }

    // springY is stored per discrete chain index, evenly spaced across
    // [-MARGIN, W+MARGIN] -- interpolating between the two nearest
    // indices gives a smooth value at any arbitrary x (specimens,
    // connectors, pulses, stops all query chainYAt at x's that don't
    // land on the grid).
    function springAt(x: number): number {
      const span = W + MARGIN * 2;
      const fi = ((x + MARGIN) / span) * (N - 1);
      const i0 = Math.max(0, Math.min(N - 1, Math.floor(fi)));
      const i1 = Math.min(N - 1, i0 + 1);
      const frac = fi - i0;
      return springY[i0] * (1 - frac) + springY[i1] * frac;
    }

    // Underdamped mass-spring per point (stiffness pulls back toward 0,
    // damping bleeds the energy off slower than critical, so a poke
    // genuinely overshoots and settles rather than snapping straight
    // back), each also coupled to its two immediate neighbours' current
    // offset -- a disturbance at one point visibly travels along the
    // chain before dying out, instead of every point reacting only to
    // its own isolated distance from the cursor.
    function stepSprings(dt: number) {
      if (reduced || dt <= 0) return;
      // RADIUS was 220 -- FIELD-SPEC: "bends toward the cursor within
      // about 360 pixels." Brought in line with the doc's own number.
      const STIFF = 90, DAMP = 7, COUPLE = 55, RADIUS = 360, PUSH = 4000;
      for (let i = 0; i < N; i++) {
        const x = chain[i].x;
        let force = 0;
        // No !isTouch guard here on purpose: a touch's own pointermove
        // events already carry real px/py (that's what drags the world
        // horizontally), so a finger on the glass bends the nerve the
        // same way a mouse does -- it only stops reacting once the
        // finger actually lifts (pointerleave-equivalent), not because
        // touch is excluded outright.
        if (hasPointer) {
          const baseY = nerveBaseY(x);
          const dist = Math.hypot(x - px, baseY - py);
          if (dist < RADIUS) {
            const f = (1 - dist / RADIUS) * PUSH;
            // Repulsion, not attraction: the wire is disturbed BY the
            // cursor (deforms away from it), rather than chasing the
            // cursor's position -- the actual behaviour asked for.
            force += py > baseY ? -f : f;
          }
        }
        const left = i > 0 ? springY[i - 1] : springY[i];
        const right = i < N - 1 ? springY[i + 1] : springY[i];
        force += COUPLE * ((left + right) * 0.5 - springY[i]);
        const accel = force - STIFF * springY[i] - DAMP * springV[i];
        springV[i] += accel * dt;
        springY[i] += springV[i] * dt;
      }
    }

    function chainYAt(x: number): number {
      const y = nerveBaseY(x) + springAt(x);
      // The corner mark, top bar, tagline, purpose line, and meta live
      // in Landing.astro's own stacking context, which paints above
      // this whole canvas regardless of the nerve's z-index -- that
      // only wins comparisons against other things inside Field.astro
      // (specimens, fragments, stops), not against a sibling section
      // entirely. Clamping keeps the curve's actual geometry out of
      // both text zones so it can't happen, rather than trying to
      // out-stack a separate section. nerveMin/nerveMax are the
      // measured channel above, recomputed regularly in frame().
      return Math.max(nerveMin, Math.min(nerveMax, y));
    }

    function stepChain(dt: number) {
      stepSprings(dt);
      // Base wave: a fresh, stateless sample of nerveBaseY(x) each
      // frame. The spring layer above is the only stateful part now.
      for (const p of chain) p.y = chainYAt(p.x);
    }

    const pulses = [
      { speed: 0.055, phase: 0.1 }, { speed: 0.08, phase: 0.62 }, { speed: 0.038, phase: 0.35 },
      { speed: 0.067, phase: 0.82 }, { speed: 0.046, phase: 0.5 },
    ];

    // ================= specimens =================
    // All ten specimens used to get a real src the instant the field
    // mounted -- 46MB total, fetched together on load regardless of
    // whether ROLE_BUDGET (below) would ever actually show more than
    // 3-4 of them at once. No <img>/<video> below carries a real src
    // or poster at creation; those are assigned lazily, the first time
    // a specimen is actually selected into `shown` for real (see the
    // `!n.mounted` check in the per-frame specimen loop), so a
    // specimen nobody's view ever surfaces never costs a byte.
    const specNodes = SPECIMENS.map((s, i) => {
      const el = document.createElement('div');
      el.className = 'spec';
      if (s.img) {
        el.innerHTML = `<img alt="" draggable="false" />`;
      } else if (s.vid) {
        // webkit-playsinline is the legacy (pre-iOS10) spelling of the
        // same thing playsinline already covers on current iOS -- kept
        // alongside it defensively, since these are exactly the videos
        // that were observed taking over the whole screen as a native
        // fullscreen player.
        el.innerHTML = `<video muted loop playsinline webkit-playsinline preload="none" draggable="false"></video>`;
      }
      if (s.tag) {
        const tag = document.createElement('span');
        tag.className = 'spec-tag';
        tag.textContent = s.tag;
        el.appendChild(tag);
        // Keyboard-focusable, per FIELD-SPEC ("every specimen and stop
        // is focusable"), but only for the specimens that carry a real
        // catalogue tag -- seaweed and eyefish have nothing behind them
        // beyond decorative atmosphere, and a tab stop announcing
        // nothing would be a worse outcome than not being one. role
        // "img" + the same string sighted users already read as the
        // .spec-tag caption gives a screen reader user the real thing,
        // not an invented label.
        el.tabIndex = 0;
        el.setAttribute('role', 'img');
        el.setAttribute('aria-label', s.tag);
      }
      // Belt-and-suspenders alongside pointer-events/touch-callout/
      // user-drag in the CSS (see .spec img/video's own comment) --
      // confirmed directly on a real phone recording that CSS alone
      // wasn't enough: a touch that drifted slightly while down (a
      // screen recording's own thumb movement) still triggered iOS's
      // native "lift and preview" share-sheet overlay on the image
      // underneath. Blocking the drag/context-menu events themselves,
      // not just their CSS-level affordances, closes that gap.
      el.addEventListener('dragstart', (e) => e.preventDefault());
      el.addEventListener('contextmenu', (e) => e.preventDefault());
      world!.appendChild(el);
      const video = el.querySelector('video') as HTMLVideoElement | null;
      if (video) {
        // Belt-and-suspenders alongside the CSS pointer-events:none on
        // .spec video (see that rule's own comment for the actual bug
        // this addresses) -- explicit JS properties rather than relying
        // on attribute parsing alone, per direct spec's exact list.
        video.controls = false;
        video.muted = true;
        video.loop = true;
        video.playsInline = true;
        video.setAttribute('playsinline', '');
        video.setAttribute('webkit-playsinline', '');
        video.disablePictureInPicture = true;
        video.disableRemotePlayback = true;
        // nofullscreen: browsers that do render a controls affordance
        // (some Android WebViews ignore `controls=false` entirely)
        // can't offer a fullscreen button in the first place.
        video.setAttribute('controlsList', 'nodownload nofullscreen noremoteplayback');
        video.playbackRate = 1;
      }
      el.style.zIndex = String(Math.round(s.d * 100));
      if (s.vignette) el.dataset.vignette = '1';
      if (s.cutout) el.dataset.cutout = '1';
      if (s.boost) el.style.setProperty('--boost', String(s.boost));
      const node = {
        el, s, video,
        xn: (i + 0.5) / SPECIMENS.length + (((i * 67) % 140) - 70) / 4200,
        awake: 0, playing: false,
        // Set true the first time this specimen is actually chosen
        // into `shown` -- the point its real src/poster get assigned
        // and its network fetch begins. See the lazy-mount block in
        // the per-frame specimen loop.
        mounted: false,
        // wasOn/fadeOutUntil: tracks the CSS fade-out grace window so
        // a specimen dropping out of ROLE_BUDGET stays a real collision
        // obstacle for as long as it's still visibly fading, not just
        // while it holds a budget slot. See the visuallyPresent note
        // in the per-frame specimen loop.
        wasOn: false,
        fadeOutUntil: 0,
        // Throttles retrying .play() on a video that's still paused --
        // was a fire-once flag (set to true right after calling .play(),
        // regardless of whether that promise resolved or rejected), so
        // a single failed/interrupted attempt (a large file still
        // buffering, a transient autoplay rejection, a pause/resume
        // cycle from the visibility budget) left the specimen frozen on
        // its poster frame forever -- nothing ever asked it to try
        // again. Found by actually inspecting a live page: two mp4
        // specimens sat at readyState 0, paused, indefinitely, despite
        // being on-screen and "shown" the whole time.
        nextPlayAttempt: 0,
        tapAwakeUntil: 0,
        leanX: 0, leanY: 0,
        // Independent per-specimen cycle, per the field spec: "Every
        // few seconds one flares unprompted... asking to be looked
        // at." This is the one piece of aliveness that doesn't depend
        // on anyone doing anything -- everything else in the field
        // reacts to the visitor; this one doesn't wait to be found.
        flareIn: 6 + Math.random() * 14,
        flareT: -1, // -1 = not currently flaring
        pulsePhase: Math.random() * Math.PI * 2,
        // Last frame's anchor X, used to derive real per-frame velocity
        // for the connector filament's lagging control point (see the
        // connector-drawing block in frame()) rather than assuming a
        // fixed drift direction.
        prevAnchorX: 0,
        // Fixed once, not re-rolled per frame -- this specimen's own
        // resting position within its band's offset range (see the
        // band offset table in frame()), so it has a stable "home" to
        // gently orbit rather than jittering to a new spot every tick.
        bandT: Math.random(),
      };
      if (isTouch) {
        el.style.pointerEvents = 'auto';
        el.addEventListener('click', () => { node.tapAwakeUntil = t + 4; });
      }
      // Keyboard parity for the same wake a touch tap already gets --
      // a sighted mouse user gets proximity for free, a keyboard user
      // has no cursor to be "near" with, so focusing the specimen is
      // its equivalent of arriving at it. Only ever added on tagged
      // specimens, which are the only ones tabIndex was set on above.
      if (s.tag) {
        el.addEventListener('focus', () => { node.tapAwakeUntil = t + 4; });
      }
      return node;
    });

    // ================= fragments: sillas, no feed =================
    // "Hay 4 sillas. El resto espera en el corpus." -- four physical
    // chairs, an infinite pool of 50 behind them. When one decays and
    // dies, that chair (after a pause) picks the next fragment from a
    // shuffled queue and arrives fresh: from a random edge (left/right/
    // top/bottom), never just sliding in with the horizontal drift like
    // everything else. Depth is shared with specimens for z-index, so
    // fragments genuinely interleave in front of and behind them rather
    // than always sitting on top.
    // Fewer chairs on narrow screens: 4 quote blocks (each up to
    // several lines tall) simply don't fit in the compressed vertical
    // range a short mobile viewport leaves -- window.innerWidth here,
    // not the closure W, since W isn't set until the first resize()
    // call, which happens after this. Direct spec's own cupo table is
    // explicit: mobile gets exactly 2 chairs (had been bumped to 3 to
    // fight empty stretches, but "no improvises... el cupo" -- back to
    // 2. That earlier emptiness problem is addressed instead by the
    // offscreenTime mechanism below (a chair that drifts out of view
    // respawns within ~3.5s instead of waiting out its whole lifespan
    // unseen), not by adding a chair the spec doesn't call for.
    const SLOT_COUNT = window.innerWidth < 500 ? 2 : 4;
    type Dir = 'left' | 'right' | 'top' | 'bottom';
    const DIRS: Dir[] = ['left', 'right', 'top', 'bottom'];

    // Field's own card only mounts fragments with a real article behind
    // them -- "Sin source, esa frase no se monta." The one sourceless
    // "site" line (Landing's own manifesto pool) stays exclusive to
    // Landing, which never shows a ficha anyway.
    const FIELD_FRAGS = FRAGS.filter((f) => f.source !== null);

    let fragQueue: number[] = [];
    function shuffledIndices(n: number) {
      const arr = Array.from({ length: n }, (_, i) => i);
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }
    // Tries a few draws for one whose source doesn't match a currently
    // alive/decaying neighbour's -- "Nunca dos extractos del mismo
    // artículo vecinos." Falls back to whatever's next once the queue
    // has no untried alternative left, rather than stalling.
    // avoidWeight: "no dos tramas del mismo peso seguidas (frase+frase)"
    // -- two short-weight (or two long-weight) quotes showing at once
    // read as the same weft repeating. Tried first alongside the
    // existing same-source exclusion; falls back to just source-clean,
    // then to whatever's next, rather than ever stalling.
    function nextFragIndex(excludeSources: Set<string | null>, avoidWeight: 'short' | 'long' | null): number {
      if (fragQueue.length === 0) fragQueue = shuffledIndices(FIELD_FRAGS.length);
      for (let attempt = 0; attempt < fragQueue.length; attempt++) {
        const i = fragQueue.length - 1 - attempt;
        const cand = FIELD_FRAGS[fragQueue[i]];
        if (!excludeSources.has(cand.source) && cand.weight !== avoidWeight) {
          const idx = fragQueue[i];
          fragQueue.splice(i, 1);
          return idx;
        }
      }
      for (let attempt = 0; attempt < fragQueue.length; attempt++) {
        const i = fragQueue.length - 1 - attempt;
        if (!excludeSources.has(FIELD_FRAGS[fragQueue[i]].source)) {
          const idx = fragQueue[i];
          fragQueue.splice(i, 1);
          return idx;
        }
      }
      return fragQueue.pop()!;
    }

    // Same four-mode Verlet death as Landing.astro's own hero quote
    // (setLine/decay/stepPhys), ported directly rather than reinvented
    // -- "Porta setLine / decay / stepPhys para las sillas del field
    // (misma física)." Each chair cycles its own DEATHS rotation
    // independently, since up to four can be alive/decaying at once
    // here (Landing only ever has one).
    const DEATHS = ['float', 'fall', 'explode', 'corrode'] as const;
    type DeathMode = (typeof DEATHS)[number] | '';
    type Particle = {
      el: HTMLElement; x: number; y: number; px: number; py: number;
      rot: number; rotv: number; damp: number; life: number; fade: number;
      wake: number; scale: number; link: boolean; rest: number; breakAt: number;
    };

    const fragSlots = Array.from({ length: SLOT_COUNT }, (_, slotI) => {
      const el = document.createElement('div');
      el.className = 'frag-slot';
      el.dataset.slot = String(slotI);
      const quote = document.createElement('p');
      quote.className = 'frag-quote';
      const ref = document.createElement('p');
      ref.className = 'frag-ref';
      el.appendChild(quote);
      el.appendChild(ref);
      world!.appendChild(el);

      return {
        el, quote, ref, slotI,
        chars: [] as HTMLElement[],
        fragIndex: -1,
        depth: 0.5,
        xn: 0, y: 0.5,
        // Which of the 3 horizontal thirds (see zoneRotation below) this
        // slot's current fragment spawned into -- -1 before the first
        // ever assignment. Read by assignFragment itself to steer new
        // spawns away from zones a live sibling already occupies.
        zoneIdx: -1,
        entryDir: 'left' as Dir,
        entryAmt: 0, // 1 = fully off-screen at entry point, eases to 0
        aloneTime: 0,
        // Real value rolled per fragment in assignFragment (desktop
        // ~35-56s, touch ~58-82s, per FIELD-SPEC's "about forty
        // seconds alone") -- never actually read at this placeholder
        // value, since state starts 'pending' and assignFragment runs
        // before any decay check does.
        decayAfter: 30,
        // Real value rolled per fragment in assignFragment -- about 1
        // in 5 spawns is immune to the natural timeout entirely.
        persistent: false,
        state: 'pending' as 'pending' | 'alive' | 'decaying' | 'dead',
        pendingT: slotI * 3 + Math.random() * 3, // staggered first appearance
        decayT: 0,
        respawnDelay: 0,
        // How long this chair's current quote has sat overlapping a
        // visible specimen's bounding box -- "el texto espera o se
        // va" -- accumulated so a one-frame graze doesn't trigger it.
        collideTime: 0,
        // Vertical nudge, eased in and out, that pushes this slot's
        // quote away from whatever it's currently overlapping -- "el
        // texto espera o se va" was only ever built as "waits, then
        // leaves" (collideTime -> forced decay), with no attempt to
        // actually get out of the way first. Measured directly: with
        // 4 fragment chairs and up to 4 specimens sharing one channel,
        // that meant collision-forced decay firing on effectively every
        // fragment, 2-25s after spawn, none of the natural ~40s alone
        // timeouts FIELD-SPEC calls for ever getting a chance to run.
        // See the dodge logic in frame() for how this is set.
        dodgeY: 0,
        // How long this chair has sat off-screen while still "alive".
        // assignFragment spawns a fragment ON-screen on purpose, but
        // the drifting world is much wider than the viewport (WORLD_W
        // vs. W), so a quote that isn't actively held drifts back OUT
        // of view within a few seconds -- and decayAfter (20-45s) is
        // long enough that it would otherwise then sit invisible for
        // most of its remaining life before finally respawning
        // somewhere visible again. Measured directly: with only
        // SLOT_COUNT chairs, that left the screen completely empty of
        // text most of the time -- "that's not a gap, that's pure
        // emptiness." Forcing an early respawn once a chair has been
        // off-screen for a few seconds keeps a chair from burning its
        // whole lifespan somewhere nobody can see it.
        offscreenTime: 0,
        // Verlet death state -- see DEATHS above.
        deathI: 0,
        phys: [] as Particle[],
        physMode: '' as DeathMode,
        physT: 0,
        physRunning: false,
        physLast: 0,
      };
    });

    function assignFragment(slot: typeof fragSlots[number]) {
      const liveSiblings = fragSlots.filter((s) => s !== slot && (s.state === 'alive' || s.state === 'decaying'));
      const neighborSources = new Set(liveSiblings.map((s) => FIELD_FRAGS[s.fragIndex]?.source ?? null));
      // Weave rule: avoid whichever weight is currently the majority
      // among live siblings, so a respawning chair tends to alternate
      // short/long rather than piling onto whatever's already showing.
      const shortCount = liveSiblings.filter((s) => FIELD_FRAGS[s.fragIndex]?.weight === 'short').length;
      const longCount = liveSiblings.length - shortCount;
      const avoidWeight = liveSiblings.length === 0 ? null : shortCount > longCount ? 'short' : longCount > shortCount ? 'long' : null;
      const idx = nextFragIndex(neighborSources, avoidWeight);
      const f = FIELD_FRAGS[idx];
      slot.fragIndex = idx;
      slot.deathI = 0;
      slot.physRunning = false;
      slot.phys = [];
      // The one Spanish line in the set ("No se puede empezar...")
      // was inheriting the page's lang="en" like every other fragment
      // -- wrong for assistive tech and translate tooling reading the
      // page, per the design critique's craft checklist.
      slot.quote.lang = f.lang || 'en';
      slot.quote.innerHTML = '';
      slot.quote.style.fontSize = '';
      // Ported literally from Landing's own setLine() -- same markup
      // (span.word > b, one b per letter, a real text-node space
      // between words), same birth reveal. A bare space as a lone
      // inline-block's content used to collapse to zero width, which
      // is what the old per-letter <i> version worked around with a
      // literal non-breaking space; a plain text node between the word
      // spans doesn't have that problem at all, so there is nothing to
      // work around here.
      slot.chars = [];
      f.text.split(/(\s+)/).forEach((tok) => {
        if (/^\s+$/.test(tok)) {
          slot.quote.appendChild(document.createTextNode(' '));
          return;
        }
        const word = document.createElement('span');
        word.className = 'word';
        [...tok].forEach((ch) => {
          const b = document.createElement('b');
          b.textContent = ch;
          b.style.opacity = '0';
          word.appendChild(b);
          slot.chars.push(b);
        });
        slot.quote.appendChild(word);
      });
      slot.chars.forEach((b, i) => {
        const anim = b.animate(
          [
            { opacity: 0, transform: 'translateY(10px)', filter: 'blur(8px)' },
            { opacity: 1, transform: 'none', filter: 'blur(0)' },
          ],
          {
            duration: reduced ? 1 : 2200,
            delay: reduced ? 0 : 120 + i * 80,
            easing: 'cubic-bezier(.22,.7,.2,1)',
            fill: 'forwards',
          }
        );
        // Same fix as Landing's own animateLetters, never ported over
        // when this was built -- fill:'forwards' holds the animation's
        // own visual result at opacity 1 without ever touching
        // b.style.opacity, which stays at the literal '0' set above.
        // The decay below cancels this animation to hand the letter to
        // the physics engine; cancelling reverts to that stale
        // underlying '0', not to what was on screen, so every letter
        // flashed fully invisible for one frame and then flashed back
        // (physics starts at life:1) before actually starting to fade
        // -- confirmed directly, the same "appears, vanishes, comes
        // back, then decays" glitch Landing's quote and wordmark had.
        // Keeping the real inline opacity in sync once the animation
        // finishes means cancelling it later is a no-op visually.
        anim.onfinish = () => { b.style.opacity = '1'; };
      });

      // Ficha (citation card) reveals a beat after the quote itself,
      // not simultaneously -- per direct spec, the source is metadata
      // read second, not a label glued to the quote's own entrance.
      // Bails if this slot has already moved on to a different
      // fragment by the time the timeout fires (a fast decay-and-
      // respawn cycle on a short-lived slot).
      slot.ref.style.transition = '';
      slot.ref.style.opacity = '0';
      slot.ref.innerHTML = '';
      slot.ref.style.display = f.source ? '' : 'none';
      if (f.source) {
        const revealIdx = idx;
        // Short reference form (No.NN \u00b7 year) instead of the full
        // article title -- per direct feedback, "short and sweet."
        // No.NN is ARTICLE_CATALOG's real, stable chronological
        // catalogue number (derived from content/_index.json's own
        // date field, oldest = No.01), not invented. Falls back to
        // the full title for the rare case of a source not yet in
        // the catalogue (a newly added fragment before its article's
        // number is regenerated) rather than showing nothing.
        const catalogNo = ARTICLE_CATALOG[f.source];
        const label = catalogNo ? `No.${String(catalogNo).padStart(2, '0')}` : f.source;
        const cite = f.year ? `${label} \u00b7 ${f.year}` : label;
        // docs/BRIEF.md's own definition of a fragment: "linking back
        // to the paragraph it came from." This is the article-level
        // version of that -- real, not a dead end, though not yet
        // anchored to the exact paragraph within it. slugForTitle
        // resolves against the real content collection (see
        // articleIndex.ts), not a guess.
        const slug = slugForTitle(f.source);
        setTimeout(() => {
          if (slot.fragIndex !== revealIdx) return;
          slot.ref.innerHTML = '';
          if (slug) {
            const a = document.createElement('a');
            a.href = `/writing/${slug}`;
            a.textContent = cite;
            slot.ref.appendChild(a);
          } else {
            slot.ref.appendChild(document.createTextNode(cite));
          }
          slot.ref.style.transition = 'opacity 0.6s ease';
          slot.ref.style.opacity = '1';
        }, 400 + Math.random() * 400);
      }

      slot.depth = f.weight === 'long' ? 0.6 + Math.random() * 0.22 : 0.3 + Math.random() * 0.3;

      // Spawn where it can actually be seen: solve for the xn that puts
      // it inside the current viewport right now, rather than a random
      // point across the whole ~4000px world (which, at a handful of
      // slots vs. a world wider than the screen, would spawn most
      // fragments somewhere nobody will ever scroll to before they
      // decay unseen).
      const depthFactor = 0.3 + slot.depth * 0.7;

      // Divided into three equal horizontal thirds of the channel
      // itself (nerveMin..nerveMax -- already the safe vertical range,
      // clear of the mark/meta/stops, see computeNerveChannel), and
      // assigned by strict round-robin, one third per spawn in
      // rotation -- direct feedback: "if we divide the screen in 3
      // horizontal sections, most of phrases pop up in the middle
      // section... we need math to coordinate their release." The
      // previous system tied Y to weight instead (short always rode
      // tight to the nerve's own local wave -- which spends most of
      // its time roughly central -- long always sat in a lower band,
      // alta never used at all), so the ~62% of fragments that are
      // "short" all clustered near the nerve's generally-central path
      // while a whole third of the screen never got anything. Weight
      // no longer decides vertical placement at all; the rotation
      // does, so coverage across all three zones is guaranteed over
      // time by construction rather than left to chance.
      const isLong = f.weight === 'long';
      const channel = Math.max(1, nerveMax - nerveMin);
      zoneRotation = (zoneRotation + 1) % 3;
      // Prefer a third no live sibling currently occupies over the
      // blind round-robin's own next value. With up to 4 chairs sharing
      // only 3 zones, plain rotation guarantees two land in the same
      // third whenever all 4 are alive at once -- confirmed directly as
      // a real cause of fragments overlapping each other: a 75s
      // real-time trace where every single decay observed was
      // collision-forced (2-25s after spawn), not one natural ~40s
      // timeout, because the channel stayed crowded enough that some
      // overlap was close to constant. Trying the next free third first
      // still keeps the round-robin's own long-run coverage guarantee
      // (zoneRotation itself keeps advancing every spawn regardless of
      // which zone actually gets used this time), it just stops handing
      // out a zone that's already taken when an empty one exists.
      const usedZones = new Set(liveSiblings.map((s) => s.zoneIdx).filter((z) => z >= 0));
      let zone = zoneRotation;
      for (let tries = 0; tries < 3 && usedZones.has(zone); tries++) zone = (zone + 1) % 3;
      slot.zoneIdx = zone;
      const thirdH = channel / 3;
      const zoneLo = nerveMin + zone * thirdH;
      // Inset from the third's own edges so a fragment doesn't spawn
      // flush against the seam between two zones.
      const inset = thirdH * 0.18;
      let candidateY = zoneLo + inset + Math.random() * Math.max(1, thirdH - inset * 2);
      slot.y = candidateY / H;

      // Retried against both other specimens' AND sibling fragments'
      // actual current on-screen rects -- specimens keep drifting
      // independently after a fragment spawns so this can't be fully
      // solved, but avoids spawning directly into a collision at least.
      // Bounding boxes are estimated (real layout isn't known until
      // this slot is positioned in the frame loop) -- generous enough
      // that a near-miss still counts as a hit.
      function collidesAt(x: number, y: number) {
        // A generous but real estimate -- bh was 90, a wild
        // underestimate once a quote wraps to 3-4 lines plus its own
        // ref card underneath (measured directly: easily 150-220px real
        // height). bw matches the CSS cap itself (min(24em, 62vw))
        // rather than a flat desktop-sized guess, which on a 390px
        // phone (62vw=242px) was ~40% too wide -- retrying X can only
        // resolve a collision if there's actual room to move INTO, and
        // an oversized box left none.
        const bw = Math.min(384, W * 0.62) + 20, bh = 160, pad = 24;
        for (const n of specNodes) {
          const r = n.el.getBoundingClientRect();
          if (r.width < 10) continue;
          if (x < r.right + pad && x + bw > r.left - pad && y < r.bottom + pad && y + bh > r.top - pad) return true;
        }
        for (const s of fragSlots) {
          if (s === slot || s.state === 'pending' || s.state === 'dead') continue;
          const r = s.el.getBoundingClientRect();
          if (r.width < 10) continue;
          if (x < r.right + pad && x + bw > r.left - pad && y < r.bottom + pad && y + bh > r.top - pad) return true;
        }
        if (cueEl) {
          const r = cueEl.getBoundingClientRect();
          if (r.width >= 10 && x < r.right + pad && x + bw > r.left - pad && y < r.bottom + pad && y + bh > r.top - pad) return true;
        }
        return false;
      }
      // Leaves room on the right for the quote block's own width (up to
      // 24em) so it doesn't spawn overflowing off the viewport edge --
      // the first version placed it anywhere up to 0.84W and clipped.
      let targetScreenX = W * 0.06 + Math.random() * W * 0.5;
      for (let attempt = 0; attempt < 10 && collidesAt(targetScreenX, candidateY); attempt++) {
        targetScreenX = W * 0.06 + Math.random() * W * 0.5;
        // First few attempts only move sideways -- but a wide dominant
        // specimen can block the ENTIRE horizontal band at one Y, which
        // no amount of X-only retrying can ever escape. Confirmed
        // directly: fragments were re-colliding and re-decaying in a
        // tight loop because every retry kept landing back on the same
        // blocked band. From here on, also re-roll Y within the SAME
        // zone third (not a different one -- the round-robin coverage
        // this zone assignment exists for still holds), giving a
        // genuine way out.
        if (attempt >= 4) {
          candidateY = zoneLo + inset + Math.random() * Math.max(1, thirdH - inset * 2);
          slot.y = candidateY / H;
        }
      }
      const offset = Math.min(520, W * 0.4);
      slot.xn = wrap(targetScreenX + offset + worldX * depthFactor, WORLD_W) / WORLD_W;
      slot.entryDir = DIRS[Math.floor(Math.random() * DIRS.length)];
      slot.entryAmt = 1;
      slot.aloneTime = 0;
      slot.collideTime = 0;
      // Touch users can't rest a cursor near a fragment to hold it the
      // way a mouse user can, so they'd otherwise lose every fragment to
      // decay regardless of attention. Longer base life, not proximity,
      // is the touch equivalent -- unconditional rather than earned.
      // Punchy short fragments hold a little longer than long ones, per
      // direct spec ("las cortas y contundentes aguantan mas").
      // Desktop long was 20-30s -- FIELD-SPEC says "alone, a fragment
      // has about forty seconds," and 20-30 undershoots that by a
      // third to a half. Re-centered desktop long on 40s exactly (the
      // doc's own flat number, used as the baseline case) and moved
      // short and both touch values up by roughly the same amount,
      // keeping the two relative differences above (short > long,
      // touch > pointer) fully intact rather than flattening them out.
      slot.decayAfter = isTouch
        ? (isLong ? 58 : 66) + Math.random() * (isLong ? 14 : 16)
        : (isLong ? 35 : 42) + Math.random() * (isLong ? 10 : 14);
      // Direct feedback: "they don't all have to death, some can
      // survive." About one in five spawns is immune to the natural
      // aloneTime timeout entirely (decayAfter effectively infinite);
      // collision-forced decay still applies as a safety valve, so a
      // persistent fragment can't literally block something forever --
      // it just never runs out the clock on its own the way the other
      // four in five do.
      slot.persistent = Math.random() < 0.2;
      if (slot.persistent) slot.decayAfter = Infinity;
      slot.state = 'alive';
      // Floor of 150 -- specimens top out at z-index 100 (Math.round(s.d
      // * 100), d never exceeds 1.0), and the nerve canvas sits at 250.
      // Direct spec: ".frag-slot z-index > .spec, < nervio" -- this
      // range (150-191, still varying with depth for stacking among
      // fragments themselves) guarantees a fragment always draws above
      // every specimen and below the wire, not just usually.
      slot.el.style.zIndex = String(150 + Math.round(slot.depth * 50));
    }

    // Death color, per direct spec: "#8f4e2c -> #2a160e. Nunca gold,
    // nunca gris." Gold is reserved for the nerve/tags/cue -- never the
    // decaying letters (an earlier pass here used var(--gold) for
    // exactly that, "small gold particles," which the new spec
    // explicitly rules out: gold never touches a fragment's body).
    // Interpolated by decay progress (0..1) rather than a hard switch.
    function deathColor(progress: number): string {
      const p = Math.max(0, Math.min(1, progress));
      const r = Math.round(0x8f + (0x2a - 0x8f) * p);
      const g = Math.round(0x4e + (0x16 - 0x4e) * p);
      const b = Math.round(0x2c + (0x0e - 0x2c) * p);
      return `rgb(${r}, ${g}, ${b})`;
    }

    // Per-chair Verlet integrator -- identical formulas to Landing's own
    // stepPhys, operating on this slot's own phys/physMode/physT instead
    // of module-level singletons, since up to SLOT_COUNT chairs can be
    // mid-decay at once here (Landing only ever has one).
    function stepPhysFor(slot: typeof fragSlots[number], now: number) {
      if (!slot.physRunning) return;
      const dt = Math.min(0.032, (now - slot.physLast) / 1000) || 0.016;
      slot.physLast = now;
      slot.physT += dt;
      const wind = Math.sin(slot.physT * 0.7) * 22;
      const mode = slot.physMode;

      if (mode === 'corrode') {
        slot.phys.forEach((p) => {
          if (p.link && slot.physT > p.breakAt) p.link = false;
        });
        for (let k = 0; k < 4; k++) {
          for (let i = 0; i < slot.phys.length - 1; i++) {
            const p = slot.phys[i], q = slot.phys[i + 1];
            if (!p.link) continue;
            const dx = q.x - p.x, dy = q.y - p.y;
            const d = Math.hypot(dx, dy) || 1;
            const corr = (d - p.rest) * 0.18;
            const nx = dx / d, ny = dy / d;
            p.x += nx * corr * 0.5; p.y += ny * corr * 0.5;
            q.x -= nx * corr * 0.5; q.y -= ny * corr * 0.5;
          }
        }
      }

      let allSettled = true;
      slot.phys.forEach((p) => {
        if (slot.physT < p.wake) { allSettled = false; return; }
        let ax = 0, ay = 0;
        if (mode === 'fall') ay = 380;
        if (mode === 'float') { ay = -28; ax = wind * 0.7; }
        if (mode === 'explode') ay = 12;
        if (mode === 'corrode') ay = 12;

        const vx = p.x - p.px, vy = p.y - p.py;
        const nx = p.x + vx * p.damp + ax * dt * dt;
        const ny = p.y + vy * p.damp + ay * dt * dt;
        p.px = p.x; p.py = p.y;
        p.x = nx; p.y = ny;
        p.rot += p.rotv * dt * 60;
        p.life -= p.fade * dt * 60;
        if (mode === 'explode') p.scale = 1 + Math.min(0.55, slot.physT * 0.35);
        p.el.style.transform = `translate(${p.x}px, ${p.y}px) rotate(${p.rot}deg) scale(${p.scale || 1})`;
        p.el.style.opacity = String(Math.max(0, p.life));
        const progress = 1 - Math.max(0, Math.min(1, p.life));
        if (mode === 'corrode') {
          const rust = Math.min(1, slot.physT / 7);
          p.el.style.filter = `blur(${rust * 4.5}px)`;
          p.el.style.color = rust > 0.1 ? deathColor(rust) : '';
        } else if (progress > 0.04) {
          p.el.style.color = deathColor(progress);
        }
        if (p.life > 0) allSettled = false;
      });
      if (allSettled) {
        slot.physRunning = false;
        slot.state = 'dead';
        slot.respawnDelay = 1 + Math.random() * 2.5;
      }
    }

    // ================= stops =================
    // Real anchors now, not <div>s with a no-op click handler -- per
    // direct review finding, the old divs were formally invisible to
    // every screen reader (no role, no href to announce) and
    // unreachable by keyboard (no tabindex, no href to put them in the
    // native tab order at all). An <a href> with position:absolute and
    // a transform does everything the div did, plus it's a real link:
    // natively focusable and in tab order without an explicit
    // tabindex, right-click-copyable, crawlable, and it'll simply start
    // working the moment a real room exists at that route -- nothing
    // else in this file needs to change when that happens.
    const stopNodes = STOPS.map((s, i) => {
      const el = document.createElement('a');
      el.className = 'stop';
      el.href = s[2];
      el.textContent = s[0];
      world!.appendChild(el);
      el.style.zIndex = '200'; // navigation always reads above specimens/fragments
      el.addEventListener('click', () => {
        el.dataset.justClicked = '1';
        setTimeout(() => delete el.dataset.justClicked, 400);
      });
      return { el, name: s[0], xn: (i + 0.5) / STOPS.length, near: 0, nearAmt: 0 };
    });

    // Per-fragment decay timing (decayAfter) and touch-vs-pointer base
    // life now live on each slot itself, rolled fresh in assignFragment
    // -- see the comment there.

    let channelT = 0;
    function frame() {
      const now = performance.now();
      const dt = reduced ? 0 : Math.min(0.05, lastFrameTime ? (now - lastFrameTime) / 1000 : 1 / 60);
      lastFrameTime = now;
      t += dt;
      // Read once per frame, reused everywhere below that needs to know
      // whether the field is actually the thing on screen right now --
      // #world's own opacity is already keyed off this same condition
      // (see body[data-landing='field'] .world in this file's style
      // block), but opacity alone doesn't remove an element from
      // keyboard Tab order or hit-testing, only from paint. Specimens,
      // fragment citation links, and stops all set their own real
      // tabIndex/visibility off this same value now, not just off
      // whether they're geometrically on-screen.
      const docked = document.body.dataset.landing === 'field';
      // Read once per frame, reused by both the specimen-tag-style
      // spawn check and the runtime forced-decay check below -- same
      // rect either way, no reason to force the layout read twice.
      const cueRect = cueEl ? cueEl.getBoundingClientRect() : null;

      // Both constants below are the exact same tuned feel as before
      // (0.34px added per assumed-60fps frame, 0.06 convergence per
      // assumed-60fps frame) restated as real-time rates: 0.34*60 =
      // 20.4px/s of drift, and the standard frame-rate-independent
      // form of an exponential approach (1 - retainedFraction^(dt*60))
      // for worldX chasing targetX, so both now cover the same real
      // ground per real second regardless of display refresh rate.
      const DRIFT_PER_SEC = 20.4;
      // FIELD-SPEC: drift is "always moving even when untouched,
      // faster after a period of no interaction" -- the second half
      // was never implemented. Ramps from 1x to 1.7x starting 8s after
      // the last real pointer/drag/wheel input, reaching full speed by
      // 20s idle; modest and gradual on purpose, not a jump, since a
      // sudden speed change would read as a glitch, not a mood.
      const idleFor = t - lastActiveT;
      const idleMul = 1 + Math.min(0.7, (Math.max(0, idleFor - 8) / 12) * 0.7);
      if (!drag) targetX += reduced ? 0 : DRIFT_PER_SEC * idleMul * dt;
      worldX += (targetX - worldX) * approachFactor(0.06, dt);
      worldYoff = dragY + (reduced ? 0 : Math.sin(t * 0.0817) * H * 0.16);

      // Every ~20 frames (~3/sec), not every frame -- getBoundingClientRect
      // forces a layout read, and the channel only needs to track real
      // changes (the hero->field transition moving everything, a new
      // quote fragment changing height), not react within one frame of
      // them. Catches both without a resize or attribute-change listener.
      channelT += 1;
      if (channelT > 20) { channelT = 0; computeNerveChannel(); }

      // Ease the rendered channel toward whatever's actually been
      // measured, once there's something real to ease toward -- see
      // the entrance-pose comment above computeNerveChannel. Slow on
      // purpose: this is the nerve's own arrival, not a value snapping
      // into place. Landing.astro waits for the 'nerve-settled' event
      // this dispatches once, so the name and quote don't start fading
      // in until the nerve has actually finished arriving.
      if (haveRealChannel) {
        if (!entranceSettled) {
          if (reduced) {
            nerveMin = realNerveMin;
            nerveMax = realNerveMax;
            entranceSettled = true;
            dispatchEvent(new Event('nerve-settled'));
          } else {
            if (entranceStartT < 0) {
              entranceStartT = now;
              entranceFromMin = nerveMin;
              entranceFromMax = nerveMax;
            }
            const p = Math.min(1, (now - entranceStartT) / ENTRANCE_MS);
            // Cosine ease-in-out: 0 at p=0, 1 at p=1, slope zero at
            // both ends -- gentle start, faster through the middle,
            // gentle finish. Same shape --ease-slow describes,
            // expressed as a number instead of a CSS timing function
            // since this drives a canvas value, not a transitionable
            // style property.
            const eased = 0.5 - 0.5 * Math.cos(p * Math.PI);
            nerveMin = entranceFromMin + (realNerveMin - entranceFromMin) * eased;
            nerveMax = entranceFromMax + (realNerveMax - entranceFromMax) * eased;
            if (p >= 1) {
              entranceSettled = true;
              dispatchEvent(new Event('nerve-settled'));
            }
          }
        } else {
          // The entrance already happened once -- this is an ordinary
          // later adjustment (a resize, a taller or shorter quote
          // changing the available channel), not a first arrival, so a
          // plain continuous chase is the right amount of motion, not
          // another multi-second ease.
          nerveMin += (realNerveMin - nerveMin) * approachFactor(0.06, dt);
          nerveMax += (realNerveMax - nerveMax) * approachFactor(0.06, dt);
        }
      }

      stepChain(dt);
      ctx!.clearRect(0, 0, W, H);

      function strokePath() {
        ctx!.beginPath();
        ctx!.moveTo(chain[0].x, chain[0].y);
        for (let i = 1; i < chain.length - 1; i++) {
          const midX = (chain[i].x + chain[i + 1].x) / 2;
          const midY = (chain[i].y + chain[i + 1].y) / 2;
          ctx!.quadraticCurveTo(chain[i].x, chain[i].y, midX, midY);
        }
        const last = chain[chain.length - 1];
        ctx!.lineTo(last.x, last.y);
      }

      ctx!.shadowColor = 'rgba(247, 197, 106, 0.5)';
      ctx!.shadowBlur = 10;
      strokePath();
      ctx!.strokeStyle = 'rgba(198, 145, 68, 0.4)';
      ctx!.lineWidth = 3;
      ctx!.stroke();

      ctx!.shadowBlur = 4;
      strokePath();
      ctx!.strokeStyle = 'rgba(247, 197, 106, 0.9)';
      ctx!.lineWidth = 1;
      ctx!.stroke();

      // Electricity, not just moving dots: each pulse is a short comet
      // trailing gold along the actual curve (sampled via chainYAt, so
      // the trail bends with the wire itself), fading tail-to-head
      // through a gradient rather than one flat colour.
      // Near-white, not gold -- the base line is already a warm gold at
      // 0.9 alpha, so a same-hue pulse barely reads against it. Contrast
      // (white-hot core against warm wire), not just motion, is what
      // makes this look like electricity running through the line
      // rather than a slightly-brighter bead sliding along it.
      ctx!.shadowBlur = 14;
      ctx!.shadowColor = 'rgba(255, 255, 235, 1)';
      const TRAIL = 130, STEPS = 16;
      for (const p of pulses) {
        const u = (t * p.speed + p.phase) % 1;
        const headX = u * W;
        const edge = Math.min(u, 1 - u);
        const o = Math.min(1, edge * 9);
        if (o <= 0.01) continue;
        ctx!.beginPath();
        for (let k = STEPS; k >= 0; k--) {
          const x = headX - (k / STEPS) * TRAIL;
          const y = chainYAt(x);
          if (k === STEPS) ctx!.moveTo(x, y); else ctx!.lineTo(x, y);
        }
        const grad = ctx!.createLinearGradient(headX - TRAIL, chainYAt(headX - TRAIL), headX, chainYAt(headX));
        grad.addColorStop(0, 'rgba(255, 255, 240, 0)');
        grad.addColorStop(0.6, `rgba(255, 250, 220, ${o * 0.5})`);
        grad.addColorStop(1, `rgba(255, 255, 245, ${o})`);
        ctx!.strokeStyle = grad;
        ctx!.lineWidth = 3.4;
        ctx!.stroke();
        ctx!.beginPath();
        ctx!.arc(headX, chainYAt(headX), 3.4, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(255, 255, 250, ${o})`;
        ctx!.fill();
      }
      ctx!.shadowBlur = 0;

      // ---- the point of light: the cursor itself, replaced. Drawn at
      // the same px/py already tracked for bending the nerve, so the
      // one glow the visitor moves IS the thing moving the wire.
      // Touch included, same reasoning as stepSprings above -- the
      // glow marks wherever the nerve is actually bending toward. ----
      if (hasPointer) {
        const glow = ctx!.createRadialGradient(px, py, 0, px, py, 16);
        glow.addColorStop(0, 'rgba(255, 244, 214, 0.95)');
        glow.addColorStop(0.4, 'rgba(247, 197, 106, 0.45)');
        glow.addColorStop(1, 'rgba(247, 197, 106, 0)');
        ctx!.fillStyle = glow;
        ctx!.beginPath();
        ctx!.arc(px, py, 16, 0, Math.PI * 2);
        ctx!.fill();
        ctx!.beginPath();
        ctx!.arc(px, py, 2, 0, Math.PI * 2);
        ctx!.fillStyle = 'rgba(255, 250, 235, 0.95)';
        ctx!.fill();
      }

      // ---- specimens: per-role cupo (see ROLE_BUDGET below), band-anchored to the nerve, wake near cursor ----
      const flareLines: { x: number; y1: number; y2: number; o: number }[] = [];
      // Always-on connector filaments -- one per visible specimen, not
      // just the ones currently flaring (flareLines above stays a
      // separate, brighter overlay for that moment). Per direct
      // feedback: a straight canvas line read as rigid; drawn as a
      // quadratic Bezier instead, its control point offset opposite the
      // specimen's own current horizontal velocity, so the curve reads
      // as trailing/dragging behind motion rather than a static prop.
      const connectors: { sx: number; sy: number; cx: number; cy: number; nx: number; ny: number; o: number; pulse: number }[] = [];
      // Read by the fragments loop below: "una frase no entra en el
      // bounding box de un video. Si el pez cruza, el texto ... se va."
      // Only currently-shown specimens count as obstacles.
      const visibleSpecRects: { x: number; y: number; w: number; h: number }[] = [];

      // Only one of the dominant candidates (octopus, chimp) actually
      // renders large at any moment -- alternates slowly (not picked by
      // proximity, which would flicker) rather than both competing for
      // the screen's one "dominant" slot at once.
      const dominantCandidates = specNodes.filter((n) => n.s.scale === 'dominant');
      const dominantNow = dominantCandidates.length ? dominantCandidates[Math.floor(t / 45) % dominantCandidates.length] : null;

      const channel = Math.max(1, nerveMax - nerveMin);
      // BAND_RANGE itself is hoisted to module scope now -- assignFragment
      // needs the same ranges to place fragments nerve-relative, and a
      // function-local const here wasn't visible to it.

      type Candidate = {
        n: (typeof specNodes)[number]; w: number; X: number; Y: number; sx: number; sy: number;
        anchorX: number; nerveYHere: number; dofT: number; blurPx: number; centerDist: number; isDominant: boolean;
        tier: ScaleTier;
      };
      const candidates: Candidate[] = specNodes.map((n) => {
        const isDominant = n === dominantNow;
        // tier used to downgrade a dominant candidate not currently
        // holding the slot to mesa scale -- which meant octopus/chimp
        // visibly regrew/shrank every time dominantNow alternated
        // between them (their width recomputed from a different
        // SCALE_VW tier). Direct fix: dominantNow only decides
        // visibility (which one is shown at all, via ROLE_BUDGET's own
        // isDominant-first sort below) -- it no longer touches size.
        // Each specimen's tier, and therefore its width, is always its
        // own declared scale from the SPECIMENS array.
        const tier: ScaleTier = n.s.scale;

        // Depth of field: d spans roughly 0.42-1.0 across the roster.
        // Interpolated into scale/blur/speed rather than a hard
        // foreground/background split, since d itself is continuous --
        // shallow-d specimens read smaller, softer and drift slower
        // (blur 2px), deep-d ones read larger and sharp (no blur), per
        // the diorama note. Speed itself was already depth-scaled via
        // worldX * n.s.d below; unchanged.
        const dofT = Math.max(0, Math.min(1, (n.s.d - 0.42) / (1.0 - 0.42)));
        // Size by role, per direct spec's own table -- a viewport-width
        // fraction, not the specimen's own natural pixel width times a
        // multiplier. dofT still gives some variety within a role
        // rather than every mesa specimen reading as the identical
        // size.
        const isMobileScale = W < 500;
        const [vlo, vhi] = isMobileScale ? SCALE_VW[tier].mobile : SCALE_VW[tier].desktop;
        let w = (vlo + dofT * (vhi - vlo)) * W;
        if (isMobileScale && SCALE_FLOOR_MOBILE[tier]) w = Math.max(w, SCALE_FLOOR_MOBILE[tier]);
        // Applied after the role range AND its floor, so a per-specimen
        // bump (see Specimen.sizeMul) scales the whole result rather
        // than getting clamped away by the floor it's meant to clear.
        if (n.s.sizeMul) w *= n.s.sizeMul;
        // Was a flat px value (perdido: 1.1, others: (1-dofT)*2) --
        // reported directly: "on mobile they look blurry" while
        // desktop looked fine, same asset either way. Root cause
        // wasn't resolution (confirmed: a raw extracted frame of the
        // same source file looked sharp) -- it's that mobile's own
        // SCALE_VW range renders every specimen at roughly half
        // desktop's pixel width (a bigger % of a much narrower
        // viewport), so a FIXED blur radius reads as a proportionally
        // much heavier soft-focus there. Scaling blur by the
        // specimen's own just-computed w keeps the relative softness
        // the same at every breakpoint instead of the absolute one --
        // constants chosen so desktop's own look is unchanged (mesa at
        // its typical ~300px desktop width still lands near the old
        // 2px ceiling) while mobile's smaller render gets proportionally
        // less blur, not the same amount over a smaller image.
        const blurPx = tier === 'perdido' ? w * 0.0055 : (1 - dofT) * w * 0.0067;

        const baseX = wrap(n.xn * WORLD_W - worldX * n.s.d, WORLD_W) - Math.min(520, W * 0.4);
        const anchorX = baseX + w * 0.5;
        // Anchored to the nerve's own live curve rather than a fixed
        // fraction of H -- each specimen orbits a fixed offset above or
        // below wherever the nerve actually is right now, inside its
        // assigned band, so the two move together instead of drifting
        // as unrelated layers. worldYoff's own contribution lives here
        // too, folded into the small orbit term below, since the
        // nerve's own mid-line already carries worldYoff*0.06 --
        // adding the old full worldYoff*d on top of that double-
        // counted the same drift.
        const nerveYHere = chainYAt(anchorX);
        const [lo, hi] = BAND_RANGE[n.s.band];
        const mag = (lo + n.bandT * (hi - lo)) * channel;
        const side = n.s.band === 'alta' ? -1 : n.s.band === 'baja' ? 1 : n.bandT < 0.5 ? -1 : 1;
        const orbit = Math.sin(t * 0.09 + n.pulsePhase) * channel * 0.015;
        const baseY = nerveYHere + side * mag + orbit - w * 0.3;
        const bsx = baseX + w * 0.5, bsy = baseY + w * 0.28;

        // Lean toward the cursor within a wider radius than the wake
        // threshold -- a specimen reaches slightly before it fully
        // wakes, rather than snapping straight from asleep to awake.
        // Witness specimens (piglet) don't lean at all -- "testigo, no
        // nada como el goldfish" / direct spec "Lean ≈ 0": it watches,
        // it doesn't swim toward the pointer the way goldfish does.
        const leanMul = n.s.witness ? 0 : 1;
        let wantLeanX = 0, wantLeanY = 0;
        if (!isTouch && hasPointer) {
          const d = Math.hypot(px - bsx, py - bsy);
          // Was w*1.2 (proportional to the specimen's own rendered
          // width) -- FIELD-SPEC gives lean as a flat "within roughly
          // 430 pixels," same for every specimen regardless of size.
          // Proportional meant a small perdido specimen leaned within
          // ~120-180px while a large dominant one leaned within
          // 550px+; a flat radius matches the doc and gives every
          // specimen the same reach.
          const leanRadius = 430;
          if (d < leanRadius) {
            const f = 1 - d / leanRadius;
            const dx = px - bsx, dy = py - bsy, dl = Math.hypot(dx, dy) || 1;
            wantLeanX = (dx / dl) * f * f * 14 * leanMul;
            wantLeanY = (dy / dl) * f * f * 9 * leanMul;
          }
        }
        const leanApproach = approachFactor(0.08, dt);
        n.leanX += (wantLeanX - n.leanX) * leanApproach;
        n.leanY += (wantLeanY - n.leanY) * leanApproach;

        const X = baseX + n.leanX, Y = baseY + n.leanY;
        const sx = X + w * 0.5, sy = Y + w * 0.28;
        const centerDist = Math.abs(sx - W / 2) + Math.abs(sy - H / 2) * 0.5;
        return { n, w, X, Y, sx, sy, anchorX, nerveYHere, dofT, blurPx, centerDist, isDominant, tier };
      });

      // Visibility budget, per direct spec's own cupo table -- a cap
      // PER ROLE, not one flat top-N across the whole roster. A mobile
      // screen that already has its one dominant and one mesa doesn't
      // get a second mesa just because there's still room in a flat
      // budget of 4; a desktop's extra mesa slot doesn't let a THIRD
      // mesa in either. "Si no cabe, no montes el siguiente" -- once a
      // role's cap is full, the next candidate for that role simply
      // doesn't mount, it isn't shrunk or substituted.
      const isMobileBudget = W < 500;
      const ROLE_BUDGET: Record<ScaleTier, number> = isMobileBudget
        ? { dominant: 1, mesa: 1, perdido: 1 }
        : { dominant: 1, mesa: 2, perdido: 1 };
      const onScreen = candidates.filter((c) => c.X > -(c.w + 300) && c.X < W + 300 && c.Y > -c.w && c.Y < H + c.w);
      const shown = new Set<(typeof specNodes)[number]>();
      (['dominant', 'mesa', 'perdido'] as ScaleTier[]).forEach((role) => {
        onScreen
          .filter((c) => c.tier === role)
          .sort((a, b) => (a.isDominant === b.isDominant ? a.centerDist - b.centerDist : a.isDominant ? -1 : 1))
          .slice(0, ROLE_BUDGET[role])
          .forEach((c) => shown.add(c.n));
      });

      // Specimen DATA tags: max 3 visible at once, per direct spec --
      // a wake state that would show a tag past that budget still
      // brightens/glows normally, it just doesn't add a fourth label
      // to read at the same time.
      let tagsShown = 0;

      for (const c of candidates) {
        const { n, w, X, Y, sx, sy, anchorX, nerveYHere, dofT, blurPx } = c;
        const on = shown.has(n);
        // The CSS fade (see .spec[data-shown='0'], 1.1s opacity
        // transition) means a specimen dropping out of ROLE_BUDGET
        // stays visibly on screen for another second-plus after `on`
        // itself flips false. Before that fade existed, on/hidden was
        // instant, so gating the collision-rect push and video pause
        // below on raw `on` was harmless -- there was nothing left to
        // collide with the same frame it vanished. Now there is: a
        // fragment could spawn or drift onto a specimen that's still
        // clearly visible mid-fade, with nothing stopping it because
        // that specimen had already dropped out of visibleSpecRects.
        // Reported directly: a quote sitting right on top of piglet
        // while piglet still looked fully present. fadeOutUntil keeps
        // it a real obstacle (and keeps its position/tag/flare
        // updating, not frozen) for exactly as long as the CSS fade
        // itself takes.
        if (n.wasOn && !on) n.fadeOutUntil = t + 1.15;
        n.wasOn = on;
        const visuallyPresent = on || t < n.fadeOutUntil;
        n.el.dataset.shown = on ? '1' : '0';
        // Tabbing to a tagged specimen only makes sense once the field
        // is actually the thing on screen -- #world sits at opacity:0
        // the whole time Act I is showing (see body[data-landing='field']
        // .world in this file's own style block), but that alone
        // doesn't remove a tabindex="0" element from keyboard Tab
        // order: opacity hides paint, not focusability. Confirmed
        // directly, walking Tab order on the still-undocked landing
        // page: after the 7 real nav links, focus kept moving into
        // invisible specimens -- a dead tab stop for every one of them,
        // no visible indication anything received focus. Explicit -1
        // pre-dock keeps this element out of Tab order entirely until
        // it's genuinely the thing being shown.
        if (n.s.tag) n.el.tabIndex = docked && on ? 0 : -1;

        // Lazy mount: assign the real src (and poster) only now, the
        // first time this specimen is actually shown -- see the note
        // on specNodes' creation above for why nothing is set earlier.
        if (on && !n.mounted) {
          n.mounted = true;
          const img = n.el.querySelector('img') as HTMLImageElement | null;
          if (img && n.s.img) img.src = n.s.img;
          if (n.video) {
            if (n.s.poster) n.video.poster = n.s.poster;
            n.video.src = n.s.vid!;
            n.video.load();
          }
        }

        // Flare cycle runs regardless of on-screen visibility (a
        // specimen currently off-screen shouldn't come back already
        // mid-flare, or always flare the instant it enters view) --
        // this is genuinely unprompted, not a reaction to being seen.
        if (n.flareT < 0) {
          n.flareIn -= dt;
          if (n.flareIn <= 0) { n.flareT = 0; n.flareIn = 9 + Math.random() * 16; }
        } else {
          n.flareT += dt;
          if (n.flareT >= 2.6) n.flareT = -1;
        }
        const flareEnv = n.flareT < 0 ? 0
          : n.flareT < 0.8 ? n.flareT / 0.8
          : n.flareT < 1.8 ? 1
          : (2.6 - n.flareT) / 0.8;
        n.el.style.setProperty('--flare', flareEnv.toFixed(3));

        // Pause only once the fade-out has actually finished, purely
        // to save decode work on something nobody can see any more --
        // never as a reaction to proximity/hover, and not the instant
        // it loses its budget slot (see visuallyPresent above: it's
        // still on screen, fading, for another ~1.1s after that).
        // Every specimen video is meant to be a continuous, unprompted
        // animation, not something that starts moving only once
        // someone finds it, or freezes mid-fade on its way out.
        if (!visuallyPresent) {
          if (n.video && n.playing) { n.video.pause(); n.playing = false; }
          continue;
        }

        // Secondary motion -- stills only (chimp, eyefish). A static
        // image next to looping video read as a flat cutout, not a
        // living thing, hence the levitation bob -- but a VIDEO
        // specimen already has its own internal motion, and animating
        // its wrapper on top read as jitter, not life. Direct spec:
        // "sin animar el wrapper" for video. The breathing scale() this
        // used to carry alongside the bob is gone entirely now --
        // direct spec: "Prohibido: transform: scale() en .spec." Size
        // comes from width alone (set just below); transform is
        // translate-only.
        let bob = 0;
        if (n.s.img) {
          bob = Math.sin(t * 0.7 + n.pulsePhase * 1.7) * (w * 0.015 + 3);
        }
        n.el.style.transform = `translate3d(${X}px, ${(Y + bob).toFixed(1)}px, 0)`;
        n.el.style.width = w + 'px';
        // h was a flat w*0.7 guess -- fine for the roster's mostly-16:9
        // sources (~0.55-0.56 real aspect) but goldfish.mp4 and
        // octopus.webm are square (624x624, 512x512), so their REAL
        // rendered height is ~w, not 0.7w. That 30% shortfall left the
        // bottom of exactly those two specimens outside the collision
        // box fragments check against -- confirmed directly: a fragment
        // sat fully intact on top of the goldfish for a sustained ~18s
        // with the "quote never sits on a video" avoidance never
        // firing, because by this box's math there was no collision at
        // all. offsetHeight reads the real rendered box instead.
        visibleSpecRects.push({ x: X, y: Y, w, h: n.el.offsetHeight || w * 0.7 });
        // Depth-of-field blur on the specimen's own wrapper -- the child
        // img/video already carries brightness/contrast/saturate via
        // the CSS rule (see .spec img/video), so this composes with
        // that rather than overriding it (different elements).
        n.el.style.filter = blurPx > 0.05 ? `blur(${blurPx.toFixed(2)}px)` : '';

        // Slow, independent breathing -- 18s period, phase-offset per
        // specimen so two pulsing specimens (if there ever are more
        // than one) wouldn't sync up. Separate from --awake/--flare
        // entirely: this one dims all the way toward transparent, not
        // just less bright, since the ask was specifically to fade in
        // and out rather than dim and brighten.
        if (n.s.pulse) {
          const cyc = 0.5 + 0.5 * Math.sin((t * Math.PI * 2) / 18 + n.pulsePhase);
          n.el.style.opacity = (0.06 + cyc * 0.94).toFixed(3);
        }

        // Connector filament, per specimen -- gauze, not a permanent
        // cable. Direct spec: "Filamento vertical = gasa: se tuerce,
        // atrapa, suelta. Nunca HDMI permanente." A fixed opacity read
        // as exactly that permanent HDMI cable regardless of the
        // Bezier curve underneath it; gasaCycle instead slowly releases
        // toward near-invisible and catches back into view, phase-offset
        // per specimen so they don't breathe in unison, and a second,
        // faster-frequency wobble on the control point reads as the
        // filament twisting rather than just trailing.
        const velocity = Math.max(-40, Math.min(40, anchorX - n.prevAnchorX));
        n.prevAnchorX = anchorX;
        // The pushes below are canvas draws, not DOM -- .world's own
        // opacity:0 (body[data-landing='field'] .world{opacity:1}) hides
        // every specimen element until docked, but the nerve canvas
        // sits on its own layer above everything and was never subject
        // to that rule. Confirmed directly: pre-dock, with #world
        // computed opacity 0, several specimens still counted as
        // "visuallyPresent" here (their own ROLE_BUDGET rotation runs
        // regardless of dock state), so their connector/flare lines
        // were painted onto the always-visible canvas anyway --
        // 2-4 disconnected gold threads hanging in the void on the
        // landing page with no visible specimen attached to them, for
        // as long as someone sits on Act I. Gating on the same docked
        // check the video-autoplay line below already uses.
        // prevAnchorX itself still updates every frame regardless (just
        // above) so velocity isn't computed against a stale value from
        // however long ago Act I lasted the moment this does start
        // drawing.
        if (docked) {
          const gasaCycle = 0.5 + 0.5 * Math.sin(t * 0.12 + n.pulsePhase * 1.7);
          const twist = Math.sin(t * 0.31 + n.pulsePhase * 2.3) * 14;
          connectors.push({
            sx, sy,
            cx: sx - velocity * 2.2 + twist,
            cy: (sy + nerveYHere) / 2,
            nx: anchorX, ny: nerveYHere,
            o: (0.05 + gasaCycle * 0.2) + dofT * 0.08,
            pulse: n.pulsePhase,
          });

          if (flareEnv > 0.02) {
            flareLines.push({ x: sx, y1: sy, y2: chainYAt(sx), o: flareEnv * 0.7 });
          }
        }

        let want = 0;
        if (isTouch) {
          want = t < n.tapAwakeUntil ? 1 : 0;
        } else if (hasPointer) {
          const d = Math.hypot(px - sx, py - sy);
          want = d < w * 0.62 ? 1 : 0;
        }
        // Keyboard focus wakes it too, on any device -- a mouse user
        // gets proximity for free (above); a keyboard user has no
        // cursor to be "near" with, so tapAwakeUntil (set on focus, see
        // specNodes above) is the equivalent trigger regardless of
        // isTouch/hasPointer.
        if (t < n.tapAwakeUntil) want = 1;
        n.awake += (want - n.awake) * approachFactor(0.1, dt);
        // --awake (brightness/glow) always reflects the real value;
        // only the TAG's own visibility is budgeted to 3 concurrent.
        n.el.style.setProperty('--awake', n.awake.toFixed(3));
        const wantsTag = n.awake > 0.5 && !!n.s.tag;
        const showTag = wantsTag && tagsShown < 3;
        if (wantsTag && showTag) tagsShown++;
        n.el.dataset.awake = showTag ? '1' : '0';

        // Every video specimen is a continuous animation, not a still
        // waiting to be woken -- was gated on n.awake > 0.4 (proximity/
        // hover), so a video sat frozen on its poster frame until
        // someone found it, called out directly as looking static.
        // --awake above still drives brightness/glow (that reactivity
        // is real and stays); playback itself no longer depends on it.
        // Gated on data-landing='field' too now, per direct spec
        // ("autoplay tras dock") -- previously a specimen already
        // geometrically on-screen at load could start decoding/playing
        // during the hero, before anyone had actually docked.
        // Retries every 1.5s while still paused, rather than a single
        // fire-and-forget attempt -- see the nextPlayAttempt comment on
        // specNodes for why a one-shot call left specimens stuck.
        if (n.video && docked) {
          if (n.video.paused) {
            if (t >= n.nextPlayAttempt) {
              n.nextPlayAttempt = t + 1.5;
              n.video.play().then(() => { n.playing = true; }).catch(() => {});
            }
          } else {
            n.playing = true;
          }
        }
      }

      // Connector filaments -- one per visible specimen, always drawn
      // (not just while flaring; see flareLines just below for that
      // brighter, separate overlay). Quadratic Bezier, not a straight
      // line, its control point already offset opposite the specimen's
      // own real velocity when pushed above -- reads as dragging
      // through something viscous rather than a rigid prop. A small
      // pulsing "suture" node marks where the filament actually meets
      // the nerve, drawn after the curve so it sits on top of it.
      for (const c of connectors) {
        ctx!.beginPath();
        ctx!.moveTo(c.sx, c.sy);
        ctx!.quadraticCurveTo(c.cx, c.cy, c.nx, c.ny);
        ctx!.strokeStyle = `rgba(247, 197, 106, ${c.o})`;
        ctx!.lineWidth = 1;
        ctx!.stroke();

        const nodePulse = 0.5 + 0.5 * Math.sin(t * 1.6 + c.pulse);
        const nodeR = 1.4 + nodePulse * 1.1;
        ctx!.beginPath();
        ctx!.arc(c.nx, c.ny, nodeR, 0, Math.PI * 2);
        ctx!.fillStyle = `rgba(255, 235, 190, ${0.35 + nodePulse * 0.4})`;
        ctx!.shadowBlur = 6;
        ctx!.shadowColor = 'rgba(247, 197, 106, 0.8)';
        ctx!.fill();
        ctx!.shadowBlur = 0;
      }

      // The flare's "gold line dropped to the nerve" -- drawn after the
      // specimen loop so sx/chainYAt are already known for anything
      // currently flaring.
      if (flareLines.length) {
        ctx!.shadowBlur = 10;
        ctx!.shadowColor = 'rgba(247, 197, 106, 0.7)';
        for (const fl of flareLines) {
          ctx!.beginPath();
          ctx!.moveTo(fl.x, fl.y1);
          ctx!.lineTo(fl.x, fl.y2);
          ctx!.strokeStyle = `rgba(247, 197, 106, ${fl.o})`;
          ctx!.lineWidth = 1.2;
          ctx!.stroke();
        }
        ctx!.shadowBlur = 0;
      }

      // ---- fragments: staggered entrance, drift, decay onto the nerve ----
      const ENTRY_OFFSET = 320;
      // Read by the stops loop just below, so a stop label can duck
      // around a live quote instead of landing on top of it -- see that
      // loop's own comment for why this is a stop's problem to solve,
      // not the quote's.
      const liveFragRects: { x: number; y: number; w: number; h: number; slot: typeof fragSlots[number] }[] = [];
      for (const slot of fragSlots) {
        if (slot.state === 'pending') {
          slot.pendingT -= dt;
          slot.el.style.visibility = 'hidden';
          if (slot.pendingT <= 0) assignFragment(slot);
          continue;
        }

        const depthFactor = 0.3 + slot.depth * 0.7;
        const baseX = wrap(slot.xn * WORLD_W - worldX * depthFactor, WORLD_W) - Math.min(520, W * 0.4);
        // slot.y is a one-time snapshot of the live nerve curve taken at
        // spawn (see assignFragment) -- but scaling worldYoff by the
        // same per-fragment depthFactor used for specimens' parallax
        // meant two chairs drifted by a DIFFERENT amount depending on
        // which fragment each had been assigned, since worldYoff's own
        // swing (±0.16H) is nearly as large as the gap between bands.
        // Confirmed directly: two quotes' text rendered on top of each
        // other mid-drift, well after both had spawned cleanly
        // separated. A small, flat sway (not depth-scaled) keeps some
        // ambient life without threatening that separation.
        const baseY = slot.y * H + worldYoff * 0.05;

        // Entry offset decays toward 0 each frame -- this is what makes
        // a freshly spawned fragment fly in from its chosen edge rather
        // than simply fading in at its resting spot. Was 0.94 (a ~1s
        // reveal, both the fly-in offset and the opacity ramp below
        // are driven by this same value) -- direct feedback: fragments
        // "come up abruptly... we need a sloooow fade in." Slowed to a
        // ~3.5s reveal (95% settled by then), matching the doc's own
        // subhead-bead / callout language elsewhere on this site about
        // things lighting up rather than snapping in.
        slot.entryAmt *= reduced ? 0 : Math.pow(0.9858, dt * 60);
        const off = slot.entryAmt * ENTRY_OFFSET;
        let ox = 0, oy = 0;
        if (slot.entryDir === 'left') ox = -off;
        else if (slot.entryDir === 'right') ox = off;
        else if (slot.entryDir === 'top') oy = -off;
        else oy = off;

        const X = baseX + ox, Y = baseY + oy + slot.dodgeY;
        // Visibility is checked against the RESTING position (no entry
        // offset), and requires the whole block to fit -- not a wide
        // fixed-pixel margin around a partial overlap. The old margin
        // (700px) was sized for a 1440px desktop; on a 375px phone
        // that's nearly the entire screen of allowed overhang, so a
        // fragment mid-drift off the edge stayed "visible" while
        // showing only its right half, reading as clipped, broken
        // text. A fragment flying in from off-screen (entryAmt > 0)
        // still needs to render during that animation even though its
        // CURRENT position is off-screen on purpose, so containment is
        // judged on baseX/baseY, not the animated X/Y.
        const bw = slot.el.offsetWidth || 260;
        const bh = slot.el.offsetHeight || 80;
        const on = baseX > -10 && baseX + bw < W + 10 && baseY > -10 && baseY + bh < H + 10;
        // `on` itself stays purely geometric -- offscreenTime, the
        // collision checks below, and liveFragRects all still need the
        // real on-screen state regardless of dock, same as before. Only
        // what gets assigned to the inline style changes: an inline
        // visibility always beats #world's own CSS rule (see docked's
        // own comment above), so a fragment's citation link stayed
        // keyboard-focusable through Act I whenever its drift happened
        // to be on-screen, confirmed directly by walking Tab order on
        // the still-undocked landing page. `on && docked` keeps the
        // citation card out of Tab order until the field is real.
        slot.el.style.visibility = on && docked ? 'visible' : 'hidden';
        slot.el.style.transform = `translate3d(${X}px, ${Y}px, 0)`;

        // See offscreenTime's own comment on the slot object. Applies
        // regardless of state (alive, decaying, or dead-waiting-to-
        // respawn) -- not just 'alive' -- because a slot whose natural
        // decayAfter timer happens to fire right around when it drifts
        // off-screen would otherwise still run its full decay animation
        // and respawnDelay (up to ~10-15s combined) with nobody able to
        // see any of it, defeating the whole point of this fix. Skips
        // straight to a fresh assignFragment instead.
        slot.offscreenTime = on ? 0 : slot.offscreenTime + dt;
        if (slot.offscreenTime >= 3.5) {
          assignFragment(slot);
          continue;
        }

        // Decaying quotes are already coming apart into scattered gold
        // letters, not a solid block of text any more, so they aren't
        // worth a stop label dodging -- only a fully "alive," genuinely
        // readable quote counts as an obstacle.
        if (on && slot.state === 'alive') {
          liveFragRects.push({ x: X, y: Y, w: bw, h: bh, slot });
        }

        const fx = X + 140, fy = Y + 20;
        let near = false;
        if (on && hasPointer) near = Math.hypot(px - fx, py - fy) < 240;

        if (slot.state === 'alive') {
          slot.aloneTime += near ? -dt * 2.5 : dt;
          if (slot.aloneTime < 0) slot.aloneTime = 0;
          const opacity = (0.5 + (1 - slot.depth) * 0.15 + (near ? 0.3 : 0)) * (1 - slot.entryAmt * 0.85);
          slot.el.style.opacity = String(Math.min(0.92, opacity));

          // "El texto espera o se va" -- a live quote that overlaps a
          // currently-shown specimen's real bounding box gets pushed
          // toward early decay instead of sitting drawn across a fish's
          // face. Accumulated (not instant) so a one-frame graze from a
          // specimen drifting past doesn't trigger it; recovers if the
          // overlap clears before it fires. Also checked against OTHER
          // live fragments -- assignFragment only checks siblings once,
          // at spawn, but two chairs keep drifting independently after
          // that and can converge later; seen directly, two citation
          // cards landing right on top of each other, both unreadable.
          // liveFragRects already has this slot's own rect pushed just
          // above, so it's excluded by identity here.
          if (on) {
            let colliding = false;
            for (const r of visibleSpecRects) {
              if (X < r.x + r.w && X + bw > r.x && Y < r.y + r.h && Y + bh > r.y) { colliding = true; break; }
            }
            if (!colliding) {
              for (const r of liveFragRects) {
                if (r.slot === slot) continue;
                if (X < r.x + r.w && X + bw > r.x && Y < r.y + r.h && Y + bh > r.y) { colliding = true; break; }
              }
            }
            // Landing's "Continue" cue -- fixed chrome, not part of
            // specNodes/fragSlots, so it needs its own check. Reported
            // directly: a citation line sitting right through it.
            if (!colliding && cueRect && cueRect.width >= 10) {
              if (X < cueRect.right && X + bw > cueRect.left && Y < cueRect.bottom && Y + bh > cueRect.top) colliding = true;
            }
            slot.collideTime = colliding ? slot.collideTime + dt : Math.max(0, slot.collideTime - dt * 2);

            // Duck out of the way before giving up and dying -- "el
            // texto espera o se va" was only ever built as "waits, then
            // leaves" (collideTime above, forcing an early decay once
            // it runs out), with nothing in between ever trying to
            // actually get clear first. Measured directly: with 4
            // fragment chairs and up to 4 specimens sharing one
            // channel, that meant collision-forced decay firing on
            // effectively every fragment, 2-25s after spawn -- none of
            // FIELD-SPEC's own ~40s natural "alone" timeouts ever got a
            // real chance to run. A small, slow vertical nudge away
            // from the obstacle, eased the same way as every other
            // proximity response here, gives a graze an actual chance
            // to clear on its own before the 3.5s tolerance below is
            // even reached. Clamped to roughly a third of this slot's
            // own zone-third (see zoneIdx in assignFragment) so it
            // trades one collision for breathing room within its own
            // band, not for a new collision next door. Direction is
            // toward whichever edge of that band currently has more
            // room, recomputed fresh each frame from the live position
            // (not fixed once) so it keeps adapting as things drift --
            // stable in practice since the ease itself is slow enough
            // not to flicker near the band's own midpoint.
            const zoneThird = Math.max(1, (nerveMax - nerveMin) / 3);
            const zoneLo = nerveMin + slot.zoneIdx * zoneThird;
            const maxDodge = zoneThird * 0.32;
            const towardTop = Y - zoneLo < zoneLo + zoneThird - (Y + bh);
            const dodgeTarget = colliding ? (towardTop ? -1 : 1) * maxDodge : 0;
            slot.dodgeY += (dodgeTarget - slot.dodgeY) * approachFactor(0.05, dt);
          }
          // Was 0.25s (lowered from 0.4s in an earlier fix) -- measured
          // directly what that actually did over a real 60s session
          // with no cursor interaction: 32 decay events, ALL 32
          // collision-forced, ZERO natural timeouts, most fragments
          // dying within under a second of spawning. With four
          // fragment chairs, up to four specimens, and the cue all
          // competing for the same viewport, some overlap is close to
          // constant -- a 0.25s tolerance meant nearly every fragment
          // got killed by a passing graze before anyone could read
          // more than its first few words, making the whole ~40s
          // decayAfter tuning theoretical. Direct feedback: "it
          // doesn't give you the chance to read them." Raised to 3.5s
          // -- long enough that a momentary graze from a drifting
          // specimen (the common case, given depth-based parallax
          // means fragments and specimens rarely stay stacked for
          // long) clears on its own before triggering, short enough
          // that a fragment genuinely stuck under something for
          // several seconds still gets the fast exit this mechanism
          // exists for.
          const forcedByCollision = slot.collideTime >= 3.5;

          // Reduced motion: no death at all, per direct spec -- a
          // fragment just stays put, static, its own citation card
          // already showing, rather than ever coming apart.
          if (!reduced && (slot.aloneTime >= slot.decayAfter || forcedByCollision)) {
            slot.state = 'decaying'; slot.decayT = 0;
            const mode = DEATHS[slot.deathI % DEATHS.length];
            slot.deathI += 1;
            slot.physMode = mode;
            slot.physT = 0;
            slot.physLast = performance.now();
            // Collision is a "get out of the way NOW," not a performance --
            // "el texto espera o se va" means it actually leaves, not that
            // it quietly starts a 10-20s decay while its block keeps
            // sitting drawn across the specimen the whole time it was
            // supposed to avoid. Confirmed directly: a fragment forced
            // into 'decaying' by collision stayed fully opaque and
            // unmoved for 10+ seconds afterward, because 'float' mode's
            // own per-letter wake delay (up to i*0.12s) plus its fade
            // rate (~15s to fully fade) both run at their normal,
            // deliberately unhurried pace regardless of WHY the decay
            // started. A natural aloneTime timeout should still get the
            // slow, savored version; a collision needs the fast one.
            const wasCollision = forcedByCollision && slot.aloneTime < slot.decayAfter;
            // Was 0.15/5 (a ~1.4-2.4s dissolve at current base rates) --
            // direct feedback: even a forced decay "needs to happen
            // slow, elegant and coordinated," not rushed. The 3.5s
            // collision-tolerance threshold above already does the
            // real work of not triggering this on every passing graze,
            // so the dissolve itself no longer needs to be this
            // urgent once it does fire. Moderated to a ~3-5.5s dissolve
            // with a more visible per-letter stagger (wakeMul raised)
            // so it reads as a deliberate, coordinated departure
            // rather than a flash-and-gone.
            const wakeMul = wasCollision ? 0.5 : 1;
            const fadeMul = wasCollision ? 2.2 : 1;
            // Same formulas as Landing's own decay() -- each letter is a
            // Verlet particle displaced by a transform relative to its
            // own normal-flow position, not repositioned to an absolute
            // screen coordinate, so this ports unchanged onto a <b> that
            // already sits correctly inside its word span.
            const origin = slot.chars.map((b) => b.getBoundingClientRect());
            slot.phys = slot.chars.map((b, i) => {
              // Snapshot the letter's actual rendered opacity before
              // cancelling -- cancel() reverts to whatever b.style.opacity's
              // own inline value is, which the onfinish handler above
              // only ever updates once that letter's entrance animation
              // genuinely finishes. A collision-forced decay isn't
              // gated on that: confirmed directly, a fragment can be
              // force-decayed within a second or two of spawning, while
              // its own later letters (a longer per-letter stagger) are
              // still visibly mid-fade-in. Cancelling one of those
              // reverts it straight to the stale creation-time '0'
              // regardless of the partial opacity actually on screen a
              // moment before -- a real snap to invisible, then the
              // physics particle below (life starts at 1) snaps it back
              // to fully visible, before finally decaying. The same
              // "appears, vanishes, reappears, then dies" glitch as the
              // already-finished case, just reached a different way.
              // getComputedStyle reads the live value an instant before
              // this runs; writing it into the inline style first means
              // cancelling immediately after is a no-op regardless of
              // whether the entrance had finished.
              b.style.opacity = getComputedStyle(b).opacity;
              b.getAnimations().forEach((a) => a.cancel());
              const ang = (i / Math.max(slot.chars.length, 1)) * Math.PI * 2 + (Math.random() - 0.5) * 0.35;
              const speed = mode === 'explode' ? 11 + Math.random() * 8 : 2.4 + Math.random() * 2;
              let px = 0, py = 0;
              if (mode === 'explode') {
                px = -Math.cos(ang) * speed;
                py = -Math.sin(ang) * speed;
              }
              const rest = origin[i + 1] ? origin[i + 1].left - origin[i].left : origin[i].width;
              return {
                el: b, x: 0, y: 0, px, py, rot: 0,
                rotv: mode === 'explode' ? (Math.random() - 0.5) * 14 : (Math.random() - 0.5) * 0.4,
                damp: mode === 'float' ? 0.965 : mode === 'fall' ? 0.996 : mode === 'explode' ? 0.986 : 0.978,
                life: 1,
                // Was 0.0033/0.0016/0.0011/0.0013 (a flat 0.6x of
                // Landing's own rates, "misma física" stretched per
                // direct tempo spec) -- real durations at that scale
                // ranged 5.05s (explode) to 15.2s (float), a 3x spread
                // FIELD-SPEC's "fade over about ten seconds" doesn't
                // read as intending. Retuned to 7/10.4/12/11s (explode/
                // fall/float/corrode) -- averages ~10s, keeps each
                // mode's own distinct character (explode still
                // noticeably quicker, float still the slowest/dreamiest)
                // without a 3x outlier gap, and every one of the four
                // stays slower than Landing's own corresponding rate
                // (3.03/6.41/9.26/7.58s), preserving that explicit
                // "más lento que Landing" instruction rather than
                // overriding it. fadeMul (collision-forced decay) is
                // unchanged -- still lands in a fast, sensible 1.4-2.4s
                // range at these new base rates.
                fade: (mode === 'explode' ? 0.002381 : mode === 'fall' ? 0.0016 : mode === 'float' ? 0.001389 : 0.001515) * fadeMul,
                wake: (mode === 'explode' ? 0.28 : mode === 'float' ? i * 0.12 : mode === 'corrode' ? i * 0.16 : mode === 'fall' ? i * 0.05 : 0) * wakeMul,
                scale: 1,
                link: mode === 'corrode' && i < slot.chars.length - 1,
                rest,
                breakAt: 0.35 + i * 0.16,
              };
            });
            slot.physRunning = true;
            slot.ref.style.transition = 'opacity 0.6s linear';
            slot.ref.style.opacity = '0';
          }
        } else if (slot.state === 'decaying') {
          slot.el.style.opacity = '1';
          stepPhysFor(slot, performance.now());
        } else {
          // dead -- waiting to respawn as a different fragment
          slot.el.style.opacity = '0';
          slot.respawnDelay -= dt;
          if (slot.respawnDelay <= 0) assignFragment(slot);
        }
      }
      // ---- stops ----
      for (const s of stopNodes) {
        const X = wrap(s.xn * WORLD_W - worldX, WORLD_W) - Math.min(520, W * 0.4);
        let y = chainYAt(X) + worldYoff * 0.02;
        const on = X > -200 && X < W + 200;
        // Same fix as the fragment citation link just above -- a stop
        // is a real <a>, natively focusable with no tabindex needed at
        // all, so it was reachable via Tab through the whole of Act I
        // whenever its drift happened to put it on-screen, regardless
        // of anyone ever docking. `on && docked` matches the visual
        // truth (invisible behind #world's own opacity:0) with the
        // keyboard one.
        s.el.style.visibility = on && docked ? 'visible' : 'hidden';
        if (!on) continue;

        // A stop rides the nerve wherever the nerve happens to be, and
        // nothing kept that from landing exactly on a live quote's own
        // territory -- unlike a specimen (a photo can sit behind a short
        // word and both still read fine), two blocks of dense text on
        // the same pixels are simply unreadable, seen directly: a stop's
        // name rendered right through a quote's own line. A stop is one
        // short word, so nudging it perpendicular off the wire just far
        // enough to clear the quote is far cheaper than moving the
        // quote itself, and it still visibly rides the nerve -- just
        // ducking around something in its way, the way it already dips
        // for a specimen drifting past.
        const sw = s.el.offsetWidth || 90, sh = s.el.offsetHeight || 22;
        for (const r of liveFragRects) {
          const sy = y - 22;
          if (X < r.x + r.w && X + sw > r.x && sy < r.y + r.h && sy + sh > r.y) {
            const below = r.y + r.h + sh / 2 + 16;
            const above = r.y - sh / 2 - 16;
            y = Math.abs(below - y) < Math.abs(above - y) ? below : above;
            y = Math.max(nerveMin + 14, Math.min(nerveMax - 14, y));
            break;
          }
        }

        let near = 0;
        if (hasPointer) {
          const d = Math.hypot(px - X, py - y);
          near = d < 140 ? 1 : 0;
        }
        s.el.dataset.near = String(near);
        // FIELD-SPEC: "the bead brightens, the label rises and
        // letterspaces." Brighten and letterspace were already real
        // (the color/letter-spacing transition on [data-near='1']
        // below), but "rises" was never actually built -- a plain CSS
        // transform on that selector can't do it, since this same
        // element's position is an inline style JS overwrites every
        // single frame regardless (inline always wins over a class
        // rule), so any CSS transform would just get clobbered next
        // frame. Smoothed via the same approachFactor curve as every
        // other proximity response in this file (specimen wake, lean),
        // not an instant snap, and baked directly into the Y this same
        // line already computes.
        s.nearAmt += (near - s.nearAmt) * approachFactor(0.12, dt);
        const lift = s.nearAmt * 4;
        s.el.style.transform = `translate3d(${X}px, ${y - 22 - lift}px, 0)`;
      }

      // Under reduced motion everything above this point is already a
      // no-op (drift, springs, decay, entry-fade are each gated on
      // `reduced` individually) -- but the loop itself kept recursing
      // forever regardless, still forcing a getBoundingClientRect
      // every frame and a real layout recompute every ~20 frames for a
      // canvas that never changes. One settled frame, then stop; no
      // rAF loop running at all for a page with nothing left to redraw.
      if (!reduced) requestAnimationFrame(frame);
    }

    resize();
    addEventListener('resize', resize);
    frame();
  }

  initField();
</script>
