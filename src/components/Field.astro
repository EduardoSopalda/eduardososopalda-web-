    // exponential-approach constant (the pattern used all over this
    // file for smoothing: cur += (target-cur)*rate) into its real-time
    // equivalent for the current frame's actual dt, so the same visual
    // feel holds regardless of display refresh rate. See dt's own
    // comment above for why this matters.
    const approachFactor = (ratePerFrame: number, dt: number) => 1 - Math.pow(1 - ratePerFrame, dt * 60);

    function resize() {
      W = innerWidth; H = innerHeight;
