      if (e.key === 'ArrowLeft') targetX -= STEP;
      else if (e.key === 'ArrowRight') targetX += STEP;
      else if (e.key === 'ArrowUp') dragY = Math.max(-H * 0.34, Math.min(H * 0.34, dragY - STEP * 0.5));
      else if (e.key === 'ArrowDown') dragY = Math.max(-H * 0.34, Math.min(H * 0.34, dragY + STEP * 0.5));
