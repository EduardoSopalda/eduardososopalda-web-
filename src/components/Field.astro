  // not something to wait on content for. Direct review finding: the
  // stops were plain <div>s with a no-op click handler, formally
  // invisible to every screen reader and unreachable by keyboard.
  const STOPS: [string, string, string][] = [
    ['Manifesto', 'the argument, stated once', '/manifesto'],
    ['Writing', 'twenty five signals', '/writing'],
    ['Lexicon', 'contested words, defined in public', '/lexicon'],
    ['Out Loud', 'talks, panels, DAMA, the white paper', '/out-loud'],
    ['First Dates', 'speed dating the machines', '/first-dates'],
    ['Who', 'Panama, Finland, Barcelona, a goat', '/who'],
    ['Contact', 'a question, answerable', '/contact'],
