---
// The field itself: the cabinet of curiosities. Specimens and
// fragments drifting at depth, a nerve running through it, the seven
// stops riding that nerve. Ported from prototype/field.html's proven
// drift/decay math (CLAUDE.md: "it already works").
//
// The nerve's wave went spring/tension chain -> closed-form sine (a
// second opinion's reference prototype, "wave, not an electrocardiogram")
// -- back to closed-form, but not the original: this one adds a slow
// amplitude "breath", a spatial "warp" so the phase isn't perfectly
// uniform across the width, and a drifting mid-line, all sampled fresh
// from `t` every frame instead of spring-integrated per point. Pointer
// bend, the drag-linked vertical offset, and the text-zone Y clamp are
// all still layered on top -- see chainYAt/nerveYAt below.
//
// Fragment text is Eduardo's own, verbatim from fragments/fragments.md
// (50 real fragments, thread + weight) -- shared with Landing.astro's
// hero quote via src/data/fragments.ts, one source of truth instead of
// two copies drifting apart. Specimen images/video are the
// confirmed assets from this session — see public/specimens/. Nine of
// eleven carry a thread-mapped catalogue tag; only seaweed and eyefish
// are untagged atmosphere. Tagged as SP.NN, not No.NN -- No.NN already
// belongs to ARTICLE_CATALOG (No.01-25), and having the same number in
// the same typeface mean two different things in the same field (a
// goldfish and an article) was a real, confirmed collision, not a
// stylistic quirk.
---

<!-- The seven stops above are also built by JS onto the nerve (see
     STOPS in the script below) -- those exist for the drifting visual
     field. This list is the same seven, in the same order, as plain
     static markup: a real navigation landmark that works with
     JavaScript off and is not dependent on the field's runtime layout
     math to be reachable. Keep it in sync with STOPS by hand if a
     stop is ever added, renamed, or reordered. -->
<nav class="field-nav" aria-label="Site">
  <a href="/manifesto">Manifesto</a>
  <a href="/writing">Writing</a>
  <a href="/lexicon">Lexicon</a>
  <a href="/out-loud">Out Loud</a>
  <a href="/first-dates">First Dates</a>
  <a href="/who">Who</a>
  <a href="/contact">Contact</a>
</nav>

<!-- aria-hidden lives on the canvas only, not the section: the world div
     holds the real stop links (and fragment/specimen content), and a
     blanket aria-hidden on the section made all of it invisible to
     every screen reader. The canvas is pure decoration -- the nerve
     line has no informational content not already carried by the
     stop links themselves. -->
<section class="field" id="field-root">
  <canvas class="nerve" id="nerve" aria-hidden="true"></canvas>
  <div class="world" id="world"></div>
</section>

<style is:global>
  /* is:global, not scoped: every selector below targets elements
     created dynamically via document.createElement in the script —
     .spec, .frag, .stop, .spec-tag, and their children. Astro scopes
     component styles by attaching a data-astro-cid attribute to
     elements written in the template; JS-created elements never get
     that attribute, so scoped rules silently never matched them. This
     was the actual cause of fragments/specimens rendering in normal
     block flow (stacking downward) instead of at their absolute,
     transform-driven positions — found by measuring getBoundingClientRect
     against the inline transform and seeing them disagree by a growing
     offset per element, not by inspection. */
  .field {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background: var(--void);
    cursor: grab;
    /* Drag is handled entirely via pointerdown/pointermove/pointerup
       in the script below (targetX/dragY) -- without this, a touch
       drag is also the browser's own native pan/scroll gesture, and
       nothing here ever told it to back off. Both fired at once: the
       nerve tries to follow the drag while the page also scrolls
       underneath it, which reads as "the screen moves, not the
       nerve." touch-action: none hands the whole gesture to the
       pointer handlers exclusively. */
    touch-action: none;
  }

  .field:active {
    cursor: grabbing;
  }

  /* Standard visually-hidden pattern: present to screen readers and
     sequential keyboard tab order, removed from visual layout without
     display:none (which would pull it from both). This is the real,
     always-present nav landmark -- the JS-built .stop links on the
     nerve are the same seven destinations, restated as a drifting
     visual, not a replacement for this list. */
  .field-nav {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .field-nav a:focus-visible {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    width: auto;
    height: auto;
    padding: 0.5rem 0.9rem;
    margin: 0;
    clip: auto;
    overflow: visible;
    white-space: normal;
    z-index: 999;
    background: var(--void);
    color: var(--gold);
    outline: 1.5px solid var(--gold);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* The mouse itself becomes a point of light, not an arrow -- the OS
     cursor is hidden and a glowing dot (drawn on the nerve canvas, at
     the same px/py already tracked for bending the nerve) takes its
     place. Touch devices keep default behaviour: there's no persistent
     pointer to replace, and grab/grabbing already meant nothing there. */
  @media (hover: hover) and (pointer: fine) {
    .field,
    .field:active {
      cursor: none;
    }
  }

  .nerve {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Was implicitly behind .world (no z-index on either, so plain DOM
       order decided it, and .world -- appearing later -- won) --
       specimens could visually cut the wire wherever they overlapped
       it. Explicit z-index above the stops (200, the previous highest)
       puts it in front of everything. pointer-events: none is required
       once it's on top, or it would intercept clicks meant for the
       stops and specimens now underneath it. */
    z-index: 250;
    pointer-events: none;
  }

  .world {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 2.6s var(--ease);
    pointer-events: none;
    /* Belt-and-suspenders alongside the docked-only JS visibility/
       tabIndex on specimens, fragment citation links, and stops
       themselves (see `docked` in frame()) -- opacity alone hides
       paint, not keyboard Tab order, which is what actually let a
       keyboard user walk into invisible content through all of Act I.
       Anything inside #world that doesn't set its own explicit
       visibility (an inline style always wins over this) inherits
       hidden from here as a fallback. */
    visibility: hidden;
  }

  body[data-landing='field'] .world {
    opacity: 1;
    pointer-events: auto;
    visibility: visible;
  }

  /* ---- specimens ---- */
  .spec {
    position: absolute;
    top: 0;
    left: 0;
    line-height: 0;
    will-change: transform;
    /* ROLE_BUDGET (see the per-frame specimen loop below) rotates
       which specimens are actually shown -- was a straight
       visibility:visible/hidden swap in JS, which is instant, no
       transition possible on visibility alone. A specimen dropping
       out of budget or off-screen popped out of existence outright,
       reported directly as specimens "disappearing abruptly" --
       exactly the kind of thing CLAUDE.md's "reader is calm" rules
       out. opacity fades over 1.1s; visibility's own transition is
       delayed to match, so it only actually leaves the accessibility/
       interaction tree once the fade has finished, not before.
       data-shown defaults to shown (no attribute set = the base rule
       below applies) so a specimen's very first frame isn't a
       fade-in from nothing. */
    opacity: 1;
    transition: opacity 1.1s var(--ease), visibility 0s linear 0s;
  }

  .spec[data-shown='0'] {
    opacity: 0;
    visibility: hidden;
    transition: opacity 1.1s var(--ease), visibility 0s linear 1.1s;
  }

  /* Only specimens carrying a real catalogue tag get tabindex (see
     specNodes below) -- the untagged atmosphere pair (seaweed, eyefish)
     stay non-interactive since there's nothing real to announce for
     them, same "invent nothing" reasoning as everywhere else on this
     site. Same ring as .stop/.cue elsewhere, so keyboard focus reads
     as one consistent style across the whole field, not invented fresh
     here. */
  .spec:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 6px;
    border-radius: 2px;
  }

  /* None of the source stills or videos are actually cut out — they're
     opaque rectangles with a near-black (not pure 0,0,0) background:
     compression noise, ~1-10 per channel, up to 40+ in spots. Brightening
     that on wake lights up the rectangle itself, not just the creature —
     a visible box, not a glow. So the reactive version (below, scoped to
     [data-cutout]) is opt-in; everyone else gets one static look that
     never moves, and wakes only through the tag, the lean, and the
     canvas-drawn connector line, none of which touch these pixels. */
  .spec img,
  .spec video {
    display: block;
    width: 100%;
    height: auto;
    /* --boost is set once at creation (not per-frame) for specimens
       whose source is inherently pale/low-contrast -- see Specimen.boost. */
    filter: brightness(calc(0.82 * var(--boost, 1))) contrast(1.24) saturate(0.92);
    /* A raw <video> or <img> is directly tappable/draggable by default
       -- on iOS Safari a tap or touch-drag that lands on it (not on a
       wrapping element) can trigger the browser's own native media UI:
       a fullscreen video player, or -- confirmed directly on a real
       phone recording, AFTER pointer-events/touch-callout were already
       set here -- a native image "lift and preview" / share-sheet
       overlay on a touch that moves slightly while down (a screen
       recording's thumb drift is enough). pointer-events:none and
       touch-callout:none stop the tap-driven cases; they do NOT stop
       that drag-to-preview gesture, which Safari drives off the
       element's native drag/"lift" behaviour, not off DOM pointer
       events or the long-press callout -- a completely different
       mechanism, hence user-drag:none here too. None of these videos
       or stills are meant to be interactive at all -- playback is
       driven entirely by JS, proximity/tap-to-wake is handled by the
       .spec wrapper (see isTouch's click listener below) -- so the
       media element itself has no reason to receive any native
       gesture, tap or drag alike. */
    pointer-events: none;
    -webkit-touch-callout: none;
    -webkit-user-drag: none;
    user-drag: none;
    -webkit-user-select: none;
    user-select: none;
  }

  /* --awake and --flare are both set per-frame in JS (0 to 1 floats).
     Awake is proximity/tap; flare is the unprompted cycle. Combined
     additively into one filter so a specimen that happens to flare
     while already awake gets both effects at once instead of one
     silently overriding the other via CSS specificity. Only specimens
     with a real alpha-cut background (see Specimen.cutout) get this —
     see the comment above. */
  .spec[data-cutout='1'] img,
  .spec[data-cutout='1'] video {
    /* Resting brightness was 0.6 -- lower than the 0.82 every other
       specimen sits at, found while comparing the jellyfish (cutout)
       against the piglet (not) in the same screenshot: the jellyfish's
       own material is already pale and low-contrast, so a dimmer-than-
       everyone-else baseline made it read as washed out rather than
       "resting." Raised to match, with the awake/flare bonuses rescaled
       so the peak (fully awake + flaring) lands in the same place. */
    filter:
      brightness(calc(0.8 + var(--awake, 0) * 0.3 + var(--flare, 0) * 0.45))
      contrast(1.24)
      saturate(calc(0.92 + var(--awake, 0) * 0.15 + var(--flare, 0) * 0.3));
    transition: filter 1.1s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Opt-in, not universal — most specimens are already clean on flat
     black and don't need this; masking them anyway risks clipping a
     tentacle or ear that was never a problem. Compositing note in
     DESIGN-SYSTEM.md assumes true black under void-family specimens
     so the rectangle disappears with no cutting/alpha/mask; the newer
     octopus render has a soft dark vignette instead, which would
     otherwise show as a faint edge against the page.

     This used to be mask-image/-webkit-mask-image on the img/video
     itself. Reported back: piglet (a video) was still showing its
     hard rectangle after that shipped. CSS masking a live <video> is
     a known-flaky combination in WebKit specifically -- video decode
     composites on its own layer that doesn't reliably honor an
     element-level mask the way a plain <img> does, and this sandbox
     can only verify against Chromium, which masks video fine and so
     never would have caught that gap.

     Switched to a technique with no mask-API dependency at all: an
     ordinary painted ::after overlay, sized to match .spec exactly,
     with the SAME radial shape inverted -- transparent in the middle,
     fading to --void at the edges. This doesn't touch the video's
     alpha or compositing in any way; it just paints fake black over
     the rectangle's corners, on top, like the vignette on a photo.
     Plain `background`, not mask or blend-mode (the design system
     rules out blend modes on specimens; a painted layer needs
     neither). */
  .spec[data-vignette='1']::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 60% 60% at 50% 48%, transparent 58%, var(--void) 100%);
  }

  .spec-tag {
    position: absolute;
    left: 0;
    bottom: -1.6em;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
    opacity: 0;
    white-space: nowrap;
    transition: opacity 0.8s var(--ease);
  }

  .spec[data-awake='1'] .spec-tag {
    opacity: 0.85;
  }

  /* Unprompted flare — the one piece of the field that doesn't wait for
     the visitor to do anything. --flare is set per-frame in JS (0 to 1,
     triangular envelope over ~2.6s, randomized per specimen); driven as
     a halo here rather than a CSS animation, since its timing isn't a
     fixed loop. The brightness/saturation half of the effect lives in
     the .spec img/video rule above, combined with --awake.
     drop-shadow follows the element's alpha, not its color — on an
     opaque rectangle (everything without a real cutout) it draws a
     glow around the whole box regardless of how dark the pixels are,
     which is the same box problem as the brightness escalation above.
     Scoped to [data-cutout] for the same reason. */
  .spec[data-cutout='1'] {
    filter: drop-shadow(0 0 calc(var(--flare, 0) * 34px) rgba(247, 197, 106, calc(var(--flare, 0) * 0.55)));
  }

  /* ---- fragments: quotes, not one-liners. Wrapped to 2-3 lines,
     a specimen card rather than wallpaper text, since there are only
     ever a handful on screen at once now. ---- */
  .frag-slot {
    position: absolute;
    top: 0;
    left: 0;
    width: min(24em, 62vw);
    will-change: transform, opacity;
  }

  .frag-quote {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    /* Per direct spec's typography table: quote text is Fraunces SOFT
       50-60, WONK 1 -- reversing an earlier fix this same session that
       set WONK 0 because 1's wonky, hand-lettered forms read badly on
       Landing's single hero line. Applied as specified; flagged to
       Eduardo rather than silently overridden, since it undoes that
       earlier direct correction. */
    font-variation-settings: 'SOFT' 55, 'WONK' 1;
    /* Was --flesh -- a light, bright pink-tan that reads closer to
       skin than to the muted bronze/rust the reference's own quotes
       use (--oxide-lit). Matched to that instead. */
    color: var(--oxide-lit);
    /* Per direct spec's typography table, replacing the old JS-computed
       depth-based inline pixel size (assignFragment used to set
       slot.quote.style.fontSize directly) with one CSS clamp shared by
       every chair. */
    font-size: clamp(1.05rem, 3.4vw, 1.45rem);
    line-height: 1.4;
    /* Was a gold-tinted border-left (rgba(247,197,106,...), the nerve's
       own color) -- direct color spec: "Oro... Nunca el cuerpo de la
       frase." A quote's own accent border is part of its body, not the
       nerve/tag/cue trio gold is reserved for, so it's the flesh/oxide
       tone instead. */
    border-left: 1px solid rgba(227, 175, 149, 0.22);
    padding-left: 0.85em;
    transition: border-color 0.7s var(--ease);
    /* Void halo, same pattern as .stop below -- a quote drifting over a
       lit specimen needs the same protection a stop label already has,
       per direct spec ("Halo void en la quote (como .stop)"). */
    text-shadow:
      0 0 1px var(--void), 0 0 2px var(--void), 0 0 4px var(--void),
      0 0 8px var(--void), 0 0 14px var(--void), 0 0 20px var(--void);
  }

  .frag-quote b {
    display: inline-block;
    font-weight: inherit;
    will-change: transform, opacity, color;
  }

  /* One word, one atomic unit for line-breaking -- see setLine()'s own
     comment for why bare sibling letters can wrap mid-word without it. */
  .frag-quote .word {
    display: inline-block;
    white-space: nowrap;
  }

  .frag-ref {
    margin: 0.5em 0 0 0.85em;
    font-family: var(--font-mono);
    /* 0.4 alpha measures 2.38:1 on black -- confirmed by direct
       contrast calculation, not estimated -- against a 4.5:1 floor for
       text this size. That's what the earlier legibility fix (0.65
       alpha) was correcting before it got reverted to match a spec
       table; the table was wrong on this point. Restored, this time
       with the number that made it necessary on record. */
    font-size: 0.6rem;
    letter-spacing: 0.07em;
    color: rgba(227, 175, 149, 0.65);
    line-height: 1.3;
  }

  .frag-ref a {
    color: inherit;
  }

  .frag-ref a:hover,
  .frag-ref a:focus-visible {
    color: var(--gold);
  }

  .frag-ref a:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* ---- nerve stops ---- */
  .stop {
    position: absolute;
    top: 0;
    left: 0;
    font-family: var(--font-mono);
    /* rem, not a fixed 10px -- this is the site's only navigation
       (CLAUDE.md non-negotiable 2), so it has to honor a reader's own
       text-size setting like anything else that matters would.
       0.625rem is the same visual size as before at the default root
       size, just no longer locked to it. */
    font-size: 0.625rem;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    /* 0.3 alpha measured 2.25:1 on black -- confirmed by direct
       contrast calculation against the 4.5:1 floor this text size
       needs. The site's entire navigation was, measurably, close to
       unreadable except at data-near='1'. 0.5 measures 4.5:1. */
    color: rgba(243, 235, 224, 0.5);
    white-space: nowrap;
    transition: color 0.5s, letter-spacing 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    cursor: pointer;
    /* Now a real <a>, not a div stub -- text-decoration:none keeps it
       looking exactly as it did before, and font/background:inherit
       block Safari/Firefox's UA-stylesheet defaults for links from
       reintroducing a different font or an implicit blue/purple. */
    text-decoration: none;
    font: inherit;
    background: none;
    /* z-index alone decides paint ORDER, not whether something behind
       it is still legible -- plain text with nothing opaque behind it
       still visually tangles with whatever's underneath regardless of
       stacking order. A soft black halo (not a hard-edged box, to stay
       out of the way aesthetically) keeps navigation readable no
       matter what a fragment happens to be drifting through at the
       same spot. */
    /* Strengthened after seeing a stop tangle with both a fragment AND
       a specimen at once (a lit chimp portrait, not just flat black) --
       the original three-layer halo wasn't dense enough to hold up
       against a detailed, bright background. More layers, tighter at
       the core, for real coverage right at the glyph edges rather than
       just a wider blur. */
    text-shadow:
      0 0 1px var(--void), 0 0 2px var(--void), 0 0 4px var(--void),
      0 0 8px var(--void), 0 0 14px var(--void), 0 0 20px var(--void);
  }

  .stop[data-near='1'] {
    color: var(--gold);
    letter-spacing: 0.52em;
  }

  /* Same ring as .cue:focus-visible in sopalda-landing.css -- the one
     other keyboard-focusable interactive element on the page -- so
     the focus style is consistent site-wide, not invented fresh here. */
  .stop:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 4px;
    border-radius: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .spec img,
    .spec video,
    .spec-tag,
    .stop {
      transition: none;
    }
  }
</style>

<script>
  import { FRAGS } from '../data/fragments';
  import { ARTICLE_CATALOG, slugForTitle } from '../data/articleIndex';

  type Band = 'alta' | 'nervio' | 'baja';
  type ScaleTier = 'dominant' | 'mesa' | 'perdido';
  type Specimen = {
    img?: string;
    vid?: string;
    poster?: string;
    // No longer used for render size -- SCALE_VW below sizes purely by
    // role (dominant/mesa/perdido) as a viewport-width fraction, per
    // direct spec ("Escala... se reconocen; no confeti"). Kept on the
    // data itself only as a rough real-asset-size reference.
    w: number;
    d: number;
    tag?: string;
    vignette?: boolean; // true = source has a soft dark edge, not flat black — fade it via mask instead of showing a rectangle
    cutout?: boolean; // true = source has a genuine alpha-cut background — safe to brighten/glow on wake without lighting up a visible rectangle
    boost?: number; // static brightness multiplier on top of the base 0.82 -- compensates for a source that's inherently pale/low-contrast (not a real fix; that's a re-shoot), default 1
    pulse?: boolean; // true = fades slowly in and out on its own, independent of awake/flare -- per Eduardo's note for the second jellyfish
    // Explicit vertical band per direct spec, replacing the old y-fraction-
    // of-viewport placement: alta rides well above the nerve (no fragments
    // allowed there -- it collides with the docked mark), nervio sits close
    // beside the wire, baja well below it with the long fragments.
    band: Band;
    // Dominant candidates (octopus, chimp) alternate which one actually
    // renders large -- only one at a time, see chooseDominant() below.
    // Everything else is fixed: mesa (the readable, mid-size cast) or
    // perdido (small, easy to miss on purpose).
    scale: ScaleTier;
    // Piglet only: "testigo, no nada como el goldfish" -- a witness that
    // watches rather than swims toward the cursor. Cuts the lean-toward-
    // pointer response instead of sharing goldfish's full reach.
    witness?: boolean;
    // Per-specimen size multiplier on top of its role's SCALE_VW range,
    // default 1. Direct feedback: piglet's own mesa-floor size ("don't
    // make it too small") read too small for a specimen the spec calls
    // "obligatorio" -- a per-specimen bump, not a change to mesa's
    // shared range/floor, which stays exactly as specified for every
    // other mesa specimen (jellyfish, goldfish, seaweed, brain,
    // bluefish, jellyfish2).
    sizeMul?: number;
  };

  // Shared by specimen placement (below) and fragment placement
  // (assignFragment, further down) -- both anchor to the live nerve
  // curve rather than a fixed fraction of viewport height, and both
  // need the same three vertical ranges to stay in the same visual
  // register. Magnitudes are a fraction of "channel" (nerveMax -
  // nerveMin). Fragments only ever draw from nervio/baja -- alta stays
  // specimen-only, per direct spec ("alta band has no fragments").
  const BAND_RANGE: Record<Band, [number, number]> = {
    alta: [0.24, 0.4],
    nervio: [0.05, 0.13],
    baja: [0.24, 0.4],
  };

  // Direct spec's scale table -- size reads by role, not by each
  // specimen's own natural pixel width. Replaces the old
  // width-times-multiplier system (w0/scaleDof/tierMul/capFrac)
  // entirely: a role now maps straight to a viewport-width fraction,
  // per breakpoint, full stop. Values are [lo, hi] fractions of W,
  // interpolated by depth (dofT) below for some variety within a role
  // rather than every specimen in a tier reading as the exact same
  // size.
  const SCALE_VW: Record<ScaleTier, { mobile: [number, number]; desktop: [number, number] }> = {
    dominant: { mobile: [0.48, 0.56], desktop: [0.28, 0.34] },
    mesa: { mobile: [0.34, 0.42], desktop: [0.18, 0.24] },
    perdido: { mobile: [0.22, 0.26], desktop: [0.12, 0.16] },
  };
  // Mobile-only floors in real px -- "se reconocen; no confeti." A
  // vw-only mesa/perdido could still shrink to a smudge on a very
  // narrow phone; desktop needs no floor since its vw range never gets
  // that small in practice.
  const SCALE_FLOOR_MOBILE: Record<ScaleTier, number> = { dominant: 0, mesa: 140, perdido: 96 };

  const SPECIMENS: Specimen[] = [
    { img: '/specimens/chimp.png', w: 460, d: 1.0, tag: 'SP.04 · PROXIMITY · CHIMP', vignette: true, cutout: true, band: 'alta', scale: 'dominant' },
    // Every webm below was confirmed genuinely alpha-cut by decoding a
    // real frame via canvas + getImageData in a browser -- but that
    // canvas test only ever ran in this sandbox's Chromium, and WebM/
    // VP9 alpha compositing in a plain <video> tag is a Chromium-family
    // feature. Safari (and Firefox) don't composite that channel at
    // all -- they play the opaque color planes underneath, which is a
    // solid rectangle regardless of how clean the file's own alpha is.
