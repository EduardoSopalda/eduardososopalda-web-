      canvas!.width = W * DPR;
      canvas!.height = H * DPR;
      canvas!.style.width = W + 'px';
      canvas!.style.height = H + 'px';
      ctx!.setTransform(DPR, 0, 0, DPR, 0, 0);
      buildChain();
      // The nerve's entrance pose: flat, pinned near the top of the
      // still-black screen, before anything else has appeared. Set
      // once, on the very first resize() at load -- a later resize
      // (rotating a phone, a window resize) must not replay this.
      if (!entranceInited) {
        nerveMin = nerveMax = H * 0.1;
        entranceInited = true;
      }
      computeNerveChannel();
    }

