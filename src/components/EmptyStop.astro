---
// Shared shell for the six rooms that are empty until Eduardo writes or
// builds them (see CLAUDE.md "What is not done" and docs/BUILD-ORDER.md
// step 7: "build the shells with visible TODOs, invent nothing"). The
// subtitle prop is the same line src/data/stops.ts holds for this stop
// and Field.astro now shows on the nerve itself (close approach or
// focus, see .stop-sub) -- both this page and the field pull from that
// one source, so this really is reused, not new copy.
import '../styles/global.css';

interface Props {
  title: string;
  subtitle: string;
  todo: string;
}
const { title, subtitle, todo } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · EDUARDO sopalda</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <p class="label">{subtitle}</p>
      <h1>{title}</h1>
      <p class="todo">TODO (Eduardo): {todo}</p>
      <p class="back"><a href="/">Back to the field</a></p>
    </main>
  </body>
</html>

<style>
  body {
    overflow: visible;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  main {
    max-width: 30rem;
    text-align: center;
    padding: 0 1.5rem;
    font-family: var(--font-mono);
    color: var(--bone);
  }

  .label {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(227, 175, 149, 0.55);
    margin: 0 0 0.75rem;
  }

  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.8rem;
    margin: 0 0 2rem;
  }

  .todo {
    font-size: 0.75rem;
    line-height: 1.6;
    color: rgba(243, 235, 224, 0.4);
    margin: 0 0 2.5rem;
  }

  /* Bone at rest, not gold -- gold is for the nerve, its beads, and
     whatever is awake (CLAUDE.md non-negotiable 6), not a resting
     link color. Hover/focus is the awake moment instead. */
  .back a {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--bone);
    text-decoration: none;
  }

  .back a:hover,
  .back a:focus-visible {
    color: var(--gold);
  }

  .back a:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 4px;
    border-radius: 2px;
  }
</style>
