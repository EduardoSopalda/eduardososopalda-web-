---
// Plain reverse-chronological archive, per docs/BUILD-ORDER.md step 3 & 7:
// "Writing first, since it has content." No invented copy -- every
// title, date, kind and thread below comes straight from the real
// content collection (src/content/config.ts, reading content/ itself),
// the same source /writing/[slug] renders from -- one source of truth,
// not the earlier hand-parsed content/_index.json snapshot.
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { toArticleRow } from '../data/articleIndex';
import ThreadNerve from '../components/ThreadNerve.astro';
import ArticleList from '../components/ArticleList.astro';

const entries = await getCollection('articles');
const bySource = entries.map(toArticleRow).sort((a, b) => (a.date < b.date ? 1 : -1));

// The room's one awake plate: void, one real object, one line cropped
// from the rest of the sentence -- per direct critique, substitution
// and scale-shift (an image where a cover would sit, the fragment at
// book size, the official headline cut down to a caption) instead of
// a contents page. Picks the first article that actually carries a
// real image (family !== 'void' AND a real image path) -- today that's
// none of the 25 (every one still ships family: void, see
// content.config.ts's own comment), so there's nothing to invent here:
// which article wakes and what its image is is Eduardo's call, the
// same "not done, needs Eduardo" boundary the rest of this site
// already respects. awake stays null until he assigns one; the empty
// state below is a visible TODO, not a silently missing feature.
const awake = bySource.find((a) => a.family !== 'void' && a.image) ?? null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Writing · EDUARDO sopalda</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <p class="back"><a href="/">Back to the field</a></p>
      <h1>Writing</h1>

      {awake ? (
        <a class="awake-plate" href={`/writing/${awake.id}`}>
          <div class="awake-image"><img src={awake.image} alt="" /></div>
          <p class="awake-line">{awake.lead ?? awake.dek}</p>
          <p class="awake-title">{awake.title}</p>
        </a>
      ) : (
        <div class="awake-plate awake-plate--empty">
          <p class="awake-todo">
            TODO (Eduardo): pick one article and assign it a real image (family:
            'specimen' or 'apparatus', plus an image path, in its front matter) to
            feature here as the room's one awake plate -- void, one object, the
            article's own line, its official title cropped to a caption.
          </p>
        </div>
      )}

      <ThreadNerve />
      <ArticleList entries={bySource} />
    </main>
  </body>
</html>

<style>
  /* global.css sets html AND body to overflow:hidden, correct for the
     field (a fixed-viewport canvas that scrolls its own world) but
     wrong here -- this page overrode body's own overflow already, but
     never html's, and html is what actually governs whether the real
     viewport can scroll at all. Confirmed directly, not assumed: body's
     scrollHeight grew to include every row (real content, all present
     in the DOM), but window.scrollY stayed pinned at 0 through 20 real
     wheel/touch scroll attempts on a phone emulation -- the whole
     archive existed on the page and was completely unreachable below
     the first screen. html needs the same override body already has,
     not just body alone. */
  html {
    overflow-y: auto;
    overflow-x: hidden;
  }

  body {
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 100svh;
  }

  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
    font-family: var(--font-mono);
    color: var(--bone);
  }

  /* Bone at rest, not gold -- gold is for the nerve, its beads, and
     whatever is awake (CLAUDE.md non-negotiable 6), not a resting
     link color. Hover/focus is the awake moment instead. */
  .back a {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--bone);
    text-decoration: none;
  }

  .back a:hover,
  .back a:focus-visible {
    color: var(--gold);
  }

  .back a:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 4px;
    border-radius: 2px;
  }

  h1 {
    margin: 3rem 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.6rem;
  }

  /* The awake plate: substitution and scale-shift, per direct
     critique, not a cover photo and a headline like everything else
     in the list below it. void background either way (--void, not a
     near-black -- same true-black the field's own specimens composite
     against, see DESIGN-SYSTEM.md), so an image sits on the same
     ground a specimen does elsewhere on this site, not a website
     hero banner. */
  .awake-plate {
    display: block;
    margin: 2rem 0 0;
    padding: 1.75rem;
    background: var(--void);
    border: 1px solid rgba(243, 235, 224, 0.12);
    text-decoration: none;
    color: inherit;
  }

  .awake-plate:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 2px;
  }

  .awake-image {
    max-width: 22rem;
    max-height: 44vh;
    overflow: hidden;
    margin: 0 0 1.25rem;
  }

  .awake-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The line: full, unshortened, book-size -- the thought this plate
     is actually for. Same colour every other quote on the site uses
     (Field.astro's .frag-quote, /writing's own row .lead below). */
  .awake-line {
    margin: 0;
    max-width: 32rem;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 3.6vw, 1.9rem);
    line-height: 1.3;
    color: var(--oxide-lit);
  }

  /* The official headline, cropped to a caption -- "keep the thought,
     cut the cover." One line, ellipsis past it, not the full title
     wrapping across two or three lines the way every other row's own
     .title is allowed to. */
  .awake-title {
    margin: 0.75rem 0 0;
    max-width: 26rem;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: rgba(243, 235, 224, 0.45);
  }

  .awake-plate--empty {
    border-style: dashed;
  }

  .awake-todo {
    margin: 0;
    max-width: 34rem;
    font-size: 0.75rem;
    line-height: 1.6;
    color: rgba(243, 235, 224, 0.4);
  }
</style>
