---
// Plain reverse-chronological archive, per docs/BUILD-ORDER.md step 3 & 7:
// "Writing first, since it has content." No invented copy -- every
// title, date, kind and thread below comes straight from the real
// content collection (src/content/config.ts, reading content/ itself),
// the same source /writing/[slug] renders from -- one source of truth,
// not the earlier hand-parsed content/_index.json snapshot.
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { catalogNoForTitle } from '../data/articleIndex';

const entries = await getCollection('articles');
const bySource = entries
  .map((e) => ({ ...e.data, id: e.id, no: catalogNoForTitle(e.data.title) }))
  .sort((a, b) => (a.date < b.date ? 1 : -1));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Writing · EDUARDO sopalda</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <p class="back"><a href="/">Back to the field</a></p>
      <ol class="list">
        {bySource.map((a) => (
          <li>
            <a class="row" href={`/writing/${a.id}`}>
              <span class="no">{a.no ? `No.${String(a.no).padStart(2, '0')}` : ''}</span>
              <span class="title">{a.title}</span>
              <span class="meta">
                {a.date.getFullYear()} · {a.kind} · {a.threads.join(', ')}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </main>
  </body>
</html>

<style>
  body {
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 100svh;
  }

  main {
    max-width: 42rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
    font-family: var(--font-mono);
    color: var(--bone);
  }

  /* Bone at rest, not gold -- gold is for the nerve, its beads, and
     whatever is awake (CLAUDE.md non-negotiable 6), not a resting
     link color. Hover/focus is the awake moment instead. */
  .back a {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    color: var(--bone);
    text-decoration: none;
  }

  .back a:hover,
  .back a:focus-visible {
    color: var(--gold);
  }

  .back a:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .list {
    list-style: none;
    margin: 3rem 0 0;
    padding: 0;
  }

  .list li {
    border-top: 1px solid rgba(243, 235, 224, 0.12);
  }

  .list li:last-child {
    border-bottom: 1px solid rgba(243, 235, 224, 0.12);
  }

  .row {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0.25rem 1rem;
    padding: 1.1rem 0;
    text-decoration: none;
    color: inherit;
  }

  .row:focus-visible {
    outline: 1.5px solid var(--gold);
    outline-offset: 2px;
  }

  .no {
    font-size: 0.7rem;
    color: rgba(227, 175, 149, 0.6);
    align-self: start;
  }

  .title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.35;
  }

  .meta {
    grid-column: 2;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: rgba(243, 235, 224, 0.4);
  }

</style>
